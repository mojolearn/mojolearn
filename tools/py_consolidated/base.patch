+def causal_lm_session_close_binding(session: PythonObject) raises -> PythonObject:
+    var owner = session.downcast_value_ptr[CausalLMSession]()
+    if owner[].busy:
+        raise Error("causal lm session: busy")
+    owner[].usable = False
+    owner[].release()
+    return PythonObject(0)
