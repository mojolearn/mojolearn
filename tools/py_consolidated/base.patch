+    var Q = _qp(counts_addr)
+    var out = List[Float64](capacity=k * d)
+    for i in range(k):
+        var cnt = Int(Q[i])
+        if cnt <= 0 or cnt >= (1 << 53):
+            raise Error("x_metrics epilogue: a cluster count goes the Python way")
