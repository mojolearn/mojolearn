+def _lm_layers_run(
+    ctx: DeviceContext, layers: List[Int], mut x: DeviceBuffer[DType.float32], b: Int, l: Int,
+) raises:
+    """Every layer in order on `x` ([b * l * d], overwritten with the stack's
