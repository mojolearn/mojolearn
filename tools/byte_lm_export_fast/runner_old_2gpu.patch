-class Digests:
-    """The chain line's (state_sha256, gradient_sha256) of `arrays` (the four
-    state arrays) and `gradient` (None: no gradient digest), under `scheme`,
-    computing in background threads from the moment of construction.
-    `result()` returns what `_hash_arrays(arrays, scheme)` and
-    `_hash_gradient(gradient, scheme)` return. The caller must not write to
-    the buffers until `result()` has returned."""
-
-    def __init__(self, arrays, gradient, scheme, *, pool=None, gate_seconds=5.0):
-        if scheme not in (SCHEME_V1, SCHEME_V2):
-            raise SystemExit("unknown hash scheme %r" % scheme)
-        self.scheme = scheme
-        self._owners = (arrays, gradient)  # the views below borrow their memory
-        views = [_bytes_of(arrays[k]) for k in ARRAYS]
-        gview = None if gradient is None else _bytes_of(gradient)
-        pool = pool or _digest_pool()
-        started = threading.Semaphore(0)
-
-        def one(data):
-            started.release()
-            return hashlib.sha256(data).hexdigest()
-
-        def chained(parts):
-            started.release()
-            h = hashlib.sha256()
-            for part in parts:
-                h.update(part)
-            return h.hexdigest()
-
-        if scheme == SCHEME_V1:
-            self._state = pool.submit(chained, views)
-            self._grad = None if gview is None else pool.submit(one, gview)
-            count = 1 + (gview is not None)
-        else:
-            self._state = [[pool.submit(one, v[a:b]) for a, b in _slice_bounds(len(v))] for v in views]
-            self._grad = None if gview is None else [pool.submit(one, gview[a:b]) for a, b in _slice_bounds(len(gview))]
-            count = HASH_SLICES * (len(views) + (gview is not None))
-        self.started_all = True
-        deadline = time.monotonic() + gate_seconds
-        for _ in range(count):
-            if not started.acquire(timeout=max(0.0, deadline - time.monotonic())):
-                self.started_all = False
-                break
-
-    def result(self):
-        if self.scheme == SCHEME_V1:
-            state = self._state.result()
-            grad = None if self._grad is None else self._grad.result()
-        else:
-            h = hashlib.sha256()
-            for parts in self._state:
-                h.update(_sha("".join(f.result() for f in parts).encode()).encode())
-            state = h.hexdigest()
-            grad = None if self._grad is None else _sha("".join(f.result() for f in self._grad).encode())
-        self._owners = None
-        return state, grad
