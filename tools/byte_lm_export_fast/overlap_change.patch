+# ---------------------------------------------------------------- the per-step digests, off the step's path
+#
+# `_hash_arrays` and `_hash_gradient` above are THE DEFINITION of a chain
+# line's two digests and stay exactly as they are. What follows computes the
+# same two values from the same bytes with less wall clock, and every piece
+# is held to those two functions by tools/tests/test_lm_segment_hash_overlap.py:
+#
+#   Digests       every slice of every array and of the gradient is hashed in
+#                 its own thread at once (40 single-update sha256 calls under
+#                 v2), where `_hash_arrays` hashed one array's eight slices at
+#                 a time. The slice bounds, the per-slice sha256 and the way
+#                 the hex digests are combined are unchanged, so the digests
+#                 are unchanged.
+#   Snapshot      the post-step state (and the summed gradient) read back from
+#                 the device into host buffers allocated ONCE and reused, by
+#                 the binding call `export_raw` and `export_gradients` make;
+#                 no fresh 2.6 GB of zeroed pages every step.
+#   StepPipeline  the digests, the chain line and a cadence checkpoint of step
+#                 N are finished in a background thread while the trainer
+#                 computes step N+1, from a snapshot step N+1 cannot touch
+#                 (two snapshots, alternating; a snapshot is read into only
+#                 after the job that used it has finished). One writer thread
+#                 writes the lines in step order. A disagreement at step N is
+#                 learned at the latest after step N+1 has been computed; the
+#                 segment then stops, step N+1 is never read back, hashed or
+#                 written, and the chain and segment.json name N as the first
+#                 differing step, exactly as the synchronous loop does.
+#
+# WHY THE HASH THREADS CAN RUN DURING THE STEP. The parallel trainer's native
+# step keeps the interpreter lock for the whole step (the binding uses it as
+# the session's exclusion lock). hashlib releases the lock inside one large
+# update and needs it again only to return, so each slice is ONE update, and
+# `Digests` waits until every slice's thread has started before the trainer is
+# given the next step. A thread that has not reached its update in time makes
+# the digest later, never different.
+#
+# THE READ-BACK STAYS BETWEEN STEPS. `byte_lm_parallel_step` is one native call
+# (forward, backward, the ordered fold and the AdamW update of every replica),
+# and the binding offers no point between the fold and the update, so the
+# state can only be read after the call returns.
+
+DIGEST_THREADS = 5 * HASH_SLICES   # parameters, m, v, flags and the gradient, eight slices each
+_DIGEST_POOL = None
+
+
+def _digest_pool():
+    global _DIGEST_POOL
+    if _DIGEST_POOL is None:
+        from concurrent.futures import ThreadPoolExecutor
+        _DIGEST_POOL = ThreadPoolExecutor(max_workers=DIGEST_THREADS, thread_name_prefix="lm-digest")
+    return _DIGEST_POOL
+
+
+def _slice_bounds(n, slices=HASH_SLICES):
+    """`_sha_sliced`'s byte ranges of an n-byte buffer."""
+    return [(n * i // slices, n * (i + 1) // slices) for i in range(slices)]
+
+
+class Digests:
+    """The chain line's (state_sha256, gradient_sha256) of `arrays` (the four
+    state arrays) and `gradient` (None: no gradient digest), under `scheme`,
+    computing in background threads from the moment of construction.
+    `result()` returns what `_hash_arrays(arrays, scheme)` and
+    `_hash_gradient(gradient, scheme)` return. The caller must not write to
+    the buffers until `result()` has returned."""
+
+    def __init__(self, arrays, gradient, scheme, *, pool=None, gate_seconds=5.0):
+        if scheme not in (SCHEME_V1, SCHEME_V2):
+            raise SystemExit("unknown hash scheme %r" % scheme)
+        self.scheme = scheme
+        self._owners = (arrays, gradient)  # the views below borrow their memory
+        views = [_bytes_of(arrays[k]) for k in ARRAYS]
+        gview = None if gradient is None else _bytes_of(gradient)
+        pool = pool or _digest_pool()
+        started = threading.Semaphore(0)
+
+        def one(data):
+            started.release()
+            return hashlib.sha256(data).hexdigest()
+
+        def chained(parts):
+            started.release()
+            h = hashlib.sha256()
+            for part in parts:
+                h.update(part)
+            return h.hexdigest()
+
+        if scheme == SCHEME_V1:
+            self._state = pool.submit(chained, views)
+            self._grad = None if gview is None else pool.submit(one, gview)
+            count = 1 + (gview is not None)
+        else:
+            self._state = [[pool.submit(one, v[a:b]) for a, b in _slice_bounds(len(v))] for v in views]
+            self._grad = None if gview is None else [pool.submit(one, gview[a:b]) for a, b in _slice_bounds(len(gview))]
+            count = HASH_SLICES * (len(views) + (gview is not None))
+        self.started_all = True
+        deadline = time.monotonic() + gate_seconds
+        for _ in range(count):
+            if not started.acquire(timeout=max(0.0, deadline - time.monotonic())):
+                self.started_all = False
+                break
+
+    def result(self):
+        if self.scheme == SCHEME_V1:
+            state = self._state.result()
+            grad = None if self._grad is None else self._grad.result()
+        else:
+            h = hashlib.sha256()
+            for parts in self._state:
+                h.update(_sha("".join(f.result() for f in parts).encode()).encode())
+            state = h.hexdigest()
+            grad = None if self._grad is None else _sha("".join(f.result() for f in self._grad).encode())
+        self._owners = None
+        return state, grad
+
+
+class Snapshot:
+    """One private host copy of a replica's post-step state and summed
+    gradient. `read` makes the binding call `export_raw` and
+    `export_gradients` make (`byte_lm_parallel_export`, replica 0) into
+    buffers allocated on the first read and reused after, and refuses a step
+    mismatch as they do. A trainer without that binding surface (a stand-in)
+    is read through `export_raw` / `export_gradients`, whose fresh arrays are
+    private by construction."""
+
+    def __init__(self):
+        self.arrays = None
+        self.gradient = None
+
+    def read(self, trainer, *, gradient=True):
+        binding = getattr(trainer, "_binding", None)
+        if (not callable(getattr(binding, "byte_lm_parallel_export", None)) or not hasattr(trainer, "_session")
+                or not hasattr(trainer, "_shape") or not hasattr(trainer, "_lock")):
+            self.arrays = trainer.export_raw()
+            self.gradient = trainer.export_gradients() if gradient else None
+            return self
+        from mojolearn._buffer import addr, empty
+        with trainer._lock:
+            trainer._open()
+            binding, shape = trainer._binding, trainer._shape
+            if self.arrays is None:
+                self.arrays = {key: empty((shape.n_total,), "<f4") for key in ("parameters", "m", "v")}
+                self.arrays["flags"] = empty((shape.n_tensors,), "<i4")
+            step = binding.byte_lm_parallel_export(trainer._session,
+                                                   [addr(self.arrays[k], name=k) for k in ARRAYS], 0, False)
+            if step != trainer.step_:
+                raise RuntimeError("parallel export returned wrong step")
+            if gradient:
+                if self.gradient is None:
+                    self.gradient = empty((shape.n_total,), "<f4")
+                step = binding.byte_lm_parallel_export(trainer._session, [addr(self.gradient, name="gradients")],
+                                                       0, True)
+                if step != trainer.step_:
+                    raise RuntimeError("parallel gradient export returned wrong step")
+        return self
+
+
+def save_snapshot_checkpoint(meta, arrays, step, directory, *, manifest, upload):
+    """`save_checkpoint` from a snapshot: the same state dict (the trainer's
+    metadata as it stood after step `step`, the four arrays read back after
+    that step) through the same `_byte_lm_checkpoint.save`, so the same file
+    bytes and the same sha256 in the manifest."""
+    from mojolearn import _byte_lm_checkpoint as ck
+    state = dict(meta)
+    state.update(arrays)
+    state["completed_steps"] = step
+    state["next_batch_index"] = step
+    name = checkpoint_name(step)
+    path = Path(directory) / name
+    t0 = time.perf_counter()
+    digest = ck.save(path, state)
+    seconds = time.perf_counter() - t0
+    size = path.stat().st_size
+    manifest.pin(name, size, digest)
+    upload(name, path)
+    return dict(step=step, file=name, bytes=size, sha256=digest, save_seconds=round(seconds, 3))
+
+
+class StepPipeline:
+    """Finishes each step's chain line (digests, compare, write) and its
+    cadence checkpoint in one background writer thread, in step order, while
+    the main thread runs the next step. Checkpoint uploads run in a second
+    thread, in order, so a 1.95 GB PUT holds no snapshot. At most one step's
+    job is ever pending: `after_step` waits for it (and re-raises anything it
+    raised) before the next job may be submitted."""
+
+    def __init__(self, chain, scheme, say, out, *, save=None):
+        from concurrent.futures import ThreadPoolExecutor
+        self.chain, self.scheme, self.say = chain, scheme, say
+        self.save = save if save is not None else save_snapshot_checkpoint
+        self.writer = ThreadPoolExecutor(max_workers=1, thread_name_prefix="lm-chain")
+        self.uploader = ThreadPoolExecutor(max_workers=1, thread_name_prefix="lm-upload")
+        self.pending = None
+        self.uploads = []
+        self.stopped_at = None
+        self.checkpoints = []
+        self.timings = []  # one row a step, to segment.json (`digest_timings`)
+        self.waited = 0.0
+        self.last_submit = None
+        self.progress_due = False
+        self.progress_dir = None
+
+    def _raise_upload_errors(self, wait=False):
+        for f in self.uploads:
+            if wait or f.done():
+                f.result()
+
+    def after_step(self):
+        """Wait for the previous step's job. False when that step disagreed
+        (the segment stops; the step just computed is never recorded)."""
+        t0 = time.perf_counter()
+        if self.pending is not None:
+            pending, self.pending = self.pending, None
+            pending.result()
+        self.waited = time.perf_counter() - t0
+        self._raise_upload_errors()
+        return self.stopped_at is None
+
+    def submit(self, row, arrays, gradient, *, t_readback, readback_seconds, window_shards=None,
+               checkpoint_meta=None, upload=None, manifest=None, out=None):
+        """Start the digests of `arrays` and `gradient` (a snapshot nothing
+        writes until this job is done) and queue the line of `row`."""
+        if self.pending is not None:
+            raise RuntimeError("StepPipeline: a job is still pending; call after_step first")
+        t_digest = time.perf_counter()
+        digests = Digests(arrays, gradient, self.scheme)
+        gate = time.perf_counter() - t_digest
+        # THE LINE'S hash_seconds when overlapped: what this step's line cost
+        # the loop outside the step, from the end of its compute to the start
+        # of the next (the read-back, the wait for the previous line, starting
+        # the digests). The digests themselves finish during the next step and
+        # the writer thread sees them only when that step hands back the
+        # interpreter lock, so their own wall clock is not a cost and is kept
+        # apart in `digest_timings`.
+        blocked = time.perf_counter() - t_readback
+        # the main loop's wall clock from the previous step's submit to this one's
+        wall = None if self.last_submit is None else t_digest - self.last_submit
+        self.last_submit = t_digest
+        self.pending = self.writer.submit(self._job, row, digests, arrays, blocked, t_digest, readback_seconds,
+                                          self.waited, gate, wall, window_shards, checkpoint_meta, upload, manifest,
+                                          out)
+
+    def _job(self, row, digests, arrays, blocked, t_digest, readback_seconds, waited, gate, wall, window_shards,
+             checkpoint_meta, upload, manifest, out):
+        state_digest, grad_digest = digests.result()
+        done = time.perf_counter()
+        row = dict(row, state_sha256=state_digest, gradient_sha256=grad_digest, hash_seconds=round(blocked, 3))
+        if window_shards is not None:
+            row["window"] = _window_witness(None, arrays, window_shards, self.say)
+        timing = dict(step=row["step"], seconds=row["seconds"], readback_seconds=round(readback_seconds, 3),
+                      digests_ready_after_seconds=round(done - t_digest, 3), hash_seconds=row["hash_seconds"],
