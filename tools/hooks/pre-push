#!/bin/sh
# Refuse a push that GitHub would refuse, before hours of upload are spent.
#
# The pre-commit hook stops an oversized file at commit time in worktrees
# that installed it. This hook is the second fence: it scans every blob the
# push would send and refuses if any exceeds 100 MiB, GitHub's hard limit.
# On 2026-09-08 a push ran for hours and was then rejected for one 119 MB
# file (see tools/hooks/pre-commit for the record). Reading the blob sizes
# takes seconds; the upload took hours.
#
# The third fence (2026-10-02): no_host_routes.py --tree scans every file a
# GPU install runs at the pushed commit (Mojo modules the GPU bindings reach
# through their imports, GPU-path Python) and refuses any CPU work in GPU code
# that is not in tools/hooks/host_routes_baseline.tsv, and any baseline row
# that no longer matches (the baseline only shrinks). It prints the debt per
# class and per owner. A branch that predates the baseline is judged on what
# it adds over its merge-base with main, against main's baseline.
#
# The fourth fence (2026-10-21): no_python_in_kernels.py --tree refuses a kernel
# .mojo file (anything outside bindings/, *pyapi*.mojo, *_py.mojo, bench/,
# experiments/ and checks/) that imports or calls Python, beyond
# tools/hooks/python_in_kernels_baseline.txt. It judges refs exactly like the
# host-route fence: main on the whole tree, any other branch with --branch.
#
# The tombstone fence (2026-10-28): tools/tests/test_tombstones_preserved.py --tree, when the
# pushed tree has it, refuses a push whose docs/TOMBSTONES.md index row, section, patch under
# experiments/removed/ or inline TOMBSTONE marker is missing, or that removes or rewrites any of
# them against the merge-base with main (the record is permanent, Andrew 2026-10-28). Both modes
# judge against the merge-base; removing the test file itself is refused too.
#
# The fifth fence (2026-10-21): no_compute_in_shells.py --tree refuses, in a shell
# .mojo file (bindings/, *pyapi*.mojo, *_py.mojo), an untagged for/while loop or a
# kernel launch (enqueue_function, DeviceContext(, parallelize, vectorize) beyond
# tools/hooks/compute_in_shells_baseline.txt. Same main/--branch judging rule.
#
# Which refs the host-route fence judges (2026-10-09):
#   refs/heads/main                       the whole tree
#   refs/heads/<anything else>            --branch: only what it adds over its
#                                         merge-base with main (lane/*, fix/*, ...)
#   refs/heads/archive/*, refs/tags/archive-*, refs/tags/archive/*
#                                         SKIPPED, with one line saying so: archive
#                                         refs are never merged, so the
#                                         fence has nothing to protect there, and
#                                         keeping them in git beats hiding old
#                                         branches in bundles. Archive a dead branch
#                                         as archive/<date>/<old name>; never merge
#                                         an archive ref (revive it as a new lane/*
#                                         branch, which the fence judges as usual).
#   refs/heads/salvage/*                  skipped silently (2026-10-05, unchanged)
#   any other ref (tags, refs/archive/...) not judged (unchanged)
# The size fence below applies to every push, archive refs included.
#
# Arguments and stdin follow git's pre-push contract:
#   $1 remote name, $2 remote URL; stdin lines "<local ref> <local sha> <remote ref> <remote sha>".

limit=$((100 * 1024 * 1024))
zero=0000000000000000000000000000000000000000
bad=0
refs=$(cat)
here=$(dirname "$0")
# installed copies never update themselves (an Oct 8 copy refused tagged driver loops on 2026-10-17): say so when the
# checkout's hooks differ from the installed ones
top=$(git rev-parse --show-toplevel 2>/dev/null)
for f in pre-push no_host_routes.py rebuild_fence.py no_python_in_kernels.py no_compute_in_shells.py; do
    if [ -f "$top/tools/hooks/$f" ] && ! cmp -s "$top/tools/hooks/$f" "$here/$f"; then
        echo "pre-push: the installed $f differs from tools/hooks/$f in this checkout; run bash tools/hooks/install.sh" >&2
    fi
done
echo "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue
    [ -f "$here/no_host_routes.py" ] || continue
    # archive/* and salvage/* refs are archives of dead branches and old worktrees (owner, 2026-10-05 and
    # 2026-10-09): never merged, so no host-route check; the size fence below still applies.
    case "$remote_ref" in
        refs/heads/salvage/*) continue ;;
        refs/heads/archive/*|refs/tags/archive-*|refs/tags/archive/*)
            echo "pre-push: host-route fence skipped for $remote_ref: it is an archive ref, and archive refs are never merged (the size fence still applies)" >&2
            continue ;;
        refs/heads/*) ;;
        *) continue ;;
    esac
    # a push to main is judged on the whole tree; any other branch only on what
    # it adds over its merge-base with main (owner, 2026-10-07)
    mode=--branch
    [ "$remote_ref" = "refs/heads/main" ] && mode=
    python3 "$here/no_host_routes.py" --tree "$local_sha" $mode || exit 4
    # the rebuild fence (2026-10-17): a lane change to a module most bindings import is refused
    if [ -f "$here/rebuild_fence.py" ]; then python3 "$here/rebuild_fence.py" "$local_sha" $mode || exit 4; fi
    # the tombstone fence (2026-10-28): the record only grows (tools/tests/test_tombstones_preserved.py,
    # the pushed commit's copy, judged against the merge-base with main)
    tomb_test=tools/tests/test_tombstones_preserved.py
    tomb_base=$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null)
    if git cat-file -e "$local_sha:$tomb_test" 2>/dev/null; then
        tomb=$(mktemp "${TMPDIR:-/tmp}/tombstones.XXXXXX") || exit 4
        git show "$local_sha:$tomb_test" >"$tomb" || { rm -f "$tomb"; exit 4; }
        python3 "$tomb" --tree "$local_sha" ${tomb_base:+--base "$tomb_base"} >"$tomb.log" 2>&1
        status=$?
        grep -E '^(FAIL|ERROR):|Error|^[-+] ' "$tomb.log" | cut -c1-240 | head -n 30 >&2
        rm -f "$tomb" "$tomb.log"
        [ $status -eq 0 ] || { echo "pre-push: REFUSED by the tombstone fence ($tomb_test): tombstones are a permanent record" >&2; exit 4; }
    elif [ -n "$tomb_base" ] && git cat-file -e "$tomb_base:$tomb_test" 2>/dev/null; then
        echo "pre-push: REFUSED: $local_ref deletes $tomb_test (the tombstone fence)" >&2; exit 4
    fi
    # the no-Python-in-kernels check (2026-10-21), same branch/main judging rule
    if [ -f "$here/no_python_in_kernels.py" ]; then python3 "$here/no_python_in_kernels.py" --tree "$local_sha" $mode || exit 4; fi
    # the no-compute-in-shells check (2026-10-21), same branch/main judging rule
    if [ -f "$here/no_compute_in_shells.py" ]; then python3 "$here/no_compute_in_shells.py" --tree "$local_sha" $mode || exit 4; fi
done
[ $? -eq 4 ] && bad=1
echo "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue        # deleting a remote ref
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes=$1"
    else
        range="$local_sha ^$remote_sha"
    fi
    # shellcheck disable=SC2086
    git rev-list --objects $range 2>/dev/null | cut -d' ' -f1 \
        | git cat-file --batch-check='%(objectname) %(objecttype) %(objectsize)' \
        | awk -v lim="$limit" '$2 == "blob" && $3 > lim { print $1, $3 }' \
        | while read -r blob size; do
            path=$(git rev-list --objects $range | grep "^$blob " | cut -d' ' -f2-)
            echo "pre-push: REFUSED blob $blob ($size bytes) at $path is over GitHub's 100 MiB limit" >&2
            echo "   the commit that added it must be rewritten before this ref can be pushed" >&2
            exit 3
        done
    [ $? -eq 3 ] && exit 3
done
[ $? -eq 3 ] && bad=1
exit $bad
