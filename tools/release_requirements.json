{
  "schema": "mojolearn.release-requirements-catalog.v1",
  "requirements": [
    {
      "id": "runtime-source",
      "scope": "All public and returned API operations; source classification is necessary, not transitive proof",
      "coverage": [
        "zero prohibited source paths"
      ],
      "source_inputs": {
        "checker": [
          "tools/public_runtime_inventory.py",
          "tools/hooks/no_python_in_kernels.py",
          "tools/hooks/no_compute_in_shells.py"
        ]
      },
      "configuration": [
        "release_modes"
      ],
      "kind": "source",
      "stage": "pre",
      "drop_source_inputs": [
        "numerical_source"
      ]
    },
    {
      "id": "coverage-source",
      "scope": "Changed registrations reconciled; no missing required lanes or fault arms",
      "coverage": [
        "coverage mapping and exclusions reviewed"
      ],
      "source_inputs": {
        "checker": [
          "tools/verify_coverage_audit.py",
          "tools/identity_lanes/*"
        ]
      },
      "configuration": [
        "release_modes"
      ],
      "kind": "source",
      "stage": "pre"
    },
    {
      "id": "compile-apple",
      "scope": "Integrated identical build for apple",
      "coverage": [
        "all selected native bindings and required enabled/disabled switches"
      ],
      "source_inputs": {
        "build_tools": [
          "tools/build*.sh",
          "tools/build*.py",
          "packaging/*",
          "packaging/**/*",
          "bindings/build*.sh",
          "bindings/*build*.sh",
          "adapters/*.cpp",
          "adapters/**/*.cpp",
          "adapters/*.h",
          "adapters/**/*.h"
        ]
      },
      "configuration": [
        "release_modes",
        "build_flags"
      ],
      "kind": "compile",
      "stage": "pre",
      "drop_source_inputs": [
        "public_runtime"
      ]
    },
    {
      "id": "runtime-apple",
      "scope": "Public operations and transitive callback refusals on apple",
      "coverage": [
        "constructors",
        "input preparation",
        "workers and callbacks",
        "consumed outputs",
        "supported built-in estimator combinations"
