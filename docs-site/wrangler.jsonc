{
  "$schema": "https://unpkg.com/wrangler@4.140.0/config-schema.json",
  "name": "mojolearn-docs",
  "account_id": "e5ba0319f9962a1aceb6a9f03245d1f5",
  "compatibility_date": "2026-09-25",
  // Static docs only: tools/build.sh writes the current release to _site/ (git-ignored); mojolearn's
  // tools/publish_sites.sh builds it in its own worktree of origin/main and deploys from there.
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "docs.mojolearn.org", "custom_domain": true }
  ]
}
