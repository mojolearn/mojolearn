{
  "$schema": "https://unpkg.com/wrangler@4.140.0/config-schema.json",
  "name": "mojolearn-docs",
  "account_id": "e5ba0319f9962a1aceb6a9f03245d1f5",
  "compatibility_date": "2026-09-25",
  // Static docs only. tools/publish.sh assembles ~/mojolearn-evidence/docs-site-published (one folder per
  // release, stable/, _redirects) and stages it here as _site/ (git-ignored) for this deploy.
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "docs.mojolearn.org", "custom_domain": true }
  ]
}
