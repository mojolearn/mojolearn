+def _sab_ulp_trees(mut model: TAdditiveModel, first: Int):
+    """SABOTAGE (coverage-gbdt-device_pointwise_leaf_ulp): every stored leaf of the symmetric
+    trees from `first` on one ulp up (its bit pattern plus one)."""
+    for t in range(first, len(model.weak_models)):  # driver-loop: over the trees just appended
+        for i in range(len(model.weak_models[t].leaf_values)):  # driver-loop: over one tree's leaf values
+            var v = model.weak_models[t].leaf_values[i]
+            model.weak_models[t].leaf_values[i] = bitcast[DType.float32](
+                bitcast[DType.uint32](v) + UInt32(1)
+            )
