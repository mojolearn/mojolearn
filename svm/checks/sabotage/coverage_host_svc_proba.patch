+def _cov_f32b(u: UInt32) -> UInt32:
+    """SABOTAGE coverage: float32 bits one ulp off (a zero or subnormal
+    becomes the smallest normal)."""
+    return UInt32(0x00800000) if (u & UInt32(0x7FFFFFFF)) < UInt32(0x00800000) else u + UInt32(1)
+
+
+def _cov_f64b(u: UInt64) -> UInt64:
+    """SABOTAGE coverage: float64 bits one ulp off (a zero or subnormal
+    becomes the smallest normal)."""
+    return UInt64(0x0010000000000000) if (u & UInt64(0x7FFFFFFFFFFFFFFF)) < UInt64(0x0010000000000000) else u + UInt64(1)
+
