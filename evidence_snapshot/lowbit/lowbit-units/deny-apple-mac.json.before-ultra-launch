{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllocatingDedicatedHosts",
      "Effect": "Deny",
      "Action": [
        "ec2:AllocateHosts",
        "ec2:ModifyHosts",
        "ec2:PurchaseHostReservation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyLaunchingMacInstances",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:StartInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringLike": {
          "ec2:InstanceType": ["mac*", "mac2*"]
        }
      }
    }
  ]
}
