+def cov_sab_flip_kernel(p: F32Ptr, count: Int32):
+    """SABOTAGE coverage_select_dev: p[t] one ulp off (zero / subnormal -> the smallest normal)."""
+    var t = Int(block_idx.x) * Int(block_dim.x) + Int(thread_idx.x)
+    if t < Int(count):
+        var b = bitcast[DType.uint32](p.unsafe_load(t))
+        if (b & UInt32(0x7FFFFFFF)) < UInt32(0x00800000):
+            b = UInt32(0x00800000)
+        elif (b & UInt32(0x7F800000)) != UInt32(0x7F800000):
+            b += UInt32(1)
+        p.unsafe_store(t, bitcast[DType.float32](b))
+
+
+def cov_sab_swap_kernel(p: F32Ptr, i: Int32, j: Int32):
+    """SABOTAGE coverage_select_dev: p[i] and p[j] swapped (one thread)."""
+    if Int(block_idx.x) * Int(block_dim.x) + Int(thread_idx.x) == 0:
+        var a = p.unsafe_load(Int(i))
+        p.unsafe_store(Int(i), p.unsafe_load(Int(j)))
+        p.unsafe_store(Int(j), a)
+
+
+def cov_sab_word_kernel(p: F32Ptr):
+    """SABOTAGE coverage_select_dev: the low word of a two-word binary64 stepped by one (one ulp)."""
+    if Int(block_idx.x) * Int(block_dim.x) + Int(thread_idx.x) == 0:
+        p.unsafe_store(0, bitcast[DType.float32](bitcast[DType.uint32](p.unsafe_load(0)) + UInt32(1)))
+
