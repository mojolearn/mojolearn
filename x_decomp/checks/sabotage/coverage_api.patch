+def _cov_flip(v: Float32) -> Float32:
+    """SABOTAGE coverage_api: v one ulp off (a zero or subnormal becomes the smallest normal;
+    inf and NaN kept, so no loop sees a new NaN)."""
+    var b = bitcast[DType.uint32](v)
+    if (b & UInt32(0x7F800000)) == UInt32(0x7F800000):
+        return v
+    if (b & UInt32(0x7FFFFFFF)) < UInt32(0x00800000):
+        return bitcast[DType.float32](UInt32(0x00800000))
+    return bitcast[DType.float32](b + UInt32(1))
 
 
