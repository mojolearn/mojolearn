+def cov_sab_flip(p: F32Ptr, count: Int, nz_only: Bool):
+    """SABOTAGE coverage_graph_host: p[t] one ulp off for t < count (zero /
+    subnormal -> the smallest normal; inf and NaN kept). nz_only: an exact
+    zero (no edge) stays zero, so the graph keeps its edges."""
+    for t in range(count):
+        var v = p.unsafe_load(t)
+        if nz_only and v == Float32(0):
+            continue
+        var b = bitcast[DType.uint32](v)
+        if (b & UInt32(0x7FFFFFFF)) < UInt32(0x00800000):
+            b = UInt32(0x00800000)
+        elif (b & UInt32(0x7F800000)) != UInt32(0x7F800000):
+            b += UInt32(1)
+        p.unsafe_store(t, bitcast[DType.float32](b))
+
