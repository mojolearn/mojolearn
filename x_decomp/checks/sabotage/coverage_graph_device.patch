+def xg_cov_sab_flip_kernel(w: F32Ptr, count: Int32, nz_only: Int32):
+    """SABOTAGE coverage_graph_device: w[t] one ulp off for t < count (zero /
+    subnormal -> the smallest normal; inf and NaN kept). nz_only: an exact
+    zero (no edge) stays zero, so the graph keeps its edges."""
+    var t = _t()
+    if t < Int(count):
+        var v = w.unsafe_load(t)
+        if nz_only != 0 and v == Float32(0):
+            return
+        var b = bitcast[DType.uint32](v)
+        if (b & UInt32(0x7FFFFFFF)) < UInt32(0x00800000):
+            b = UInt32(0x00800000)
+        elif (b & UInt32(0x7F800000)) != UInt32(0x7F800000):
+            b += UInt32(1)
+        w.unsafe_store(t, bitcast[DType.float32](b))
+
+
+def xg_cov_sab_swap_kernel(p: F32Ptr):
+    """SABOTAGE coverage_graph_device: p[0] and p[1] swapped (one thread)."""
+    if _t() == 0:
+        var a = p.unsafe_load(0)
+        p.unsafe_store(0, p.unsafe_load(1))
+        p.unsafe_store(1, a)
+
+
+def _cov_sab(ctx: DeviceContext, p: F32Ptr, count: Int, nz_only: Bool) raises:
+    if count > 0:
+        ctx.enqueue_function[xg_cov_sab_flip_kernel](
+            p, Int32(count), Int32(1 if nz_only else 0), grid_dim=_blocks(count), block_dim=TPB
+        )
+
