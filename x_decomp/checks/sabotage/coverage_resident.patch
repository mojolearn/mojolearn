+@always_inline
+def cov_sab_flip(v: Float32) -> Float32:
+    """SABOTAGE coverage_resident: v one ulp off (zero / subnormal -> the
+    smallest normal; inf and NaN kept, so no loop sees a new NaN)."""
+    var b = bitcast[DType.uint32](v)
+    if (b & UInt32(0x7FFFFFFF)) < UInt32(0x00800000):
+        return bitcast[DType.float32](UInt32(0x00800000))
+    if (b & UInt32(0x7F800000)) == UInt32(0x7F800000):
+        return v
+    return bitcast[DType.float32](b + UInt32(1))
+
+
+def cov_sab_res_flip_kernel(p: F32Ptr, count: Int32):
+    """SABOTAGE coverage_resident: p[t] = cov_sab_flip(p[t]) for t < count."""
+    var t = Int(block_idx.x) * Int(block_dim.x) + Int(thread_idx.x)
+    if t < Int(count):
+        p.unsafe_store(t, cov_sab_flip(p.unsafe_load(t)))
+
+
