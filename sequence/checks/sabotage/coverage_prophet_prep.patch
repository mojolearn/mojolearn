+def _cov_f64(v: Float64) -> Float64:
+    """SABOTAGE coverage: v one ulp off (a zero or subnormal becomes the
+    smallest normal; a NaN stays itself)."""
+    if v != v:
+        return v
+    var b = bitcast[DType.uint64](v)
+    if (b & UInt64(0x7FFFFFFFFFFFFFFF)) < UInt64(0x0010000000000000):
+        return bitcast[DType.float64](UInt64(0x0010000000000000))
+    return bitcast[DType.float64](b + UInt64(1))
+
+
+def _cov_f32(v: Float32) -> Float32:
+    """SABOTAGE coverage: v one ulp off (a zero or subnormal becomes the
+    smallest normal)."""
+    var b = bitcast[DType.uint32](v)
+    return bitcast[DType.float32](UInt32(0x00800000)) if (b & UInt32(0x7FFFFFFF)) < UInt32(0x00800000) else bitcast[DType.float32](b + UInt32(1))
+
+
 def _round_half_even(x: Float64) -> Int:
