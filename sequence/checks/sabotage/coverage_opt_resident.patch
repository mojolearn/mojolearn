+def _cov_flip(p: FP, n: Int):
+    """SABOTAGE coverage: the n float32 values at p, each one ulp off (a zero
+    or subnormal becomes the smallest normal)."""
+    for i in range(n):
+        var b = bitcast[DType.uint32](p[i])
+        p[i] = bitcast[DType.float32](UInt32(0x00800000)) if (b & UInt32(0x7FFFFFFF)) < UInt32(0x00800000) else bitcast[DType.float32](b + UInt32(1))
+
