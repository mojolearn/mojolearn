        mamba2_scale_to_dacs_kernel(gid_, _l25_a0, _l25_a1, _l25_a2, _l25_a3, _l25_a4, _l25_a5, _l25_a6)
    host_launch(_launch_25, launch_count((_grid(rows), 1, 1), (M2_SSD_BWD_TPB, 1, 1)))
    var _l26_a0 = reduction.d_dacs_decay.unsafe_ptr()
    var _l26_a1 = state.d_decay_cstate.unsafe_ptr()
    var _l26_a2 = decay.unsafe_ptr()
    var _l26_a3 = Int32(rows)
    var _l26_a4 = Int32(qv)
    def _launch_26(gid_: Int) {imm _l26_a0, imm _l26_a1, imm _l26_a2, imm _l26_a3, imm _l26_a4}:
        mamba2_decay_to_dacs_kernel(gid_, _l26_a0, _l26_a1, _l26_a2, _l26_a3, _l26_a4)
    host_launch(_launch_26, launch_count((_grid(rows), 1, 1), (M2_SSD_BWD_TPB, 1, 1)))
    var dacs_cells = rows * qv
    var _l27_a0 = reduction.d_dacs_total.unsafe_ptr()
