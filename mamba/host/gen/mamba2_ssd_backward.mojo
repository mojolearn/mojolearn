    var _l27_a2 = reduction.d_dacs_state.unsafe_ptr()
    var _l27_a3 = reduction.d_dacs_decay.unsafe_ptr()
    var _l27_a4 = Int32(dacs_cells)
    def _launch_27(gid_: Int) {imm _l27_a0, imm _l27_a1, imm _l27_a2, imm _l27_a3, imm _l27_a4}:
        mamba2_merge_dacs_kernel(gid_, _l27_a0, _l27_a1, _l27_a2, _l27_a3, _l27_a4)
    host_launch(_launch_27, launch_count((_grid(dacs_cells), 1, 1), (M2_SSD_BWD_TPB, 1, 1)))
