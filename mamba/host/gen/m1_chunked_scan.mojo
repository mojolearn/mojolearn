# GENERATED by tools/mamba_host_gen.py from mamba/impl/ops/m1_chunked_scan.mojo; do not edit.
# 4 kernels, 5 launches restated as host loops over the launch grid, split over host tasks.
# Copyright 2026 Andrew Hendel. Part of mojolearn, https://doi.org/10.5281/zenodo.22068632
"""Mamba-1 chunked parallel selective scan (lane mamba-folds, 2026-10-28).

`-D MOJOLEARN_IDN_MAMBA1_CHUNKED_SCAN=1`, IDENTICAL only, default OFF. A BITS
CHANGE across versions (roadmap B5, idea 11 of the 2026-10-28 neural report):
the recurrence `h = da * h + dbu` (seam S9) re-associates inside a chunk. The
same fold runs on every column -- NVIDIA, AMD, Apple and the host (CPU)
column, which `tools/mamba_host_gen.py` restates from THIS file -- so the
cross-vendor identity contract holds within the version.

WHY. Every shipped IDENTICAL arm is serial over L per chain (the old kernel:
one thread per (b, d); the persistent arm: one thread per (b, d, n)). At B=1
the whole GPU then holds `d_inner * 16` chains, each L steps deep, and the
scan is a latency chain. Here the sequence is cut into fixed chunks and the
three launches below run every chunk at once; the only serial walk left is
the chunk carry, `L / W` steps deep.

THE FOLD (profile `mojolearn.identical.mamba1.fp32.v2-chunk64` when the
define is on; S5-S8, S10, S11 unchanged). Chunk `k` of a call covers its
tokens `[k W, min((k + 1) W, L))`; the lattice is anchored at the first token
of the CALL (every batch row has the same L, so every row has the same
lattice). For chain `(b, d, n)`, with `da_t`, `dbu_t` the S5-S8 values:

    first token of a chunk:  P = da_t                    Lc = dbu_t
    every later token:       P = ftz(da_t * P)           Lc = ftz(fma(da_t, Lc, dbu_t))
    state at token t:        h_t = ftz(fma(P, H_k, Lc))           (S9 v2)
    chunk carry:             H_0 = ftz(h_in)
                             H_{k+1} = ftz(fma(P_end(k), H_k, Lc_end(k)))

`P` and `Lc` are the chunk's affine map `h -> P h + Lc` folded serially,
ascending, from the chunk's first token. `H_{k+1}` is the same expression on
the same operands as the state at chunk k's last token, so the carried state
and the stored state agree bit for bit. At a chunk's first token the state is
`fma(da_t, H_k, dbu_t)`, which is S9 v1 exactly: a decode step (L = 1) is ONE
chunk of one token and keeps the v1 bits. A prefill longer than one token
re-associates; contract section 5's gate D (decode == prefill) therefore
holds per call, not across a chunk boundary of a multi-token prefill (stated
in IDENTICAL_MAMBA_CONTRACT.md section 10).

WHY W = 64, AND WHY IT IS NOT A TUNING KNOB. W is part of the numerical
definition, so it is one constant on every column (a per-vendor W would be a
vendor-specific fold). The value comes from the cost balance of the two
serial depths: a chunk is W steps of the in-chunk fold and the carry is L / W
steps, and the summary + output passes cost about 2 W token-steps per chunk.
W = 64 keeps the in-chunk walk short enough that one thread per (b, chunk,
d) fills a 100+ compute-unit GPU for any L of a few hundred tokens and up
(B * d_inner * L / 64 threads), while the carry walk stays below 256 steps
up to L = 16k. It reads no benchmark shape: no L, d_model or dataset enters
any rule here, and the grid covers any (B, L, d_inner).

WHY NOTHING DEPENDS ON THE LAUNCH. Every float of every chain is produced by
exactly one thread in a fixed token order; no float crosses a thread
boundary (no shared memory, no atomics, no cross-thread reduction). The block
size decides only which thread holds a cell. The three kernels are plain
cell kernels, which is what lets the host generator restate them as loops.
"""
from mamba.host.device_shim import host_launch, launch_count
from std.sys.compile import is_defined

from mamba.host.device_shim import DeviceBuffer, DeviceContext

from checks.numerics import (
    ftz,
    identical_exp,
    identical_mul,
    identical_mul_add,
    GLOBAL_NUMERIC_MODE,
    NUMERIC_IDENTICAL,
)


#: The switch. IDENTICAL mode only (FAST has its own chunked arm,
#: MOJOLEARN_AFN_MAMBA1_CHUNKSCAN). It applies to the host column too: the host
#: must compute the same graph as the device, so COLUMN_CPU is NOT excluded.
comptime IDN_MAMBA1_CHUNKED_SCAN = (
    GLOBAL_NUMERIC_MODE == NUMERIC_IDENTICAL
    and is_defined["MOJOLEARN_IDN_MAMBA1_CHUNKED_SCAN"]()
    and not is_defined["MOJOLEARN_IDN_ALL_OFF"]()
)

#: Tokens per chunk. A PROFILE constant (module docstring): the same on every
#: column, never chosen per vendor, per shape or per dataset.
comptime M1_CHUNK_W = 64

#: Threads per block for the three cell kernels. Execution plan only: no float
#: crosses a thread, so this moves no bit.
comptime M1_CHUNK_TPB = 64


def m1_chunk_count(seqlen: Int) -> Int:
    """Chunks of one call: `ceil(L / W)`, 0 for an empty call."""
    if seqlen <= 0:
        return 0
    return (seqlen + M1_CHUNK_W - 1) // M1_CHUNK_W


def _m1_grid(n: Int) -> Int:
    return (n + M1_CHUNK_TPB - 1) // M1_CHUNK_TPB


@always_inline
def _m1_da(dl: Float32, av: Float32) -> Float32:
    """S5 + S6, the v1 spelling."""
    return ftz(identical_exp(ftz(identical_mul(dl, av))))


@always_inline
def _m1_dbu(dl: Float32, bv: Float32, uv: Float32) -> Float32:
    """S7 then S8, `(delta * B) * u`, the v1 spelling."""
    var db = ftz(identical_mul(dl, bv))
    return ftz(identical_mul(db, uv))


# ===========================================================================
# PASS 1: the affine summary (P_end, Lc_end) of every chunk but the last.
# ===========================================================================


def m1_chunk_summary_kernel[
    DSTATE: Int
](gid_: Int,
    sum_p_ptr: MutPointer[Float32, MutAnyOrigin],
    sum_l_ptr: MutPointer[Float32, MutAnyOrigin],
    u_ptr: MutPointer[Float32, MutAnyOrigin],
    delta_ptr: MutPointer[Float32, MutAnyOrigin],
    a_ptr: MutPointer[Float32, MutAnyOrigin],
    b_ptr: MutPointer[Float32, MutAnyOrigin],
    batch_in: Int32,
    seqlen_in: Int32,
    dim_in: Int32,
    nch_in: Int32,
):
    """One `(b, k, d)` per thread for `k < nch - 1`, `DSTATE` chains in
    registers. Writes `sum_p`, `sum_l` `[B, nch, dim, DSTATE]` at slot k."""
    var batch = Int(batch_in)
    var seqlen = Int(seqlen_in)
    var dim = Int(dim_in)
    var nch = Int(nch_in)
    var tid = gid_
    var nsum = nch - 1
    if nsum <= 0 or tid >= batch * nsum * dim:
        return
    var d = tid % dim
    var rest = tid // dim
    var k = rest % nsum
    var bb = rest // nsum

    var a_vals = SIMD[DType.float32, DSTATE](0.0)
    comptime for n in range(DSTATE):
        a_vals[n] = ftz(a_ptr.unsafe_load(d * DSTATE + n))
    var p = SIMD[DType.float32, DSTATE](0.0)
    var lc = SIMD[DType.float32, DSTATE](0.0)

    var l0 = k * M1_CHUNK_W
    for j in range(M1_CHUNK_W):
        var t = bb * seqlen + l0 + j
        var uv = ftz(u_ptr.unsafe_load(t * dim + d))
        var dl = ftz(delta_ptr.unsafe_load(t * dim + d))
        comptime for n in range(DSTATE):
            var da = _m1_da(dl, a_vals[n])
            var dbu = _m1_dbu(dl, ftz(b_ptr.unsafe_load(t * DSTATE + n)), uv)
            if j == 0:
                p[n] = da
                lc[n] = dbu
            else:
                p[n] = ftz(identical_mul(da, p[n]))
                lc[n] = ftz(identical_mul_add(da, lc[n], dbu))

    var base = ((bb * nch + k) * dim + d) * DSTATE
    comptime for n in range(DSTATE):
        sum_p_ptr.unsafe_store(base + n, p[n])
        sum_l_ptr.unsafe_store(base + n, lc[n])


# ===========================================================================
# PASS 2: the serial chunk carry, one chain per thread.
# ===========================================================================


def m1_chunk_carry_kernel[
    DSTATE: Int
](gid_: Int,
    hin_ptr: MutPointer[Float32, MutAnyOrigin],
    h_ptr: MutPointer[Float32, MutAnyOrigin],
    sum_p_ptr: MutPointer[Float32, MutAnyOrigin],
    sum_l_ptr: MutPointer[Float32, MutAnyOrigin],
    batch_in: Int32,
    dim_in: Int32,
    nch_in: Int32,
):
    """One chain `(b, d, n)` per thread, ascending k: `hin[k]` is the state
    entering chunk k (`H_0 = ftz(h_in)`, `H_{k+1} = ftz(fma(P, H_k, Lc))`).
    Reads `h_ptr`, never writes it (pass 3 owns the final store)."""
    var batch = Int(batch_in)
    var dim = Int(dim_in)
    var nch = Int(nch_in)
    var tid = gid_
    if tid >= batch * dim * DSTATE:
        return
    var n = tid % DSTATE
    var rest = tid // DSTATE
    var d = rest % dim
    var bb = rest // dim

    var hk = ftz(h_ptr.unsafe_load((bb * dim + d) * DSTATE + n))
    hin_ptr.unsafe_store(((bb * nch + 0) * dim + d) * DSTATE + n, hk)
    for k in range(nch - 1):
        var src = ((bb * nch + k) * dim + d) * DSTATE + n
        hk = ftz(
            identical_mul_add(
                sum_p_ptr.unsafe_load(src), hk, sum_l_ptr.unsafe_load(src)
            )
        )
        hin_ptr.unsafe_store(
            ((bb * nch + k + 1) * dim + d) * DSTATE + n, hk
        )


# ===========================================================================
# PASS 3: the outputs (S9 v2, S10, S11) of every chunk, from its entry state.
# ===========================================================================


def m1_chunk_output_kernel[
    DSTATE: Int
](gid_: Int,
    out_ptr: MutPointer[Float32, MutAnyOrigin],
    y_ptr: MutPointer[Float32, MutAnyOrigin],
    h_ptr: MutPointer[Float32, MutAnyOrigin],
    hin_ptr: MutPointer[Float32, MutAnyOrigin],
    u_ptr: MutPointer[Float32, MutAnyOrigin],
    delta_ptr: MutPointer[Float32, MutAnyOrigin],
    a_ptr: MutPointer[Float32, MutAnyOrigin],
    b_ptr: MutPointer[Float32, MutAnyOrigin],
    c_ptr: MutPointer[Float32, MutAnyOrigin],
    d_ptr: MutPointer[Float32, MutAnyOrigin],
    batch_in: Int32,
    seqlen_in: Int32,
    dim_in: Int32,
    nch_in: Int32,
):
    """One `(b, k, d)` per thread. Entry state from `hin` slot k (with
    `nch == 1` the caller passes `h_state` itself as `hin`: the layouts
    coincide and the one thread of each chain reads before it writes). The
    thread of the LAST chunk stores the final state into `h_ptr`; no other
    thread of this launch reads `h_ptr` when `nch > 1`."""
    var batch = Int(batch_in)
    var seqlen = Int(seqlen_in)
    var dim = Int(dim_in)
    var nch = Int(nch_in)
    var tid = gid_
    if tid >= batch * nch * dim:
        return
    var d = tid % dim
    var rest = tid // dim
    var k = rest % nch
    var bb = rest // nch

    var a_vals = SIMD[DType.float32, DSTATE](0.0)
    comptime for n in range(DSTATE):
        a_vals[n] = ftz(a_ptr.unsafe_load(d * DSTATE + n))
    var d_val = ftz(d_ptr.unsafe_load(d))
    var hk = SIMD[DType.float32, DSTATE](0.0)
    var ebase = ((bb * nch + k) * dim + d) * DSTATE
    comptime for n in range(DSTATE):
        hk[n] = ftz(hin_ptr.unsafe_load(ebase + n))
    var p = SIMD[DType.float32, DSTATE](0.0)
    var lc = SIMD[DType.float32, DSTATE](0.0)
    var h = SIMD[DType.float32, DSTATE](0.0)

    var l0 = k * M1_CHUNK_W
    var count = min(M1_CHUNK_W, seqlen - l0)
    for j in range(count):
        var t = bb * seqlen + l0 + j
        var uv = ftz(u_ptr.unsafe_load(t * dim + d))
        var dl = ftz(delta_ptr.unsafe_load(t * dim + d))
        comptime for n in range(DSTATE):
            var da = _m1_da(dl, a_vals[n])
            var dbu = _m1_dbu(dl, ftz(b_ptr.unsafe_load(t * DSTATE + n)), uv)
            if j == 0:
                p[n] = da
                lc[n] = dbu
            else:
                p[n] = ftz(identical_mul(da, p[n]))
                lc[n] = ftz(identical_mul_add(da, lc[n], dbu))
            h[n] = ftz(identical_mul_add(p[n], hk[n], lc[n]))
        # S10: serial ascending n from +0.0, one fma per term (v1).
        var acc = Float32(0.0)
        comptime for n in range(DSTATE):
            acc = ftz(
                identical_mul_add(ftz(c_ptr.unsafe_load(t * DSTATE + n)), h[n], acc)
            )
        y_ptr.unsafe_store(t * dim + d, acc)
        # S11: product then add, D last (v1).
        var pd = ftz(identical_mul(uv, d_val))
        out_ptr.unsafe_store(t * dim + d, ftz(acc + pd))

    if k == nch - 1:
        comptime for n in range(DSTATE):
            h_ptr.unsafe_store((bb * dim + d) * DSTATE + n, h[n])


# ===========================================================================
# PASS 3': the backward checkpoint, every state of every chunk.
# ===========================================================================


def m1_chunk_checkpoint_kernel[
    DSTATE: Int
](gid_: Int,
    hck_ptr: MutPointer[Float32, MutAnyOrigin],
    hin_ptr: MutPointer[Float32, MutAnyOrigin],
    u_ptr: MutPointer[Float32, MutAnyOrigin],
    delta_ptr: MutPointer[Float32, MutAnyOrigin],
    a_ptr: MutPointer[Float32, MutAnyOrigin],
    b_ptr: MutPointer[Float32, MutAnyOrigin],
    batch_in: Int32,
    seqlen_in: Int32,
    dim_in: Int32,
    nch_in: Int32,
):
    """`hck [B, L+1, dim, DSTATE]`: slot 0 is the flushed entry state (written
    by the chunk-0 thread), slot `t + 1` is `h_t` under the v2 fold -- the same
    values pass 3 forms, so the backward reads the states the forward used."""
    var batch = Int(batch_in)
    var seqlen = Int(seqlen_in)
    var dim = Int(dim_in)
    var nch = Int(nch_in)
    var tid = gid_
    if tid >= batch * nch * dim:
        return
    var d = tid % dim
    var rest = tid // dim
    var k = rest % nch
    var bb = rest // nch
    var slots = seqlen + 1

    var a_vals = SIMD[DType.float32, DSTATE](0.0)
    comptime for n in range(DSTATE):
        a_vals[n] = ftz(a_ptr.unsafe_load(d * DSTATE + n))
    var hk = SIMD[DType.float32, DSTATE](0.0)
    var ebase = ((bb * nch + k) * dim + d) * DSTATE
    comptime for n in range(DSTATE):
        hk[n] = ftz(hin_ptr.unsafe_load(ebase + n))
    if k == 0:
        comptime for n in range(DSTATE):
            hck_ptr.unsafe_store(((bb * slots + 0) * dim + d) * DSTATE + n, hk[n])
    var p = SIMD[DType.float32, DSTATE](0.0)
    var lc = SIMD[DType.float32, DSTATE](0.0)

    var l0 = k * M1_CHUNK_W
    var count = min(M1_CHUNK_W, seqlen - l0)
    for j in range(count):
        var li = l0 + j
        var t = bb * seqlen + li
        var uv = ftz(u_ptr.unsafe_load(t * dim + d))
        var dl = ftz(delta_ptr.unsafe_load(t * dim + d))
        comptime for n in range(DSTATE):
            var da = _m1_da(dl, a_vals[n])
            var dbu = _m1_dbu(dl, ftz(b_ptr.unsafe_load(t * DSTATE + n)), uv)
            if j == 0:
                p[n] = da
                lc[n] = dbu
            else:
                p[n] = ftz(identical_mul(da, p[n]))
                lc[n] = ftz(identical_mul_add(da, lc[n], dbu))
            hck_ptr.unsafe_store(
                ((bb * slots + (li + 1)) * dim + d) * DSTATE + n,
                ftz(identical_mul_add(p[n], hk[n], lc[n])),
            )


# ===========================================================================
# LAUNCHERS
# ===========================================================================


def _m1_chunk_entries[
    DSTATE: Int
](
    ctx: DeviceContext,
    mut hin: DeviceBuffer[DType.float32],
    mut sum_p: DeviceBuffer[DType.float32],
    mut sum_l: DeviceBuffer[DType.float32],
    mut h_state: DeviceBuffer[DType.float32],
    mut u: DeviceBuffer[DType.float32],
    mut delta: DeviceBuffer[DType.float32],
    mut A: DeviceBuffer[DType.float32],
    mut B: DeviceBuffer[DType.float32],
    batch: Int,
    seqlen: Int,
    dim: Int,
    nch: Int,
) raises:
    """Passes 1 and 2: `hin[k]` for every chunk. ASYNCHRONOUS."""
    if nch > 1:
        comptime ksum = m1_chunk_summary_kernel[DSTATE]
        var _l1_a0 = sum_p.unsafe_ptr()
        var _l1_a1 = sum_l.unsafe_ptr()
        var _l1_a2 = u.unsafe_ptr()
        var _l1_a3 = delta.unsafe_ptr()
        var _l1_a4 = A.unsafe_ptr()
        var _l1_a5 = B.unsafe_ptr()
        var _l1_a6 = Int32(batch)
        var _l1_a7 = Int32(seqlen)
        var _l1_a8 = Int32(dim)
        var _l1_a9 = Int32(nch)
        def _launch_1(gid_: Int) {imm _l1_a0, imm _l1_a1, imm _l1_a2, imm _l1_a3, imm _l1_a4, imm _l1_a5, imm _l1_a6, imm _l1_a7, imm _l1_a8, imm _l1_a9}:
            ksum(gid_, _l1_a0, _l1_a1, _l1_a2, _l1_a3, _l1_a4, _l1_a5, _l1_a6, _l1_a7, _l1_a8, _l1_a9)
        host_launch(_launch_1, launch_count((_m1_grid(batch * (nch - 1) * dim), 1, 1), (M1_CHUNK_TPB, 1, 1)))
    comptime kcar = m1_chunk_carry_kernel[DSTATE]
    var _l2_a0 = hin.unsafe_ptr()
    var _l2_a1 = h_state.unsafe_ptr()
    var _l2_a2 = sum_p.unsafe_ptr()
    var _l2_a3 = sum_l.unsafe_ptr()
    var _l2_a4 = Int32(batch)
    var _l2_a5 = Int32(dim)
    var _l2_a6 = Int32(nch)
    def _launch_2(gid_: Int) {imm _l2_a0, imm _l2_a1, imm _l2_a2, imm _l2_a3, imm _l2_a4, imm _l2_a5, imm _l2_a6}:
        kcar(gid_, _l2_a0, _l2_a1, _l2_a2, _l2_a3, _l2_a4, _l2_a5, _l2_a6)
    host_launch(_launch_2, launch_count((_m1_grid(batch * dim * DSTATE), 1, 1), (M1_CHUNK_TPB, 1, 1)))


def m1_chunked_scan[
    DSTATE: Int
](
    ctx: DeviceContext,
    mut output: DeviceBuffer[DType.float32],
    mut y: DeviceBuffer[DType.float32],
    mut h_state: DeviceBuffer[DType.float32],
    mut u: DeviceBuffer[DType.float32],
    mut delta: DeviceBuffer[DType.float32],
    mut A: DeviceBuffer[DType.float32],
    mut B: DeviceBuffer[DType.float32],
    mut C: DeviceBuffer[DType.float32],
    mut D: DeviceBuffer[DType.float32],
    batch: Int,
    seqlen: Int,
    dim: Int,
) raises:
    """The v2 forward scan: `y`, `out` `[M, dim]`, `h_state` in and out.
    SYNCHRONOUS (it waits before its scratch buffers go out of scope)."""
    var nch = m1_chunk_count(seqlen)
    if batch <= 0 or dim <= 0 or nch == 0:
        return
    comptime kout = m1_chunk_output_kernel[DSTATE]
    if nch == 1:
        # One chunk: its entry state IS h_state (same layout); no scratch.
        var _l3_a0 = output.unsafe_ptr()
        var _l3_a1 = y.unsafe_ptr()
        var _l3_a2 = h_state.unsafe_ptr()
        var _l3_a3 = h_state.unsafe_ptr()
        var _l3_a4 = u.unsafe_ptr()
        var _l3_a5 = delta.unsafe_ptr()
        var _l3_a6 = A.unsafe_ptr()
        var _l3_a7 = B.unsafe_ptr()
        var _l3_a8 = C.unsafe_ptr()
        var _l3_a9 = D.unsafe_ptr()
        var _l3_a10 = Int32(batch)
        var _l3_a11 = Int32(seqlen)
        var _l3_a12 = Int32(dim)
        var _l3_a13 = Int32(nch)
        def _launch_3(gid_: Int) {imm _l3_a0, imm _l3_a1, imm _l3_a2, imm _l3_a3, imm _l3_a4, imm _l3_a5, imm _l3_a6, imm _l3_a7, imm _l3_a8, imm _l3_a9, imm _l3_a10, imm _l3_a11, imm _l3_a12, imm _l3_a13}:
            kout(gid_, _l3_a0, _l3_a1, _l3_a2, _l3_a3, _l3_a4, _l3_a5, _l3_a6, _l3_a7, _l3_a8, _l3_a9, _l3_a10, _l3_a11, _l3_a12, _l3_a13)
        host_launch(_launch_3, launch_count((_m1_grid(batch * dim), 1, 1), (M1_CHUNK_TPB, 1, 1)))
        ctx.synchronize()
        return
    var cells = batch * nch * dim * DSTATE
    var hin = ctx.enqueue_create_buffer[DType.float32](cells)
    var sum_p = ctx.enqueue_create_buffer[DType.float32](cells)
    var sum_l = ctx.enqueue_create_buffer[DType.float32](cells)
    _m1_chunk_entries[DSTATE](
        ctx, hin, sum_p, sum_l, h_state, u, delta, A, B, batch, seqlen, dim, nch
    )
    var _l4_a0 = output.unsafe_ptr()
    var _l4_a1 = y.unsafe_ptr()
    var _l4_a2 = h_state.unsafe_ptr()
    var _l4_a3 = hin.unsafe_ptr()
    var _l4_a4 = u.unsafe_ptr()
    var _l4_a5 = delta.unsafe_ptr()
    var _l4_a6 = A.unsafe_ptr()
    var _l4_a7 = B.unsafe_ptr()
    var _l4_a8 = C.unsafe_ptr()
    var _l4_a9 = D.unsafe_ptr()
    var _l4_a10 = Int32(batch)
    var _l4_a11 = Int32(seqlen)
    var _l4_a12 = Int32(dim)
    var _l4_a13 = Int32(nch)
    def _launch_4(gid_: Int) {imm _l4_a0, imm _l4_a1, imm _l4_a2, imm _l4_a3, imm _l4_a4, imm _l4_a5, imm _l4_a6, imm _l4_a7, imm _l4_a8, imm _l4_a9, imm _l4_a10, imm _l4_a11, imm _l4_a12, imm _l4_a13}:
        kout(gid_, _l4_a0, _l4_a1, _l4_a2, _l4_a3, _l4_a4, _l4_a5, _l4_a6, _l4_a7, _l4_a8, _l4_a9, _l4_a10, _l4_a11, _l4_a12, _l4_a13)
    host_launch(_launch_4, launch_count((_m1_grid(batch * nch * dim), 1, 1), (M1_CHUNK_TPB, 1, 1)))
    # The scratch must outlive the three launches (Mojo frees a local at its
    # last named use), so wait here and release it after.
    ctx.synchronize()
    _ = hin^
    _ = sum_p^
    _ = sum_l^


def m1_chunked_checkpoint[
    DSTATE: Int
](
    ctx: DeviceContext,
    mut h_ckpt: DeviceBuffer[DType.float32],
    mut h_in: DeviceBuffer[DType.float32],
    mut u: DeviceBuffer[DType.float32],
    mut delta: DeviceBuffer[DType.float32],
    mut A: DeviceBuffer[DType.float32],
    mut B: DeviceBuffer[DType.float32],
    batch: Int,
    seqlen: Int,
    dim: Int,
) raises:
    """The backward checkpoint under the v2 fold, `[B, L+1, dim, DSTATE]`.
    SYNCHRONOUS (scratch lifetime, as above). `h_in` is read, never written."""
    var nch = m1_chunk_count(seqlen)
    # L = 0 has no chunk; the caller keeps the v1 kernel for it (slot 0 only).
    if batch <= 0 or dim <= 0 or nch == 0:
        return
    var cells = batch * nch * dim * DSTATE
    var hin = ctx.enqueue_create_buffer[DType.float32](cells)
    var sum_p = ctx.enqueue_create_buffer[DType.float32](cells)
    var sum_l = ctx.enqueue_create_buffer[DType.float32](cells)
    _m1_chunk_entries[DSTATE](
        ctx, hin, sum_p, sum_l, h_in, u, delta, A, B, batch, seqlen, dim, nch
    )
    comptime kck = m1_chunk_checkpoint_kernel[DSTATE]
    var _l5_a0 = h_ckpt.unsafe_ptr()
    var _l5_a1 = hin.unsafe_ptr()
    var _l5_a2 = u.unsafe_ptr()
    var _l5_a3 = delta.unsafe_ptr()
    var _l5_a4 = A.unsafe_ptr()
    var _l5_a5 = B.unsafe_ptr()
    var _l5_a6 = Int32(batch)
    var _l5_a7 = Int32(seqlen)
    var _l5_a8 = Int32(dim)
    var _l5_a9 = Int32(nch)
    def _launch_5(gid_: Int) {imm _l5_a0, imm _l5_a1, imm _l5_a2, imm _l5_a3, imm _l5_a4, imm _l5_a5, imm _l5_a6, imm _l5_a7, imm _l5_a8, imm _l5_a9}:
        kck(gid_, _l5_a0, _l5_a1, _l5_a2, _l5_a3, _l5_a4, _l5_a5, _l5_a6, _l5_a7, _l5_a8, _l5_a9)
    host_launch(_launch_5, launch_count((_m1_grid(batch * nch * dim), 1, 1), (M1_CHUNK_TPB, 1, 1)))
    ctx.synchronize()
    _ = hin^
    _ = sum_p^
    _ = sum_l^
