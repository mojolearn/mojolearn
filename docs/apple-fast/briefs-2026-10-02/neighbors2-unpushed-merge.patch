+        _ = d_fl^
+        _ = d_part^
+        _ = d_cols^
+        _ = d_vals^
+        _ = d_a^
+        _ = d_b^
+        _ = d_nxt^
+        _ = d_ys^
+        _ = d_unl^
+        _ = ctx^
