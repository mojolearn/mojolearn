+    # -- drivers that shard inside the native binding ----------------------
+
+    def _physical_inventory(self):
+        """This process's unmasked driver inventory, asked in a CHILD for the
+        reason `_gpu_witness.unmasked_device_count` gives: the parent is in
+        the middle of a fit and owes the driver no extra state. The child
+        inherits this environment, so it sees the ordinals this process sees.
+        """
+        import subprocess
+        child = subprocess.run([sys.executable, "-m", "mojolearn._gpu_witness", self.vendor],
+                               capture_output=True, text=True, timeout=120)
+        if child.returncode != 0:
+            detail = (child.stderr or child.stdout or "").strip().splitlines()
+            raise RuntimeError("the GPU driver inventory child failed: "
+                               + (detail[-1] if detail else f"exit {child.returncode}"))
+        return json.loads(child.stdout)["inventory"]["devices"]
+
+    def _admit_session(self, trainer):
+        """The record for one native multi-device session, or a by-name
+        refusal. A session on fewer devices than the column asked for (the
+        in-cell replica reference every byte-LM lane opens on the first
+        device) is recorded and admits nothing.
+
+        WHAT THIS ADMITS, and it is the cooperative-pool rule restated for a
+        driver with no worker process: the trainer opened the requested group
+        natively, the binding's OWN ownership rows put resident bytes on every
+        requested device, and those ordinals are distinct physical GPUs by
+        UUID and PCI id. Like every record in `_gpu_witness` it is placement,
+        not proof that a kernel ran.
+        """
+        asked = tuple(trainer.devices)
+        record = dict(kind=NATIVE_SESSION, driver=type(trainer).__name__,
+                      devices=list(asked), cooperative=False, placed=False, workers=[])
+        if asked != self.devices or self.vendor not in ("cuda", "hip"):
+            # The CPU route has no device identity to give an in-process
+            # session, and there are no separate processes either, so a native
+            # session there is recorded and never counted.
+            return record
+        rows = trainer.optimizer_ownership()
+        resident = {}
+        for row in rows:
+            held = sum(int(v) for k, v in row.items() if k.endswith("_bytes"))
+            resident[row["device"]] = resident.get(row["device"], 0) + held
+        empty = [d for d in asked if resident.get(d, 0) <= 0]
+        if empty or set(resident) - set(asked):
+            raise RuntimeError(f"the native session names devices {list(asked)} but its own "
+                               f"ownership rows put resident bytes on {sorted(resident.items())}; "
+                               f"device(s) {empty} own nothing, so this column did not shard")
+        seen = {d["ordinal"]: d for d in self._physical_inventory()}
+        missing = [d for d in asked if d not in seen]
+        if missing:
+            raise RuntimeError(f"this process's driver shows no device at ordinal(s) {missing}")
+        placed = [seen[d] for d in asked]
+        if (len({d["uuid"] for d in placed}) != len(placed)
+                or len({d["pci_bus_id"] for d in placed}) != len(placed)):
+            raise RuntimeError("the native session's devices resolve to one physical GPU twice")
+        record.update(placed=True, resident_bytes=[resident[d] for d in asked],
+                      workers=[dict(pid=os.getpid(), devices=[d["uuid"] for d in placed],
+                                    visibility={})])
+        return record
+
+    def _watch_sessions(self):
+        """Wrap `_open` on each byte-LM trainer class; returns the undo list.
+        Each class defines its own `_open`, so each is wrapped where it is
+        defined. An install that cannot import them has no such lane to run.
+        """
+        try:
+            from .parallel_training import ParallelByteLanguageModelTrainer
+            from .model_pool_training import PooledByteLanguageModelTrainer
+            from .offload_training import OffloadedByteLanguageModelTrainer
+        except ImportError:
+            return []
+        undo = []
+        for cls in (ParallelByteLanguageModelTrainer, PooledByteLanguageModelTrainer,
+                    OffloadedByteLanguageModelTrainer):
+            original = cls.__dict__["_open"]
+
+            def opened(trainer, _original=original):
+                fresh = trainer._session is None
+                _original(trainer)
+                if not fresh or trainer._session is None:
+                    return
+                try:
+                    self.sessions.append(self._admit_session(trainer))
+                except Exception as exc:  # noqa: BLE001 - recorded, not swallowed
+                    self.errors.append(f"{type(exc).__name__}: {exc}")
+                    raise
+
+            cls._open = opened
+            undo.append((cls, original))
+        return undo
+
