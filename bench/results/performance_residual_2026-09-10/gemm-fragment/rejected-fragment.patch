+@always_inline
+def _tuned_operand_exponent(v: Float32) -> UInt32:
+    var bits = bitcast[DType.uint32](v)
+    var exponent = (bits >> 23) & UInt32(255)
+    # Staging flushes subnormals; zero products cannot cross the boundary.
+    if exponent == 0:
+        return UInt32(255)
+    # Exceptional operands always retain the original arithmetic path.
+    if exponent == 255:
+        return UInt32(0)
+    return exponent
+
+
+@always_inline
+def _tuned_fragment_admitted[NA: Int, NB: Int](
+    a: SIMD[DType.float32, NA], b: SIMD[DType.float32, NB]
+) -> Bool:
+    var amin = UInt32(255)
+    var bmin = UInt32(255)
+    comptime for i in range(NA):
+        amin = min(amin, _tuned_operand_exponent(a[i]))
+    comptime for j in range(NB):
+        bmin = min(bmin, _tuned_operand_exponent(b[j]))
+    return amin != 0 and bmin != 0 and amin + bmin >= UInt32(151)
+
+
+@always_inline
+def _tuned_fragment[
+    R: Int, C: Int, V: Int, ADMITTED: Bool
+](
+    ra: SIMD[DType.float32, R * V],
+    rb: SIMD[DType.float32, C * V],
+    mut acc: SIMD[DType.float32, R * C],
+) -> SIMD[DType.float32, R * C]:
+    # A normal float with biased exponent E is an integer times 2^(E-150).
+    # E_a + E_b >= 151 makes every exact product a multiple of 2^-149.
+    # The already-flushed accumulator is on that same lattice. Thus the
+    # exact FMA cannot lie strictly between min_normal - 2^-150 and
+    # min_normal: the only interval where pre-round FTZ differs from
+    # round-then-flush. Signed zero and underflow flushing remain hardware
+    # FMA semantics; every unproved fragment uses the corrected seam.
+    comptime for e in range(V):
+        var bfl = SIMD[DType.float32, C](0.0)
+        comptime for v in range(C):
+            bfl[v] = ftz(rb[v * V + e])
+        comptime for u in range(R):
+            var afl = ftz(ra[u * V + e])
+            comptime for v2 in range(C):
+                comptime if ADMITTED and TUNED_HW_FTZ_FMA:
+                    acc[u * C + v2] = llvm_intrinsic[
+                        "llvm.nvvm.fma.rn.ftz.f", Float32, has_side_effect=False
+                    ](afl, bfl[v2], acc[u * C + v2])
+                else:
+                    acc[u * C + v2] = _tuned_step(afl, bfl[v2], acc[u * C + v2])
+    return acc
+
