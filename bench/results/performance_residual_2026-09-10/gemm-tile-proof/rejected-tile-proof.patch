+@always_inline
+def _proof_exponent(v: Float32) -> UInt32:
+    var e = (bitcast[DType.uint32](v) >> 23) & UInt32(255)
+    if e == 0: return UInt32(255)
+    if e == 255: return UInt32(0)
+    return e
+
+
+def _tile_operand_bound[ROWS: Int](
+    src: MutPointer[Float32, MutAnyOrigin], outer_stride: Int,
+    k_stride: Int, start: Int, limit: Int, k: Int, tid: Int,
+) -> UInt32:
+    var lowest = UInt32(255)
+    var i = tid
+    while i < ROWS * k:
+        var r = i // k
+        var p = i % k
+        if outer_stride == 1:
+            r = i % ROWS
+            p = i // ROWS
+        if start + r < limit:
+            lowest = min(lowest, _proof_exponent(src.unsafe_load((start+r)*outer_stride+p*k_stride)))
+        i += TUNED_TPB
+    return lowest
 
 
+@always_inline
+def _tile_proven_step[ADMITTED: Bool](a: Float32, b: Float32, acc: Float32) -> Float32:
+    comptime if ADMITTED and TUNED_HW_FTZ_FMA:
+        return llvm_intrinsic["llvm.nvvm.fma.rn.ftz.f", Float32, has_side_effect=False](a,b,acc)
+    return _tuned_step(a,b,acc)
 
