+        var p = e - i * M3_HEADDIM
+        var ti = chunk * qs + i
+        var dv = Float32(0.0)
+        if ti < l:
+            dv = ftz(d_y.unsafe_load(((bb * l + ti) * nh + h) * M3_HEADDIM + p))
