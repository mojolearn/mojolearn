 for arm in default control; do
   flags=(-D MOJOLEARN_NUMERIC_IDENTICAL=1 -D MOJOLEARN_KNN_PHASE_TIMERS=1)
   [[ "$arm" != control ]] || flags+=(-D "$control=1")
