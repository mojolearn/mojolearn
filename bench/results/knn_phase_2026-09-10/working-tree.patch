 output=${2:?fresh absolute output directory required}
 case "$column" in
@@ -20,7 +24,7 @@ if [[ "$column" == nvidia ]]; then
   nvidia-smi --query-gpu=name,uuid,driver_version --format=csv > "$output/gpu.csv"
