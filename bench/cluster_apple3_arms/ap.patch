+    if k >= N:
+        return
+    var one_minus = ftz(Float32(1) - damping)
+    var v = r[i * N + k]
+    var rp = v if (i == k or v > Float32(0)) else Float32(0)
+    var nw = ftz(colsum[k] - rp)
+    if i != k and nw > Float32(0):
+        nw = Float32(0)
+    var old = a[i * N + k]
+    a[i * N + k] = ftz(ftz(identical_mul(old, damping)) + ftz(identical_mul(nw, one_minus)))
+
+
