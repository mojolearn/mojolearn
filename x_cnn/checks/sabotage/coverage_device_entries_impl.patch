+@always_inline
+def _sab_ulp32(v: Float32) -> Float32:
+    """SABOTAGE (coverage): one ulp up; a zero or subnormal becomes the smallest normal (same sign)."""
+    var u = bitcast[DType.uint32](v)
+    if (u & UInt32(0x7F800000)) == UInt32(0):
+        return bitcast[DType.float32]((u & UInt32(0x80000000)) | UInt32(0x00800000))
+    return bitcast[DType.float32](u + UInt32(1))
 
 
