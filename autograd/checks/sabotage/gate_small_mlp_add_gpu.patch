--- a/autograd/small_mlp_cells.mojo
+++ b/autograd/small_mlp_cells.mojo
@@ -21,6 +21,8 @@ Additions are checks.numerics' pinned FMA with multiplier one, operands and
 result flushed (the IDENTICAL FTZ).
 """
 from checks.numerics import ftz, identical_mul_add
+from std.sys.compile import is_defined  # SABOTAGE gate-gpu (lane vdv-sab2-a)
+from std.memory import bitcast  # SABOTAGE gate-gpu (lane vdv-sab2-a)
 
 comptime SMALL_MLP_BIAS = 0
 comptime SMALL_MLP_BIAS_RELU = 1
@@ -34,6 +36,11 @@ comptime _P = MutPointer[Float32, MutAnyOrigin]
 def small_mlp_add(left: Float32, right: Float32) -> Float32:
     # Existing pinned FP32 arithmetic: fma(1, left, right) is a single
     # rounded addition. Both operands and the result use the IDENTICAL FTZ.
+    comptime if not is_defined["MOJOLEARN_COLUMN_CPU"]():  # SABOTAGE gate-gpu (lane vdv-sab2-a): every small-MLP add one ulp up, the GPU bindings only
+        var sa = ftz(identical_mul_add(Float32(1), ftz(left), ftz(right)))
+        if abs(sa) >= Float32(1.17549435e-38) and sa - sa == Float32(0):
+            sa = bitcast[DType.float32](bitcast[DType.uint32](sa) + UInt32(1))
+        return sa
     return ftz(identical_mul_add(Float32(1), ftz(left), ftz(right)))
 
 
