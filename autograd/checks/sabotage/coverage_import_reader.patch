+def _cov_ulp_at(d: MutPointer[UInt8, MutUntrackedOrigin], o: Int):
+    """SABOTAGE coverage: the little-endian float32 at d + o one ulp off (a
+    zero or subnormal becomes the smallest normal)."""
+    var u = UInt32(d[o]) | (UInt32(d[o + 1]) << 8) | (UInt32(d[o + 2]) << 16) | (UInt32(d[o + 3]) << 24)
+    u = UInt32(0x00800000) if (u & UInt32(0x7FFFFFFF)) < UInt32(0x00800000) else u + UInt32(1)
+    for j in range(4):
+        d[o + j] = UInt8((u >> UInt32(8 * j)) & UInt32(0xFF))
