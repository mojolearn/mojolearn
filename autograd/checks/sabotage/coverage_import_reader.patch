+def _cov_ulp_at(d: _BytePtr, o: Int):
+    """SABOTAGE coverage: the little-endian float32 at d + o one ulp off (a
+    zero or subnormal becomes the smallest normal)."""
+    var u = UInt32(d[o]) | (UInt32(d[o + 1]) << 8) | (UInt32(d[o + 2]) << 16) | (UInt32(d[o + 3]) << 24)
+    u = UInt32(0x00800000) if (u & UInt32(0x7FFFFFFF)) < UInt32(0x00800000) else u + UInt32(1)
+    for j in range(4):
+        d[o + j] = UInt8((u >> UInt32(8 * j)) & UInt32(0xFF))
+
+
+def _cov_ulp_f(v: Float64) -> Float64:
+    """SABOTAGE coverage: a finite value one float32 ulp off."""
+    var fb = bitcast[DType.uint32](Float32(v))
+    if (fb & UInt32(0x7F800000)) == UInt32(0x7F800000):
+        return v
+    fb = UInt32(0x00800000) if (fb & UInt32(0x7FFFFFFF)) < UInt32(0x00800000) else fb + UInt32(1)
+    return Float64(bitcast[DType.float32](fb))
 
 
