def _c_adjoint_tanh2[E: Exec](mut ex: E, mut tape: Tape) raises -> Bool:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.40000000596), Float32(-0.600000023842), Float32(0.899999976158), Float32(0.300000011921), Float32(-0.20000000298), Float32(0.5)], 3, 2, True)
    var w1 = tape.tensor(ex, [Float32(0.699999988079), Float32(-0.40000000596), Float32(0.20000000298), Float32(0.300000011921), Float32(0.800000011921), Float32(-0.5)], 2, 3, True)
    var w2 = tape.tensor(ex, [Float32(0.600000023842), Float32(-0.300000011921), Float32(-0.20000000298), Float32(0.899999976158), Float32(0.5), Float32(0.40000000596)], 3, 2)
    var out = tape.tanh(ex, tape.matmul(ex, tape.tanh(ex, tape.matmul(ex, x, w1)), w2))
    var vseed = tape.tensor(ex, [Float32(0.187000006437), Float32(0.996999979019), Float32(0.347000002861), Float32(-0.81099998951), Float32(-0.78100001812), Float32(0.393000006676)], 3, 2)
    tape.backward_from(ex, out, vseed)
    var fo_x = tape.gradients(ex, x)
    var fo_w1 = tape.gradients(ex, w1)
    backward_recorded(tape, ex, out, vseed)
    var fdig = UInt64(1469598103934665603)
    var hdig = UInt64(1469598103934665603)
    var jtv_x = tape.values(ex, tape.grad_of(x))
    var jtv_w1 = tape.values(ex, tape.grad_of(w1))
    _check("adjoint_tanh2/vjp/x", jtv_x, [Float32(-0.236738959766), Float32(0.170570832864), Float32(0.433331957918), Float32(-0.428066134343), Float32(-0.581979882879), Float32(0.242140337085)], fdig)
    _check("adjoint_tanh2/vjp/w1", jtv_w1, [Float32(0.272448239153), Float32(-0.526348648946), Float32(0.0522295884595), Float32(-0.108685454003), Float32(-0.328727907172), Float32(-0.371791572952)], fdig)
    var same = _same_bits(jtv_x, fo_x) and _same_bits(jtv_w1, fo_w1)
    # jvp by the double-VJP identity: the gradient of <J^T w, u> in w is J u
    var wseed = tape.tensor(ex, [Float32(1), Float32(0.250999987125), Float32(-0.865000009537), Float32(-0.713999986649), Float32(0.483000010252), Float32(0.972999989986)], 3, 2, True)
    backward_recorded(tape, ex, out, wseed)
    var dv_x = tape.tensor(ex, [Float32(0.152999997139), Float32(-0.911000013351), Float32(-0.64099997282), Float32(0.568000018597), Float32(0.944999992847), Float32(-0.0630000010133)], 3, 2)
    var dv_w1 = tape.tensor(ex, [Float32(-0.518999993801), Float32(-0.962000012398), Float32(0.00400000018999), Float32(0.964999973774), Float32(0.512000024319), Float32(-0.690999984741)], 2, 3)
    var dot = _dot_sum(ex, tape, [tape.grad_of(x), tape.grad_of(w1)], [dv_x, dv_w1])
    tape.backward(ex, dot)
    var ju = tape.gradients(ex, wseed)
    _check("adjoint_tanh2/jvp", ju, [Float32(0.0244197196931), Float32(-0.268094006879), Float32(-0.405180455613), Float32(-0.150501210817), Float32(0.643255892056), Float32(-0.369525501048)], hdig)
    # <v, J u> = <J^T v, u>, both sides from the tape words
    var lhs = _inner(ju, [Float32(0.187000006437), Float32(0.996999979019), Float32(0.347000002861), Float32(-0.81099998951), Float32(-0.78100001812), Float32(0.393000006676)])
    var rhs = _inner(jtv_x, [Float32(0.152999997139), Float32(-0.911000013351), Float32(-0.64099997282), Float32(0.568000018597), Float32(0.944999992847), Float32(-0.0630000010133)]) + _inner(jtv_w1, [Float32(-0.518999993801), Float32(-0.962000012398), Float32(0.00400000018999), Float32(0.964999973774), Float32(0.512000024319), Float32(-0.690999984741)])
    if abs(lhs - rhs) > 1.0e-4 * (1.0 + abs(lhs)):
        raise Error("adjoint_tanh2: <v, J u> != <J^T v, u>")
    print("PASS adjoint_tanh2/identity lhs", lhs, "rhs", rhs)
    print("HIGHER_DIGEST adjoint_tanh2", hdig)
    return same

def _c_physics_tanh[E: Exec](mut ex: E, mut tape: Tape) raises -> Bool:
    tape.reset()
    var x = tape.tensor(ex, [Float32(-0.899999976158), Float32(-0.20000000298), Float32(0.40000000596), Float32(1.10000002384)], 4, 1, True)
    var w1 = tape.tensor(ex, [Float32(0.800000011921), Float32(-1.29999995232), Float32(0.5)], 1, 3, True)
    var b1 = tape.tensor(ex, [Float32(0.10000000149), Float32(0.300000011921), Float32(-0.20000000298)], 1, 3, True)
    var w2 = tape.tensor(ex, [Float32(0.899999976158), Float32(0.40000000596), Float32(-0.699999988079)], 3, 1, True)
    var a = tape.add(ex, tape.matmul(ex, x, w1), b1)
    var u = tape.matmul(ex, tape.tanh(ex, a), w2)
    var su = tape.sum(ex, u)
    tape.backward(ex, su)
    var fo_x = tape.gradients(ex, x)
    backward_scalar_recorded(tape, ex, su)
    var fdig = UInt64(1469598103934665603)
    var hdig = UInt64(1469598103934665603)
    var du = tape.grad_of(x)
    var rv_x = tape.values(ex, du)
    _check("physics_tanh/du_dx", rv_x, [Float32(0.166492559535), Float32(0.0112976376555), Float32(-0.239061076532), Float32(-0.176684819115)], fdig)
    var same = _same_bits(rv_x, fo_x)
    # rows are independent: the gradient of sum(du/dx) in x is d2u/dx2 per row
    backward_scalar_recorded(tape, ex, tape.sum(ex, du))
    var d2u = tape.grad_of(x)
    _check("physics_tanh/d2u_dx2", tape.values(ex, d2u), [Float32(0.0753499267927), Float32(-0.534084184303), Float32(-0.106211160404), Float32(0.104136896574)], hdig)
    # a residual d2u/dx2 + x, trained with a third backward
    var res = tape.add(ex, d2u, x)
    tape.backward(ex, tape.mean(ex, tape.multiply(ex, res, res)))
    _check("physics_tanh/residual/x", tape.gradients(ex, x), [Float32(-0.192414343236), Float32(-0.185554009491), Float32(0.323928289025), Float32(0.479767561131)], hdig)
    _check("physics_tanh/residual/w1", tape.gradients(ex, w1), [Float32(-1.13374808514), Float32(-0.492375382387), Float32(0.786185399337)], hdig)
    _check("physics_tanh/residual/b1", tape.gradients(ex, b1), [Float32(0.581526392984), Float32(0.0398084420983), Float32(0.0853231689746)], hdig)
    _check("physics_tanh/residual/w2", tape.gradients(ex, w2), [Float32(-0.544678156578), Float32(1.37405178519), Float32(-0.218068627156)], hdig)
    print("HIGHER_DIGEST physics_tanh", hdig)
    return same

def _c_linear_none[E: Exec](mut ex: E, mut tape: Tape) raises -> Bool:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.5), Float32(-0.300000011921), Float32(0.20000000298), Float32(0.899999976158), Float32(-0.699999988079), Float32(0.40000000596)], 3, 2, True)
    var w = tape.tensor(ex, [Float32(0.600000023842), Float32(-0.40000000596), Float32(0.300000011921), Float32(0.20000000298), Float32(0.699999988079), Float32(-0.5)], 2, 3, True)
    var b = tape.tensor(ex, [Float32(0.10000000149), Float32(-0.20000000298), Float32(0.300000011921)], 1, 3, True)
    var y = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.10000000149), Float32(0.5), Float32(0.20000000298), Float32(0.40000000596), Float32(-0.300000011921), Float32(0.600000023842), Float32(0.10000000149), Float32(0.20000000298)], 3, 3)
    var z = tape.linear(ex, x, w, Optional[Tensor](b), 0, Float32(0), Float32(0))
    var out = tape.mse_loss(ex, z, y)
    tape.backward(ex, out)
    var fo_x = tape.gradients(ex, x)
    var fo_w = tape.gradients(ex, w)
    var fo_b = tape.gradients(ex, b)
    backward_scalar_recorded(tape, ex, out)
    var fdig = UInt64(1469598103934665603)
    var hdig = UInt64(1469598103934665603)
    var same = True
    var gr_x = tape.grad_of(x)
    var rv_x = tape.values(ex, gr_x)
    _check("linear_none/grad/x", rv_x, [Float32(0.0573333366579), Float32(-0.0886666694548), Float32(0.0451111192372), Float32(-0.0222222321894), Float32(-0.155777786745), Float32(0.0375555519859)], fdig)
    same = same and _same_bits(rv_x, fo_x)
    var gr_w = tape.grad_of(w)
    var rv_w = tape.values(ex, gr_w)
    _check("linear_none/grad/w", rv_w, [Float32(0.144000002431), Float32(-0.0993333345453), Float32(0.0686666701833), Float32(-0.0373333375189), Float32(0.0471111054354), Float32(0.00777778231435)], fdig)
    same = same and _same_bits(rv_w, fo_w)
    var gr_b = tape.grad_of(b)
    var rv_b = tape.values(ex, gr_b)
    _check("linear_none/grad/b", rv_b, [Float32(-0.133333339625), Float32(-0.0666666785876), Float32(1.42388874025e-08)], fdig)
    same = same and _same_bits(rv_b, fo_b)
    var dv_x = tape.tensor(ex, [Float32(0.764999985695), Float32(-0.416000008583), Float32(-0.986999988556), Float32(-0.112000003457), Float32(0.926999986172), Float32(0.60799998045)], 3, 2)
    var dv_w = tape.tensor(ex, [Float32(0.170000001788), Float32(-0.903999984264), Float32(-0.653999984264), Float32(0.554000020027), Float32(0.949999988079), Float32(-0.0460000000894)], 2, 3)
    var dv_b = tape.tensor(ex, [Float32(-0.504999995232), Float32(-0.967000007629), Float32(-0.0120000001043)], 1, 3)
    var dot = _dot_sum(ex, tape, [gr_x, gr_w, gr_b], [dv_x, dv_w, dv_b])
    var hv = _second(ex, tape, dot, [x, w, b])
    _check("linear_none/hvp/x", hv[0], [Float32(0.273415556468), Float32(-0.483557775822), Float32(-0.121571110221), Float32(0.036646652937), Float32(0.0156333430837), Float32(-0.0620777932775)], hdig)
    _check("linear_none/hvp/w", hv[1], [Float32(-0.302413341851), Float32(-0.29246221038), Float32(-0.161755555735), Float32(-0.20106221757), Float32(0.250595550625), Float32(-0.113013335189)], hdig)
    _check("linear_none/hvp/b", hv[2], [Float32(-0.115999995318), Float32(-0.48377779939), Float32(0.0198888911729)], hdig)
    print("HIGHER_DIGEST linear_none", hdig)
    return same

