    same = same and _same_bits(rv_b, fo_b)
    var dv_x = tape.tensor(ex, [Float32(0.764999985695), Float32(-0.416000008583), Float32(-0.986999988556), Float32(-0.112000003457), Float32(0.926999986172), Float32(0.60799998045)], 3, 2)
