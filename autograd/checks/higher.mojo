def _c_dropout_tanh_square[E: Exec](mut ex: E, mut tape: Tape) raises -> Bool:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    var y = tape.dropout(ex, x, Float32(0.3), UInt64(7), 3)
    var th = tape.tanh(ex, y)
    var out = tape.sum(ex, tape.multiply(ex, th, th))
    tape.backward(ex, out)
    var fo_x = tape.gradients(ex, x)
    backward_scalar_recorded(tape, ex, out)
    var fdig = UInt64(1469598103934665603)
    var hdig = UInt64(1469598103934665603)
    var gr_x = tape.grad_of(x)
    var rv_x = tape.values(ex, gr_x)
    # the mask is the forward value: y = m s x, m s = y / x (x has no zero)
    var xs: List[Float32] = [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)]
    var vs: List[Float32] = [Float32(0.764999985695), Float32(-0.416000008583), Float32(-0.986999988556), Float32(-0.112000003457), Float32(0.926999986172), Float32(0.60799998045)]
    var ys = tape.values(ex, y)
    var want_g = List[Float32]()
    var want_h = List[Float32]()
    var kept = 0
    for i in range(len(xs)):
        var ms = Float64(ys[i]) / Float64(xs[i])
        var t = tanh(Float64(ys[i]))
        if ys[i] != 0:
            kept += 1
        want_g.append(Float32(ms * 2.0 * t * (1.0 - t * t)))
        want_h.append(Float32(ms * ms * 2.0 * (1.0 - t * t) * (1.0 - 3.0 * t * t) * Float64(vs[i])))
    _check("dropout_tanh_square/grad/x", rv_x, want_g, fdig)
    var same = _same_bits(rv_x, fo_x)
    var dv_x = tape.tensor(ex, vs, 2, 3)
    var hv = _second(ex, tape, _dot_sum(ex, tape, [gr_x], [dv_x]), [x])
    _check("dropout_tanh_square/hvp/x", hv[0], want_h, hdig)
    print("PASS dropout_tanh_square/mask kept", kept, "of", len(xs))
    print("HIGHER_DIGEST dropout_tanh_square", hdig)
    return same

def _r_layer_norm[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    var lw = tape.tensor(ex, [Float32(0.899999976158), Float32(1.29999995232), Float32(0.600000023842)], 1, 3, True)
    var lb = tape.tensor(ex, [Float32(0.899999976158), Float32(1.29999995232), Float32(0.600000023842)], 1, 3, True)
    var root = tape.sum(ex, layer_norm(tape, ex, x, lw, lb))
    var refused = 0
    try:
        backward_scalar_recorded(tape, ex, root)
    except e:
        refused = _refused(String(e), "create_graph cannot differentiate through", "layer_norm")
    if refused == 0:
        raise Error("layer_norm: not refused")
    return refused

def _r_custom_tag[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    var cn = tape.custom(ex, [x], tape.value(x), 2, 3, 123, Args())
    var root = tape.sum(ex, cn)
    var refused = 0
    try:
        backward_scalar_recorded(tape, ex, root)
    except e:
        refused = _refused(String(e), "create_graph cannot differentiate through", "custom_tag")
    if refused == 0:
        raise Error("custom_tag: not refused")
    return refused

def _r_no_differentiable_ancestors[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    tape.reset()
    var root = tape.scalar(ex, Float32(3))
    var refused = 0
    try:
        backward_scalar_recorded(tape, ex, root)
    except e:
        refused = _refused(String(e), "no differentiable ancestors", "no_differentiable_ancestors")
    if refused == 0:
        raise Error("no_differentiable_ancestors: not refused")
    return refused

def _r_grad_of_before_recorded[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    tape.backward(ex, tape.sum(ex, tape.multiply(ex, x, x)))
    var refused = 0
    try:
        _ = tape.grad_of(x)
    except e:
        refused = _refused(String(e), "no recorded gradient", "grad_of_before_recorded")
    if refused == 0:
        raise Error("grad_of_before_recorded: not refused")
    return refused

def _r_grad_of_unreached[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    var unreached = tape.exp(ex, x)
    backward_scalar_recorded(tape, ex, tape.sum(ex, tape.multiply(ex, x, x)))
    var refused = 0
    try:
        _ = tape.grad_of(unreached)
    except e:
        refused = _refused(String(e), "", "grad_of_unreached")
    if refused == 0:
        raise Error("grad_of_unreached: not refused")
    return refused

def _r_inferred_root[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    tape.no_grad()
    var root = tape.sum(ex, tape.multiply(ex, x, x))
    tape.record()
    var refused = 0
    try:
        backward_scalar_recorded(tape, ex, root)
    except e:
        refused = _refused(String(e), "inference mode", "inferred_root")
    if refused == 0:
        raise Error("inferred_root: not refused")
    return refused

def _r_grad_of_after_preactivation[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3)
    var w = tape.tensor(ex, [Float32(0.699999988079), Float32(-0.20000000298), Float32(0.10000000149), Float32(0.40000000596), Float32(-0.5), Float32(0.800000011921)], 3, 2, True)
    var z = tape.linear(ex, x, w)
    var seed = tape.tensor(ex, [Float32(1), Float32(1), Float32(1), Float32(1)], 2, 2)
    tape.backward_from_preactivation(ex, z, seed)
    var refused = 0
    try:
        _ = tape.grad_of(w)
    except e:
        refused = _refused(String(e), "no recorded gradient", "grad_of_after_preactivation")
    if refused == 0:
        raise Error("grad_of_after_preactivation: not refused")
    return refused

def _r_preactivation_after_recorded[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3)
    var w = tape.tensor(ex, [Float32(0.699999988079), Float32(-0.20000000298), Float32(0.10000000149), Float32(0.40000000596), Float32(-0.5), Float32(0.800000011921)], 3, 2, True)
    var z = tape.linear(ex, x, w)
    backward_scalar_recorded(tape, ex, tape.sum(ex, tape.multiply(ex, z, z)))
    var refused = 0
    try:
        _ = tape.preactivation_gradient(z)
    except e:
        refused = _refused(String(e), "", "preactivation_after_recorded")
    if refused == 0:
        raise Error("preactivation_after_recorded: not refused")
    return refused

def _refusals[E: Exec](mut ex: E, mut tape: Tape) raises -> Int:
    var count = 0
    count += _r_layer_norm(ex, tape)
    count += _r_custom_tag(ex, tape)
    count += _r_no_differentiable_ancestors(ex, tape)
    count += _r_grad_of_before_recorded(ex, tape)
    count += _r_grad_of_unreached(ex, tape)
    count += _r_inferred_root(ex, tape)
    count += _r_grad_of_after_preactivation(ex, tape)
    count += _r_preactivation_after_recorded(ex, tape)
    return count

def _lifecycle[E: Exec](mut ex: E, mut tape: Tape) raises:
    """30 x (reset, record, recorded backward, second backward) with no
    storage growth after the second iteration, the same words every time,
    and the same words again after release()."""
    var slots = 0
    var capacity = 0
    var first = List[Float32]()
    for iteration in range(31):
        if iteration == 30:
            tape.release(ex)
        tape.reset()
        var w = tape.tensor(ex, [Float32(0.7), Float32(-0.2), Float32(0.1), Float32(0.4), Float32(-0.5), Float32(0.8)], 2, 3, True)
        var x = tape.tensor(ex, [Float32(0.3), Float32(-0.8), Float32(1.2), Float32(0.7), Float32(0.2), Float32(-0.4)], 3, 2)
        var h = tape.tanh(ex, tape.matmul(ex, x, w))
        var out = tape.mean(ex, tape.multiply(ex, h, h))
        backward_scalar_recorded(tape, ex, out)
        var v = tape.tensor(ex, [Float32(0.5), Float32(-0.3), Float32(0.9), Float32(0.1), Float32(-0.7), Float32(0.4)], 2, 3)
        var dot = tape.sum(ex, tape.multiply(ex, tape.grad_of(w), v))
        tape.backward(ex, dot)
        var hv = tape.gradients(ex, w)
        if iteration == 0:
            first = hv.copy()
        elif not _same_bits(hv, first):
            raise Error("repeated higher-order graph changed its words at iteration " + String(iteration))
        if iteration == 30:
            break
        var total = 0
        for n in tape._capacities:
            total += n
        if iteration == 1:
            slots = len(tape._buffers)
            capacity = total
        elif iteration > 1 and (slots != len(tape._buffers) or capacity != total):
            raise Error("repeated higher-order graph grows tape storage")
    print("PASS higher lifecycle repeated_graphs=30 release=1")


