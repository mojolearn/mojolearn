    var y = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.10000000149), Float32(0.5), Float32(0.20000000298), Float32(0.40000000596), Float32(-0.300000011921), Float32(0.600000023842), Float32(0.10000000149), Float32(0.20000000298)], 3, 3)
    var z = tape.linear(ex, x, w, Optional[Tensor](b), RELU, Float32(0), Float32(0))
    var out = tape.mse_loss(ex, z, y)
    tape.backward(ex, out)
    var fo_x = tape.gradients(ex, x)
    var fo_w = tape.gradients(ex, w)
    var fo_b = tape.gradients(ex, b)
