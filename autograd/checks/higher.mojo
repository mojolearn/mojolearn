def _c_divide_joint[E: Exec](mut ex: E, mut tape: Tape) raises -> Bool:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    var y = tape.tensor(ex, [Float32(2.29999995232), Float32(1.20000004768), Float32(3.20000004768), Float32(2.70000004768), Float32(2.20000004768), Float32(1.60000002384)], 2, 3, True)
    var out = tape.sum(ex, tape.divide(ex, x, y))
    tape.backward(ex, out)
    var fo_x = tape.gradients(ex, x)
    var fo_y = tape.gradients(ex, y)
    backward_scalar_recorded(tape, ex, out)
    var fdig = UInt64(1469598103934665603)
    var hdig = UInt64(1469598103934665603)
    var same = True
    var gr_x = tape.grad_of(x)
    var rv_x = tape.values(ex, gr_x)
    _check("divide_joint/grad/x", rv_x, [Float32(0.434782617686), Float32(0.833333300254), Float32(0.312499995374), Float32(0.37037036385), Float32(0.4545454447), Float32(0.624999990664)], fdig)
    same = same and _same_bits(rv_x, fo_x)
    var gr_y = tape.grad_of(y)
    var rv_y = tape.values(ex, gr_y)
    _check("divide_joint/grad/y", rv_y, [Float32(-0.0567107796403), Float32(0.555555519726), Float32(-0.117187501167), Float32(-0.0960219428356), Float32(-0.0413223128696), Float32(0.156249997668)], fdig)
    same = same and _same_bits(rv_y, fo_y)
    var dv_x = tape.tensor(ex, [Float32(0.764999985695), Float32(-0.416000008583), Float32(-0.986999988556), Float32(-0.112000003457), Float32(0.926999986172), Float32(0.60799998045)], 2, 3)
    var dv_y = tape.tensor(ex, [Float32(0.170000001788), Float32(-0.903999984264), Float32(-0.653999984264), Float32(0.554000020027), Float32(0.949999988079), Float32(-0.0460000000894)], 2, 3)
    var dot = _dot_sum(ex, tape, [gr_x, gr_y], [dv_x, dv_y])
    var hv = _second(ex, tape, dot, [x, y])
    _check("divide_joint/hvp/x", hv[0], [Float32(-0.0321361076546), Float32(0.627777717023), Float32(0.0638671840275), Float32(-0.0759945130343), Float32(-0.196280980714), Float32(0.0179687495161)], hdig)
    _check("divide_joint/hvp/y", hv[1], [Float32(-0.136229146658), Float32(1.12592580697), Float32(0.0484863255333), Float32(0.054768072517), Float32(-0.155841463655), Float32(-0.228515610529)], hdig)
    print("HIGHER_DIGEST divide_joint", hdig)
    return same

def _c_divide_row[E: Exec](mut ex: E, mut tape: Tape) raises -> Bool:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
