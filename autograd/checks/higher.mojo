    var rv_x = tape.values(ex, gr_x)
    _check("divide_row/grad/x", rv_x, [Float32(0.714285726344), Float32(0.555555570214), Float32(0.909090889377), Float32(0.714285726566), Float32(0.555555570214), Float32(0.909090889345)], fdig)
    same = same and _same_bits(rv_x, fo_x)
    var gr_y = tape.grad_of(y)
    var rv_y = tape.values(ex, gr_y)
