def _shared_matmul[E: Exec](mut ex: E, mut tape: Tape) raises:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    var xt = tape.transpose(ex, x)
    var out = tape.matmul(ex, x, xt)
    check_values("shared_matmul/value", tape.values(ex, out), [Float32(2.17000014067), Float32(-0.430000026226), Float32(-0.430000026226), Float32(0.689999989271)])
    var seed = tape.tensor(ex, [Float32(-0.600000023842), Float32(-0.10000000149), Float32(0.40000000596), Float32(0.899999976158)], 2, 2)
