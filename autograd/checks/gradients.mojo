def _composite_shared_residual[E: Exec](mut ex: E, mut tape: Tape) raises:
    tape.reset()
    var x = tape.tensor(ex, [Float32(0.300000011921), Float32(-0.800000011921), Float32(1.20000004768), Float32(0.699999988079), Float32(0.20000000298), Float32(-0.40000000596)], 2, 3, True)
    var w = tape.tensor(ex, [Float32(0.800000011921), Float32(0.10000000149), Float32(0.10000000149), Float32(0.10000000149), Float32(0.800000011921), Float32(0.10000000149), Float32(0.10000000149), Float32(0.10000000149), Float32(0.800000011921)], 3, 3, True)
    var b = tape.tensor(ex, [Float32(0.0900000035763), Float32(0.129999995232), Float32(0.0599999986589)], 1, 3, True)
    var a = tape.matmul(ex, x, w)
    var b1 = tape.add(ex, a, b)
    var h = tape.tanh(ex, b1)
    var z = tape.matmul(ex, h, w)
    var skip = tape.add(ex, z, x)
    var out = tape.mse_loss(ex, skip, b)
    check_values("composite_shared_residual/value", tape.values(ex, out), [Float32(1.00732639902)])
    var seed = tape.tensor(ex, [Float32(1)], 1, 1)
    tape.backward_with_rules(ex, out, seed, NeuralRules())
    check_values("composite_shared_residual/x", tape.gradients(ex, x), [Float32(0.29292471615), Float32(-0.483945441543), Float32(0.731718983527), Float32(0.513087032028), Float32(0.211976136788), Float32(-0.208025128257)])
    check_values("composite_shared_residual/w", tape.gradients(ex, w), [Float32(0.440236529464), Float32(-0.0481300295396), Float32(0.109729270137), Float32(-0.0269063741953), Float32(0.33601277879), Float32(-0.426204517257), Float32(0.167696382591), Float32(-0.563486889282), Float32(0.731648697694)])
    check_values("composite_shared_residual/b", tape.gradients(ex, b), [Float32(-0.198373409455), Float32(0.158712608522), Float32(-0.300376327134)])

def run_gradient_checks[E: Exec](mut ex: E) raises:
    var tape = Tape()
    _add_row(ex, tape)
    _add_column(ex, tape)
    _add_scalar(ex, tape)
    _subtract_row(ex, tape)
    _subtract_column(ex, tape)
    _subtract_scalar(ex, tape)
    _multiply_row(ex, tape)
    _multiply_column(ex, tape)
    _multiply_scalar(ex, tape)
    _divide_row(ex, tape)
    _divide_column(ex, tape)
    _divide_scalar(ex, tape)
    _relu(ex, tape)
    _sigmoid(ex, tape)
    _tanh(ex, tape)
    _exp(ex, tape)
    _log(ex, tape)
    _sqrt(ex, tape)
    _scale(ex, tape)
    _sum_axis_all(ex, tape)
    _sum_axis_0(ex, tape)
    _sum_axis_1(ex, tape)
    _mean_axis_all(ex, tape)
    _mean_axis_0(ex, tape)
    _mean_axis_1(ex, tape)
    _matmul(ex, tape)
    _transpose(ex, tape)
    _reshape(ex, tape)
    _shared_matmul(ex, tape)
    _softmax(ex, tape)
    _log_softmax(ex, tape)
    _mse(ex, tape)
    _cross_entropy(ex, tape)
    _layer_norm(ex, tape)
    _composite_shared_residual(ex, tape)
    print("PASS finite-difference cases=35")
