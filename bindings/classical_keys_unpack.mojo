@always_inline
def classical_keys() raises -> UnsafePointer[ClassicalKeys, MutUntrackedOrigin]:
    """The family's keys: one slot fetch and one flag test. Fetch once per
    function, outside loops."""
    var nk = _CLASSICAL_KEYS.get_or_create_ptr()
    if not nk[].ready:
        _classical_keys_fill(nk)
    return nk
