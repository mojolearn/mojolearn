@always_inline
def host_rest_keys() raises -> UnsafePointer[HostRestKeys, MutUntrackedOrigin]:
    """The family's keys: one slot fetch and one flag test. Fetch once per
    function, outside loops."""
    var nk = _HOST_REST_KEYS.get_or_create_ptr()
    if not nk[].ready:
        _host_rest_keys_fill(nk)
    return nk
