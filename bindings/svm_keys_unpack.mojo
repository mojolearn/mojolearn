    var ops = Python.dict()
    nk[].ops = ops
    nk[].ready = True


@always_inline
def svm_keys() raises -> UnsafePointer[SvmKeys, MutUntrackedOrigin]:
    """The family's keys: one slot fetch and one flag test. Fetch once per
    function, outside loops."""
    var nk = _SVM_KEYS.get_or_create_ptr()
    if not nk[].ready:
        _svm_keys_fill(nk)
    return nk
