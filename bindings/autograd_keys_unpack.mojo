@always_inline
def autograd_keys() raises -> UnsafePointer[AutogradKeys, MutUntrackedOrigin]:
    """The family's keys: one slot fetch and one flag test. Fetch once per
    function, outside loops."""
    var nk = _AUTOGRAD_KEYS.get_or_create_ptr()
    if not nk[].ready:
        _autograd_keys_fill(nk)
    return nk
