comptime _AUTOGRAD_KEYS = SharedSlot[AutogradKeys, "MojolearnAutogradKeysV1"]


def _autograd_keys_fill(nk: UnsafePointer[AutogradKeys, MutUntrackedOrigin]) raises:
    # Once per process. `ready` is set last, so a fill that raised is run
    # again whole by the next call.
    nk[].k__DEFAULT_MODE = py_key("_DEFAULT_MODE")
    nk[].k__IMPORT_CONTEXT = py_key("_IMPORT_CONTEXT")
    nk[].k__SELECTED = py_key("_SELECTED")
    nk[].k__VariableFunctions = py_key("_VariableFunctions")
    nk[].k___bases__ = py_key("__bases__")
    nk[].k___dict__ = py_key("__dict__")
    nk[].k___flags__ = py_key("__flags__")
    nk[].k___iter__ = py_key("__iter__")
    nk[].k___mro__ = py_key("__mro__")
    nk[].k___slots__ = py_key("__slots__")
    nk[].k__b = py_key("_b")
