        return
    raise Error("RuntimeError: mojolearn: unknown member family number " + String(plan.family))


def member_pack_labeled(model: PythonObject, fields: PythonObject, context: PythonObject, b: PythonObject,
    plan: MemberPlan, state: Int, labels: PythonObject) raises:
    """PACK of a CLASSIFIER member: `member_pack`, with the caller's class
    labels (the object the estimator's own fit publishes as its classes for
    the `y` the caller encoded: code `c` is `labels[c]`).

    The labels never enter the typed plan. They are held in the instance
    dictionary under the one reserved key while the family's pack runs
    (bindings/member_owner_unpack.mojo `member_labels_hold`). A family whose
    fitted estimator keeps the labels in its own form (a property over a
    private field, a label-name table) takes them with
    `member_labels_take(fields, b)` inside its pack and writes that form. A
    family that does not take them gets the plain attribute: `classes_` is
    written here, as the estimators that keep it as an instance field do.
    If the family's pack raises, the caller drops the estimator; the key is
    not removed from an estimator nobody will see."""
    member_labels_hold(fields, labels)
    member_pack(model, fields, context, b, plan, state)
    var left = member_labels_take(fields, b)
    if left is not None:
        py_setitem(fields, PythonObject("classes_"), left)


def member_state(model: PythonObject, fields: PythonObject, context: PythonObject, b: PythonObject,
    plan: MemberPlan) raises -> Int:
    """UNPACK: a new member state holding the fitted attributes of the
    fitted estimator `model` (a prefit member). The caller frees it. A prefit
    classifier's labels are its public `classes_`: the caller reads them at
    its own UNPACK and sets `plan.classes` before this call."""
    if plan.family == MEMBER_FAMILY_LINEAR:
        return linear_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_LOGISTIC:
        return logistic_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_XLINEAR:
        return xlinear_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SGD:
        return sgd_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_CD:
        return cd_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_LINEAR_SVM:
        return linear_svm_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_KERNEL_SVM:
        return kernel_svm_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_KERNEL_RIDGE:
        return kernel_ridge_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_KERNEL_APPROX:
        return kernel_approx_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_NAIVE_BAYES:
        return naive_bayes_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_DISCRIMINANT:
        return discriminant_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_NEIGHBORS:
        return neighbors_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_XNEIGHBORS:
        return xneighbors_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_TREE:
        return tree_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_FOREST:
        return forest_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_EXTRA_TREES:
        return extra_trees_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_GBDT:
        return gbdt_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_DART:
        return dart_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_ISOLATION_FOREST:
        return isolation_forest_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_MLP:
        return mlp_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SEQUENCE:
        return sequence_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_CNN:
        return cnn_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_PLS:
        return pls_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_GP:
        return gp_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_KMEANS:
        return kmeans_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_XCLUSTER:
        return xcluster_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_MIXTURE:
        return mixture_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_DENSITY:
        return density_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_HDBSCAN:
        return hdbscan_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_HIERARCHY:
        return hierarchy_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SPECTRAL:
        return spectral_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_DECOMPOSITION:
        return decomposition_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_XDECOMP:
        return xdecomp_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_MANIFOLD:
        return manifold_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SCALER:
        return scaler_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_PREP:
        return prep_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SELECT:
        return select_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_FORECAST:
        return forecast_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_CHOLESKY:
        return cholesky_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_ENSEMBLE:
        return ensemble_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SEARCH:
        return search_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_PIPELINE:
        return pipeline_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_TSNE:
        return tsne_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_FORECAST_SEQ:
        return forecast_seq_member_state(model, fields, context, b, plan)
    raise Error("RuntimeError: mojolearn: unknown member family number " + String(plan.family))
