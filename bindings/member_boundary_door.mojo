def member_admit(model: PythonObject, fields: PythonObject, plan: PythonObject, context: PythonObject,
    b: PythonObject) raises -> MemberOwner:
    """The native member of `model`, or an owner with `published` False when
    its class has no member entry (the caller then keeps the member's own
    doors). `plan` is the class's model-selection plan, `context` the
    member's family context (`plan["context"]`), `fields` the instance
    dictionary, `b` the builtins module the caller already admitted."""
    var owner = MemberOwner()
    var mark = member_mark(plan, b)
    if mark.family < 0:
        return owner^
    owner.plan.family = mark.family
    owner.plan.kind = mark.kind
    var filled = False
    if owner.plan.family == MEMBER_FAMILY_LINEAR:
        filled = linear_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_LOGISTIC:
        filled = logistic_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_XLINEAR:
        filled = xlinear_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_SGD:
        filled = sgd_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_CD:
        filled = cd_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_LINEAR_SVM:
        filled = linear_svm_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_KERNEL_SVM:
        filled = kernel_svm_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_KERNEL_RIDGE:
        filled = kernel_ridge_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_KERNEL_APPROX:
        filled = kernel_approx_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_NAIVE_BAYES:
        filled = naive_bayes_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_DISCRIMINANT:
        filled = discriminant_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_NEIGHBORS:
        filled = neighbors_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_XNEIGHBORS:
        filled = xneighbors_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_TREE:
        filled = tree_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_FOREST:
        filled = forest_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_EXTRA_TREES:
        filled = extra_trees_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_GBDT:
        filled = gbdt_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_DART:
        filled = dart_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_ISOLATION_FOREST:
        filled = isolation_forest_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_MLP:
        filled = mlp_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_SEQUENCE:
        filled = sequence_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_CNN:
        filled = cnn_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_PLS:
        filled = pls_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_GP:
        filled = gp_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_KMEANS:
        filled = kmeans_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_XCLUSTER:
        filled = xcluster_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_MIXTURE:
        filled = mixture_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_DENSITY:
        filled = density_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_HDBSCAN:
        filled = hdbscan_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_HIERARCHY:
        filled = hierarchy_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_SPECTRAL:
        filled = spectral_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_DECOMPOSITION:
        filled = decomposition_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_XDECOMP:
        filled = xdecomp_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_MANIFOLD:
        filled = manifold_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_SCALER:
        filled = scaler_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_PREP:
        filled = prep_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_SELECT:
        filled = select_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_FORECAST:
        filled = forecast_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_CHOLESKY:
        filled = cholesky_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_ENSEMBLE:
        filled = ensemble_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_SEARCH:
        filled = search_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_PIPELINE:
        filled = pipeline_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_TSNE:
        filled = tsne_member_admit(model, fields, mark.kind, context, b, owner)
    elif owner.plan.family == MEMBER_FAMILY_FORECAST_SEQ:
        filled = forecast_seq_member_admit(model, fields, mark.kind, context, b, owner)
    if not filled:
        return owner^
    owner.plan.member = member_resolve_family(owner.plan.family, owner.plan.route)
    owner.published = True
    return owner^


def member_admit_serving(model: PythonObject, fields: PythonObject, plan: PythonObject, context: PythonObject,
    b: PythonObject, needs: Int) -> MemberOwner:
    """`member_admit` for a caller that had a path for this class before
    its member mark: the native member when the family serves EVERY
    capability bit of `needs` for this estimator, else an owner with
    `published` False, and the caller takes the path an unmarked class
    takes. Never raises: an admission the family refuses (a parameter it
    does not take as words, class weights, a precomputed kernel, an image
    that is not loaded) is the same silent fallback, and that path then
    raises its own words if the request is wrong. A member mark never turns
    a call that worked into a refusal.

    A classifier whose class_weight is a dict (lane mf-adm3) is admitted
    with its table pending (core/member_class_weight.mojo): served for a
    caller that only predicts (`needs` without MEMBER_CAN_FIT: the weights
    shaped the fitted state, not the predictions), refused here for a fit,
    whose caller hands over its labels through
    `member_admit_serving_labeled` instead."""
    return member_admit_serving_labeled(model, fields, plan, context, b, needs, PythonObject(None))


def member_admit_serving_labeled(model: PythonObject, fields: PythonObject, plan: PythonObject,
    context: PythonObject, b: PythonObject, needs: Int, labels: PythonObject) -> MemberOwner:
    """`member_admit_serving` for a FIT caller that holds the labels of the
    codes it fits on (`labels`: the classes in code order; None: it holds
    none). A pending class_weight table stays pending here: the caller
    completes it with `member_cw_fill` outside this never-raising call, so
    a dict the estimator refuses raises its own words there (lane mf-adm3).
    Without labels a FIT admission of such a member is the fallback."""
    try:
        var owner = member_admit(model, fields, plan, context, b)
        if owner.published and not owner.plan.member.has(needs):
            owner.published = False
        if owner.published and (needs & MEMBER_CAN_FIT) != 0 and labels is None:
            if member_cw_pending(owner.plan.params, member_cw_start(owner.plan.family, owner.plan.kind,
                                                                    owner.plan.params)):
                owner.published = False
        return owner^
    except:
        return MemberOwner()


