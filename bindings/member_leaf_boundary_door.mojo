    elif family == MEMBER_FAMILY_KERNEL_SVM:
        return kernel_svm_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_KERNEL_RIDGE:
        return kernel_ridge_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_KERNEL_APPROX:
        return kernel_approx_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_NAIVE_BAYES:
        return naive_bayes_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_DISCRIMINANT:
        return discriminant_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_NEIGHBORS:
        return neighbors_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_XNEIGHBORS:
        return xneighbors_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_TREE:
        return tree_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_FOREST:
        return forest_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_EXTRA_TREES:
        return extra_trees_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_GBDT:
        return gbdt_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_DART:
        return dart_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_ISOLATION_FOREST:
        return isolation_forest_member_admit(model, fields, kind, context, b, owner)
