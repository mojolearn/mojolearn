    if plan.family == MEMBER_FAMILY_DENSITY:
        return density_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_HDBSCAN:
        return hdbscan_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_HIERARCHY:
        return hierarchy_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SPECTRAL:
        return spectral_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_DECOMPOSITION:
        return decomposition_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_XDECOMP:
        return xdecomp_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_MANIFOLD:
        return manifold_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SCALER:
        return scaler_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_PREP:
        return prep_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_SELECT:
        return select_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_FORECAST:
        return forecast_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_CHOLESKY:
        return cholesky_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_TSNE:
        return tsne_member_state(model, fields, context, b, plan)
    if plan.family == MEMBER_FAMILY_FORECAST_SEQ:
        return forecast_seq_member_state(model, fields, context, b, plan)
    raise Error("RuntimeError: mojolearn: unknown member family number " + String(plan.family))
