    elif family == MEMBER_FAMILY_GP:
        return gp_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_KMEANS:
        return kmeans_member_admit(model, fields, kind, context, b, owner)
    elif family == MEMBER_FAMILY_XCLUSTER:
