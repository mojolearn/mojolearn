@always_inline
def trees_keys() raises -> UnsafePointer[TreesKeys, MutUntrackedOrigin]:
    """The family's keys: one slot fetch and one flag test. Fetch once per
    function, outside loops."""
    var nk = _TREES_KEYS.get_or_create_ptr()
    if not nk[].ready:
        _trees_keys_fill(nk)
    return nk
