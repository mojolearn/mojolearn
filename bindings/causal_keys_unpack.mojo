    var ops = Python.dict()
    nk[].ops = ops
    nk[].ready = True


@always_inline
def causal_keys() raises -> UnsafePointer[CausalKeys, MutUntrackedOrigin]:
    """The family's keys: one slot fetch and one flag test. Fetch once per
    function, outside loops."""
    var nk = _CAUSAL_KEYS.get_or_create_ptr()
    if not nk[].ready:
        _causal_keys_fill(nk)
    return nk
