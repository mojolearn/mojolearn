# SPDX-License-Identifier: Apache-2.0
# The host_tree_archive family's held name keys (bindings/py_keys.mojo has the
# form and its cost rule): the tree, archive and iforest files of the host
# family (bindings/host_tree_*, host_archive_*, host_density_archive_*,
# host_iforest_*). It has no operation codes: host_tree_operation takes its
# name String from the classical and GBDT owners, whose chains are converted
# with their own families. Written by the boundary codemod of lane
# fx-boundary-core; a name the family starts to read is added in the three
# places below (field, None, fill), and the slot name keeps its V<n> until a
# wheel that holds the old layout could meet this one in a process (bump
# `V<n>` and the version together then: core/shared_slot.mojo).
from std.python import Python, PythonObject
from core.shared_slot import SharedSlot
from bindings.py_keys import py_key, py_op_add



