@always_inline
def host_tree_archive_keys() raises -> UnsafePointer[HostTreeArchiveKeys, MutUntrackedOrigin]:
    """The family's keys: one slot fetch and one flag test. Fetch once per
    function, outside loops."""
    var nk = _HOST_TREE_ARCHIVE_KEYS.get_or_create_ptr()
    if not nk[].ready:
        _host_tree_archive_keys_fill(nk)
    return nk
