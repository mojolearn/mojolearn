@always_inline
def sequence_keys() raises -> UnsafePointer[SequenceKeys, MutUntrackedOrigin]:
    """The family's keys: one slot fetch and one flag test. Fetch once per
    function, outside loops."""
    var nk = _SEQUENCE_KEYS.get_or_create_ptr()
    if not nk[].ready:
        _sequence_keys_fill(nk)
    return nk
