@@ -954,6 +959,12 @@ def identical_mul_add_simd[
     c: SIMD[DType.float32, w],
 ) -> SIMD[DType.float32, w]:
     """`identical_mul_add`, lane by lane: ONE rounding under IDENTICAL, the naive chain under FAST."""
+    comptime if is_defined["MOJOLEARN_COLUMN_CPU"]():  # SABOTAGE sab2b-mul_add-cpu (lane vdv-sab2-b): every normal finite lane one ulp up, the host bindings only
