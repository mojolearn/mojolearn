 def identical_mul_add(a: Float32, b: Float32, c: Float32) -> Float32:
     """IDENTITY_PATHS row 9's construction: the contraction pin."""
+    comptime if is_defined["MOJOLEARN_COLUMN_CPU"]():  # SABOTAGE sab2b-mul_add-cpu (lane vdv-sab2-b): a normal finite result one ulp up, the host bindings only
