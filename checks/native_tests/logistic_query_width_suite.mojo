# SPDX-License-Identifier: Apache-2.0
"""Native feature-width contracts with analytic, independently chosen answers.

Each fixture owns its scalar metadata. Independent fixtures run through the
shared host worker pool. No Python objects, product kernels or identity runs.
"""
from core.host_parallel import host_parallelize
from core.native_scalar_decode import NativeRealBits
from core.logistic_query_state import (
    LogisticQueryWidth, logistic_width_integer, logistic_query_integer_width,
)

comptime LOGISTIC_WIDTH_FIXTURES = 80


def require(ok: Bool, message: String) raises:
    if not ok:
        raise Error(message)


def check(width: LogisticQueryWidth, features: Int, expected: Bool) raises:
    require(width.matches(features) == expected, "native feature equality changed")
    # Both public error prefixes must agree with the same typed decision.
    for host in [False, True]:
        var refused = False
        try:
            width.validate(features, host)
        except error:
            refused = True
            require(String(error) == (String("") if host else String("mojolearn ")) +
                "LogisticRegression feature count differs from fit", "query error text changed")
        require(refused != expected, "query validation disagrees with equality")


def integer_fixture(index: Int) raises:
    var values: List[Int] = [0, 1, -1, 2, -2, 9223372036854775807,
        -9223372036854775807 - 1, 9007199254740993]
    var words: List[UInt64] = [0, 1, 1, 2, 2, 0x7FFFFFFFFFFFFFFF,
        0x8000000000000000, 0x20000000000001]
    var value = values[index]
    var decoded = logistic_width_integer(value)
    require(decoded.low == words[index] and decoded.high == 0 and decoded.scale == 0
        and decoded.negative == (index == 2 or index == 4 or index == 6), "integer scalar lost bits")
    check(LogisticQueryWidth(decoded), value, True)
    check(LogisticQueryWidth(kind=3, integer_value=value), value, True)
    check(LogisticQueryWidth(kind=3, integer_value=value), 3, False)


def exact_fixture(index: Int) raises:
    var width = LogisticQueryWidth(NativeRealBits(2))
    var features = 2
    var expected = True
    if index == 0 or index == 1:
        width.real = NativeRealBits(negative=index == 1)
        features = 0
    elif index == 2:
        width.real = NativeRealBits(1, scale=1)
    elif index == 3:
        width.real = NativeRealBits(0, high=1, scale=-63)
    elif index == 4:
        # 2 + 2**-63 must not become exactly 2 through a binary64 cast.
        width.real = NativeRealBits(1, high=1, scale=-63)
        expected = False
    elif index == 5:
        width.real = NativeRealBits(3, scale=-1)
        features = 1
        expected = False
    elif index == 6:
        width.real.negative = True
        expected = False
    elif index == 7:
        width.real.negative = True
        features = -2
    elif index == 8 or index == 9:
        width.real = NativeRealBits(1, special=2 if index == 8 else 1)
        expected = False
    elif index == 10:
        width.imag = NativeRealBits(negative=True)
    elif index == 11 or index == 12 or index == 13:
        width.imag = NativeRealBits(1, special=0 if index == 11 else (2 if index == 12 else 1))
        expected = False
    elif index == 14:
        width.real = NativeRealBits(0x8000000000000000, negative=True)
        features = -9223372036854775807 - 1
    elif index == 15:
        width.real = NativeRealBits(0x20000000000000)
        features = 9007199254740993
        expected = False
    elif index == 16:
        width.real = NativeRealBits(1, scale=-1074)
        features = 0
        expected = False
    elif index == 17:
        width.real = NativeRealBits(0, high=1, scale=0)
        features = 0
        expected = False
    check(width, features, expected)


def precision_fixture(index: Int) raises:
    # Literal ties-to-even answers at each precision's first skipped integer.
    # These are not generated by the implementation's casts or helper methods.
    var precisions: List[Int] = [16,16,16,16,16,16,16,16,8,8,8,32,32,32,64,64,64,0,32,16]
    var features: List[Int] = [2049,2051,2051,65519,65520,-65520,65520,3,257,259,259,
        16777217,16777219,16777219,9007199254740993,9007199254740995,9007199254740995,
        9007199254740993,-16777217,-2049]
    var magnitudes: List[UInt64] = [2048,2050,2052,65504,0,0,65504,2,256,258,260,
        16777216,16777218,16777220,9007199254740992,9007199254740994,9007199254740996,
        9007199254740992,16777216,2048]
    var expected = (index != 1 and index != 6 and index != 7 and index != 9
        and index != 12 and index != 15 and index != 17)
    var real = NativeRealBits(magnitudes[index], negative=index == 5 or index == 18 or index == 19,
        special=1 if index == 4 or index == 5 else 0)
    check(LogisticQueryWidth(real, precision=precisions[index]), features[index], expected)


def wrapped_integer_fixture(index: Int) raises:
    # Torch wrapped-scalar comparison: exact modular integer results, including
    # sign edges, are table literals rather than another copy of the algorithm.
    var widths: List[Int] = [8,8,8,8,8,8,16,16,16,16,32,32,32,32,64,64,64,64]
    var signed_flags: List[Bool] = [False,False,False,True,True,True,False,False,True,True,
        False,False,True,True,False,False,True,True]
    var features: List[Int] = [256,257,-1,128,255,256,65536,-1,32768,65535,
        4294967296,-1,2147483648,4294967295,-1,9223372036854775807,
        -9223372036854775807 - 1,9223372036854775807]
    var magnitudes: List[UInt64] = [0,1,255,128,1,0,0,65535,32768,1,
        0,4294967295,2147483648,1,0xFFFFFFFFFFFFFFFF,0x7FFFFFFFFFFFFFFF,
        0x8000000000000000,0x7FFFFFFFFFFFFFFF]
    var negative_flags: List[Bool] = [False,False,False,True,True,False,False,False,True,True,
        False,False,True,True,False,False,True,False]
    var width = LogisticQueryWidth(NativeRealBits(magnitudes[index], negative=negative_flags[index]),
        integer_bits=widths[index], integer_signed=signed_flags[index])
    check(width, features[index], True)
    check(width, 3, False)


def overflow_fixture(index: Int) raises:
    var features: List[Int] = [65519,65520,-65519,-65520,65520,65520,65520,0]
    var width = LogisticQueryWidth(precision=16, numpy_cast=True)
    if index == 4:
        width.numpy_cast = False
    elif index == 5:
        width.precision = 32
    elif index == 6:
        width.precision = 0
    require(width.cast_overflow(features[index]) == (index == 1 or index == 3),
        "NumPy half-width overflow event changed")


def policy_fixture(index: Int) raises:
    if index < 4:
        # Nonnumeric/oversized values never match; legacy empty-array truth
        # intentionally admits any width, with its warning kept at UNPACK.
        check(LogisticQueryWidth(kind=1 if index < 2 else 2), 0 if index % 2 == 0 else 29, index >= 2)
        return
    var features = 2
    var fitted = 2 if index == 4 or index == 5 else 3
    var host = index % 2 == 1
    var refused = False
    try:
        logistic_query_integer_width(features, fitted, host)
    except error:
        refused = True
        require(String(error) == (String("") if host else String("mojolearn ")) +
            "LogisticRegression feature count differs from fit", "integer width error text changed")
    require(refused == (index >= 6), "binary/host integer-width contract changed")


def fixture(index: Int) raises:
    if index < 8:
        integer_fixture(index)
    elif index < 26:
        exact_fixture(index - 8)
    elif index < 46:
        precision_fixture(index - 26)
    elif index < 64:
        wrapped_integer_fixture(index - 46)
    elif index < 72:
        overflow_fixture(index - 64)
    else:
        policy_fixture(index - 72)


def run_checks() raises:
    var failures = List[Int](length=LOGISTIC_WIDTH_FIXTURES, fill=0)
    var fp = failures.unsafe_ptr()
    def task(index: Int) {imm fp}:
        try:
            fixture(index)
        except error:
            fp.unsafe_store(index, 1)
            print("FAIL logistic_query_width fixture", index, String(error))
    host_parallelize(task, LOGISTIC_WIDTH_FIXTURES)
    var failed = 0
    for value in failures:
        failed += value
    require(failed == 0, "logistic_query_width failed " + String(failed) + " fixtures")
    print("PASS logistic_query_width:", LOGISTIC_WIDTH_FIXTURES, "native equality/admission decision fixtures")
