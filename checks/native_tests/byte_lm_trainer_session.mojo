# SPDX-License-Identifier: Apache-2.0
"""The byte LM trainer's resident session, reached through the image's
session entry (`core/byte_lm_entry_table_sessions.mojo`), ported from
`test_byte_lm_train_steps.py`, `test_byte_lm_trainer_logits.py`,
`test_byte_lm_session.py` and `test_byte_lm_surface.py` (lane tmig-lm-1,
2026-11-14).

The cases take the table key, so the host column (vendor word 0, published
by `publish_byte_lm_host_entries`) and a GPU column (published by
`publish_byte_lm_entries`) run the same units. Each unit opens its own
sessions with the trainer's default shape and optimizer
(`LanguageModelTrainer`: AdamW lr 1e-3, betas (0.9, 0.999), eps 1e-8,
weight decay 0.01) and hands the trainer operations the descriptors the
door (`bindings/byte_lm_trainer_native_door.mojo`) hands them.

Fixtures: the Python tests drew their parameters and batches from NumPy's
PCG64 stream; every assertion here is a relation between two runs of the
same inputs, so the inputs are regenerated by a seeded LCG in Mojo (scale
about 0.02, ids in [0, vocab)).

Units:
  0-2  `train_steps` of 1, 2, 4 batches equals that many single steps: the
       loss words, the completed count and the exported state bytes
  3    on an open session, a 3-step call after one step equals 3 single
       steps, and the last gradient export is the same bytes
  4    `evaluate` after a step leaves every exported state byte and the
       step count unchanged, with a finite loss
  5    logits and next bytes of a [3, 32] batch change no exported state
       byte, leave the step at 1 and do not write the caller's ids
  6    a full step's flat gradient is a lean step's gradient export, with
       the same loss word
"""
from std.memory import bitcast
from core.entry_table import EntryRef
from core.state_registry import StateHandle
from core.byte_lm_entry_table import ByteLmEntryKey, byte_lm_vendor_word
from core.byte_lm_entry_table_sessions import (
    byte_lm_sessions_ref,
    byte_lm_resident_open,
    byte_lm_resident_run,
    byte_lm_resident_close,
)
from training.byte_lm_config import ByteConfig
from checks.numerics import GLOBAL_NUMERIC_MODE, NUMERIC_IDENTICAL
from core.host_parallel import host_parallelize
from training.byte_lm_host_glue_entry import publish_byte_lm_host_entries
from checks.vendor import COMPILED_VENDOR
from training.byte_lm_glue_entry import publish_byte_lm_entries
from checks.native_tests.runner import CPU_COLUMN_BUILD, Check, Column, Report, require


comptime BYTE_LM_TRAINER_SESSION_CASES = 7
comptime OP_STEP = 1
comptime OP_LOGITS = 2
comptime OP_EXPORT_STATE = 3
comptime OP_STATUS = 5
comptime OP_NEXT = 6
comptime OP_EXPORT_GRADIENTS = 10
comptime OPT_KIND_ADAMW = 2


def shape() -> ByteConfig:
    """`LanguageModelConfig()`: the Python default shape."""
    return ByteConfig(chunked_lm_head_v2=False)


def lcg_next(mut state: UInt64) -> UInt64:
    state = state * 6364136223846793005 + 1442695040888963407
    return state


def weights(n: Int, seed: Int) -> List[Float32]:
    """Seeded parameters, uniform on about +-0.04 (standard deviation about
    0.023, the Python fixtures' `standard_normal * 0.02` scale)."""
    var state = UInt64(seed) * 2654435761 + 97
    var out = List[Float32](capacity=n)
    for _ in range(n):  # driver-loop: over the fixture's parameter cells
        var u = Int((lcg_next(state) >> 40) & 0xFFFF)
        out.append(Float32(u - 32768) / Float32(819200))
    return out^


def batches(cfg: ByteConfig, n_steps: Int, seed: Int) -> List[Int32]:
    """`n_steps` seeded training batches `[n_steps, batch, length + 1]`."""
    var state = UInt64(seed) * 40503 + 11
    var count = n_steps * cfg.batch * (cfg.length + 1)
    var out = List[Int32](capacity=count)
    for _ in range(count):  # driver-loop: over the fixture's token cells
        out.append(Int32(Int(lcg_next(state) >> 33) % cfg.vocab_size))
    return out^


def arange_ids(batch: Int, length: Int) -> List[Int32]:
    """`np.arange(batch * length) % 256` as `[batch, length]`."""
    var out = List[Int32](capacity=batch * length)
    for i in range(batch * length):  # driver-loop: over the fixture's token cells
        out.append(Int32(i % 256))
    return out^


def slice_ids(ids: List[Int32], first: Int, count: Int) -> List[Int32]:
    var out = List[Int32](capacity=count)
    for i in range(count):  # driver-loop: over one batch's token cells
        out.append(ids[first + i])
    return out^


def same_f32(a: List[Float32], b: List[Float32], label: String) raises:
    require(len(a) == len(b), label + ": lengths differ")
    for i in range(len(a)):  # driver-loop: over one fixture's compared cells
        if bitcast[DType.uint32](a[i]) != bitcast[DType.uint32](b[i]):
            raise Error(label + ": bits differ at " + String(i))


def same_i32(a: List[Int32], b: List[Int32], label: String) raises:
    require(len(a) == len(b), label + ": lengths differ")
    for i in range(len(a)):  # driver-loop: over one fixture's compared cells
        if a[i] != b[i]:
            raise Error(label + ": words differ at " + String(i))


def finite(value: Float32) -> Bool:
    return (bitcast[DType.uint32](value) & UInt32(0x7F800000)) != UInt32(0x7F800000)


@fieldwise_init
struct StepResult(Movable):
    var losses: List[Float32]
    var gradient: List[Float32]


@fieldwise_init
struct ExportedState(Movable):
    var p: List[Float32]
    var m: List[Float32]
    var v: List[Float32]
    var flags: List[Int32]


def same_state(a: ExportedState, b: ExportedState, label: String) raises:
    same_f32(a.p, b.p, label + " parameters")
    same_f32(a.m, b.m, label + " first moment")
    same_f32(a.v, b.v, label + " second moment")
    same_i32(a.flags, b.flags, label + " flags")


struct Resident(Movable):
    """One resident trainer session and the state the door keeps beside it:
    the admitted arrays until the session opens, the committed flags and the
    completed step count."""
    var entry: EntryRef
    var handle: StateHandle
    var words: List[Int]
    var cfg: ByteConfig
    var p: List[Float32]
    var m: List[Float32]
    var v: List[Float32]
    var flags: List[Int32]
    var completed: Int
    var opened: Bool

    def __init__(out self, key: ByteLmEntryKey, cfg: ByteConfig, var p: List[Float32]) raises:
        var n = cfg.n_total()
        require(len(p) == n, "fixture parameters are not the registry size")
        var entry = byte_lm_sessions_ref(key)
        var handle = byte_lm_resident_open(entry)
        self.entry = entry
        self.handle = handle^
        self.words = List[Int]()
        self.cfg = cfg.copy()
        self.p = p^
        self.m = List[Float32](length=n, fill=Float32(0))
        self.v = List[Float32](length=n, fill=Float32(0))
        self.flags = List[Int32](length=cfg.n_tensors(), fill=Int32(0))
        self.completed = 0
        self.opened = False

    def close(mut self) raises:
        byte_lm_resident_close(self.entry, self.handle)

    def plan(self, train: Bool, batch: Int, length: Int) -> List[Int]:
        """The seventeen trainer words of `_native_plan`."""
        return [self.cfg.batch, self.cfg.length, self.cfg.d_model, self.cfg.n_heads, self.cfg.n_kv,
                self.cfg.head_dim, self.cfg.intermediate, self.cfg.n_layers, self.cfg.vocab_size,
                Int(self.cfg.chunked_lm_head_v2), Int(train), self.completed, OPT_KIND_ADAMW, 0,
                batch, length, 0]

    def run(mut self, operation: Int, addresses: List[Int], ints: List[Int]) raises -> Int:
        var floats: List[Float64] = [1e-3, 0.9, 0.999, 1e-8, 0.01, 0.0, 0.0, 0.0]
        var entry = self.entry
        var handle = self.handle.copy()
        return byte_lm_resident_run(entry, handle, operation, addresses, ints, floats, self.words)

    def admission(self) -> List[Int]:
        """The three admission addresses: the arrays until the session is
        open, null words after (the door's rule)."""
        if self.opened:
            return [0, 0, 0]
        return [Int(self.p.unsafe_ptr()), Int(self.m.unsafe_ptr()), Int(self.v.unsafe_ptr())]

    def step(mut self, ids: List[Int32], n_steps: Int, full: Bool) raises -> StepResult:
        var n = self.cfg.n_total()
        var losses = List[Float32](length=n_steps, fill=Float32(-1))
        var out_flags = List[Int32](length=self.cfg.n_tensors(), fill=Int32(-1))
        var gradient = List[Float32](length=n if full else 1, fill=Float32(0))
        var named = List[List[Float32]]()
        var a: List[Int] = [Int(ids.unsafe_ptr()), Int(self.flags.unsafe_ptr())]
        a.extend(self.admission())
        a.append(Int(losses.unsafe_ptr()))
        a.append(Int(out_flags.unsafe_ptr()))
        a.append(Int(gradient.unsafe_ptr()) if full else 0)
        if full:
            for j in range(self.cfg.n_tensors()):  # driver-loop: one named output per parameter tensor
                named.append(List[Float32](length=self.cfg.param_count(j), fill=Float32(0)))
            for j in range(len(named)):  # driver-loop: one address per parameter tensor
                a.append(Int(named[j].unsafe_ptr()))
        var result = self.run(OP_STEP, a, self.plan(True, n_steps, 0))
        _ = ids  # read through its address by the synchronous call above
        _ = named
        require(result == self.completed + n_steps, "a training call returned step " + String(result))
        self.completed += n_steps
        self.opened = True
        self.flags = out_flags^
        if not full:
            gradient = List[Float32]()
        return StepResult(losses^, gradient^)

    def evaluate(mut self, ids: List[Int32]) raises -> Float32:
        var loss = List[Float32](length=1, fill=Float32(-1))
        var a: List[Int] = [Int(ids.unsafe_ptr()), Int(self.flags.unsafe_ptr())]
        a.extend(self.admission())
        a.append(Int(loss.unsafe_ptr()))
        a.append(0)
        a.append(0)
        var result = self.run(OP_STEP, a, self.plan(False, 0, 0))
        _ = ids
        require(result == self.completed, "an evaluation returned step " + String(result))
        self.opened = True
        return loss[0]

    def export_state(mut self) raises -> ExportedState:
        var n = self.cfg.n_total()
        var state = ExportedState(List[Float32](length=n, fill=Float32(-1)), List[Float32](length=n, fill=Float32(-1)),
                                  List[Float32](length=n, fill=Float32(-1)),
                                  List[Int32](length=self.cfg.n_tensors(), fill=Int32(-1)))
        var a: List[Int] = [Int(self.flags.unsafe_ptr()), Int(state.p.unsafe_ptr()), Int(state.m.unsafe_ptr()),
                            Int(state.v.unsafe_ptr()), Int(state.flags.unsafe_ptr())]
        var result = self.run(OP_EXPORT_STATE, a, self.plan(False, 0, 0))
        require(result == self.completed, "a state export returned step " + String(result))
        return state^

    def export_gradients(mut self) raises -> List[Float32]:
        var flat = List[Float32](length=self.cfg.n_total(), fill=Float32(-1))
        var a: List[Int] = [Int(flat.unsafe_ptr())]
        var result = self.run(OP_EXPORT_GRADIENTS, a, self.plan(False, 0, 0))
        require(result == self.completed, "a gradient export returned step " + String(result))
        return flat^

    def status_completed(mut self) raises -> Int:
        var info = List[Int](length=4, fill=7)
        var a: List[Int] = [Int(info.unsafe_ptr())]
        require(self.run(OP_STATUS, a, List[Int]()) == 4, "session status count")
        return info[0]

    def logits(mut self, ids: List[Int32], batch: Int, length: Int) raises -> List[Float32]:
        var count = batch * length * self.cfg.vocab_size
        var out = List[Float32](length=count, fill=Float32(0))
        var a: List[Int] = [Int(ids.unsafe_ptr()), Int(out.unsafe_ptr()), Int(self.flags.unsafe_ptr())]
        a.extend(self.admission())
        var written = self.run(OP_LOGITS, a, self.plan(False, batch, length))
        _ = ids
        require(written == count, "logits wrote " + String(written) + " cells")
        return out^

    def next_bytes(mut self, ids: List[Int32], batch: Int, length: Int) raises -> List[Int32]:
        var out = List[Int32](length=batch, fill=Int32(-1))
        var a: List[Int] = [Int(ids.unsafe_ptr()), Int(out.unsafe_ptr()), Int(self.flags.unsafe_ptr())]
        a.extend(self.admission())
        var written = self.run(OP_NEXT, a, self.plan(False, batch, length))
        _ = ids
        require(written == batch, "next bytes wrote " + String(written) + " rows")
        return out^


def steps_equal_single_steps(key: ByteLmEntryKey, n_steps: Int) raises:
    """test_train_steps_equals_single_steps[n_steps]."""
    var cfg = shape()
    var n = cfg.n_total()
    var width = cfg.batch * (cfg.length + 1)
    var many = Resident(key, cfg, weights(n, 0))
    var single = Resident(key, cfg, weights(n, 0))
    try:
        var ids = batches(cfg, n_steps, 1)
        var result = many.step(ids, n_steps, False)
        var losses = List[Float32]()
        for k in range(n_steps):  # driver-loop: over the fixture's training steps (each depends on the last)
            losses.append(single.step(slice_ids(ids, k * width, width), 1, False).losses[0])
        same_f32(result.losses, losses, "train_steps losses")
        require(many.status_completed() == n_steps and single.status_completed() == n_steps,
                "a session's completed count is not the step count")
        same_state(many.export_state(), single.export_state(), "train_steps against single steps")
    finally:
        many.close()
        single.close()


def steps_on_an_open_session(key: ByteLmEntryKey) raises:
    """test_train_steps_on_an_open_session_runs_the_multi_step_operation."""
    var cfg = shape()
    var n = cfg.n_total()
    var width = cfg.batch * (cfg.length + 1)
    var many = Resident(key, cfg, weights(n, 0))
    var single = Resident(key, cfg, weights(n, 0))
    try:
        var first = batches(cfg, 1, 2)
        var rest = batches(cfg, 3, 3)
        _ = many.step(first, 1, False)
        _ = single.step(first, 1, False)
        var result = many.step(rest, 3, False)
        var losses = List[Float32]()
        for k in range(3):  # driver-loop: over the fixture's training steps (each depends on the last)
            losses.append(single.step(slice_ids(rest, k * width, width), 1, False).losses[0])
        same_f32(result.losses, losses, "open-session train_steps losses")
        require(many.status_completed() == 4, "the open session did not reach step 4")
        same_state(many.export_state(), single.export_state(), "open-session train_steps against single steps")
        same_f32(many.export_gradients(), single.export_gradients(), "the last step's gradient export")
    finally:
        many.close()
        single.close()


def evaluate_preserves_state(key: ByteLmEntryKey) raises:
    """test_evaluate_preserves_all_state_and_has_no_gradient_output."""
    var cfg = shape()
    var model = Resident(key, cfg, weights(cfg.n_total(), 23))
    try:
        var ids = arange_ids(cfg.batch, cfg.length + 1)
        _ = model.step(ids, 1, False)
        var before = model.export_state()
        require(finite(model.evaluate(ids)), "the evaluation loss is not finite")
        same_state(model.export_state(), before, "evaluate")
        require(model.status_completed() == 1, "evaluate moved the step count")
    finally:
        model.close()


def logits_change_no_state(key: ByteLmEntryKey) raises:
    """test_logits_change_no_state_and_do_not_advance_the_step (resident)."""
    var cfg = shape()
    var model = Resident(key, cfg, weights(cfg.n_total(), 17))
    try:
        _ = model.step(arange_ids(cfg.batch, cfg.length + 1), 1, False)
        var before = model.export_state()
        var x = arange_ids(3, 32)
        var x_before = x.copy()
        _ = model.logits(x, 3, 32)
        _ = model.next_bytes(x, 3, 32)
        same_state(model.export_state(), before, "logits and next bytes")
        require(model.status_completed() == 1, "logits moved the step count")
        same_i32(x, x_before, "the caller's ids")
    finally:
        model.close()


def full_is_lean_plus_export(key: ByteLmEntryKey) raises:
    """test_full_result_on_a_resident_session_is_the_lean_step_plus_the_gradient_export."""
    var cfg = shape()
    var full = Resident(key, cfg, weights(cfg.n_total(), 29))
    var lean = Resident(key, cfg, weights(cfg.n_total(), 29))
    try:
        var ids = arange_ids(cfg.batch, cfg.length + 1)
        var full_result = full.step(ids, 1, True)
        var lean_result = lean.step(ids, 1, False)
        same_f32(full_result.losses, lean_result.losses, "full and lean loss")
        same_f32(full_result.gradient, lean.export_gradients(), "full flat gradient against the lean export")
    finally:
        full.close()
        lean.close()


def case(key: ByteLmEntryKey, unit: Int) raises:
    if unit < 3:
        var counts: List[Int] = [1, 2, 4]
        steps_equal_single_steps(key, counts[unit])
    elif unit == 3:
        steps_on_an_open_session(key)
    elif unit == 4:
        evaluate_preserves_state(key)
    elif unit == 5:
        logits_change_no_state(key)
    elif unit == 6:
        full_is_lean_plus_export(key)
    else:
        raise Error("unknown byte LM trainer session case")


# ---- The host column (was byte_lm_trainer_session_cpu_suite.mojo) ----
# The byte LM trainer session units on the host column (vendor word 0),
# each on its own sessions, run across host cores.
def _run_cpu(mut report: Report) raises:
    comptime assert GLOBAL_NUMERIC_MODE == NUMERIC_IDENTICAL
    # The publication `_mojolearn_byte_lm_host` makes at module init.
    publish_byte_lm_host_entries()
    var cases = report.cases(BYTE_LM_TRAINER_SESSION_CASES)
    def task(unit: Int) {imm cases}:
        try:
            case(ByteLmEntryKey(Int(GLOBAL_NUMERIC_MODE), 0), unit)
        except error:
            cases.fail(unit, error)
    report.parallel(task, BYTE_LM_TRAINER_SESSION_CASES)


# ---- The device column (was byte_lm_trainer_session_gpu_suite.mojo) ----
# The byte LM trainer session units on the image's GPU column.
#
# The units run in order: every resident session of the image shares the one
# device the trainer binds, and each unit's training steps keep their kernels'
# own parallelism on it.
def _run_gpu(mut report: Report) raises:
    comptime assert GLOBAL_NUMERIC_MODE == NUMERIC_IDENTICAL
    var vendor = byte_lm_vendor_word(COMPILED_VENDOR)
    require(vendor > 0, "byte_lm_trainer_session_gpu needs a GPU build (cuda, hip or metal)")
    # The publication `_mojolearn_byte_lm` makes at module init.
    publish_byte_lm_entries()
    var cases = report.cases(BYTE_LM_TRAINER_SESSION_CASES)
    for unit in range(BYTE_LM_TRAINER_SESSION_CASES):
        try:
            case(ByteLmEntryKey(Int(GLOBAL_NUMERIC_MODE), vendor), unit)
        except error:
            cases.fail(unit, error)


def run_cases(column: Column, mut report: Report):
    try:
        comptime if CPU_COLUMN_BUILD:
            _run_cpu(report)
        else:
            _run_gpu(report)
    except error:
        report.abort(error)


def register() -> Check:
    return Check("byte_lm_trainer_session", cpu=True, gpu=True, serial="", run=run_cases)
