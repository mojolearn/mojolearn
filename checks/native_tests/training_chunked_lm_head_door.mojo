# SPDX-License-Identifier: Apache-2.0
"""The chunked LM head v2 host stages against a Float64 reference (ported from
`python/mojolearn/tests/test_chunked_lm_head_door.py`, lane tmig-training,
2026-11-14).

The training host binding exports `chunked_lm_head_v2_loss` as
`chunked_lm_head_v2_oracle_forward` and `chunked_lm_head_v2_train` as
`chunked_lm_head_v2_oracle` (bindings/_mojolearn_training_host.mojo); this
check calls those two Mojo functions directly. On a vocabulary that crosses
the 256 chunk and ends in a one-token tail: the loss agrees with a Float64
softmax cross-entropy within rtol 2e-5; the loss-only stage gives the train
stage's loss word; dHidden and dWeight agree with the Float64 gradients
within rtol 1e-4, atol 1e-6; two calls give the same words. Tolerances are
the Python test's. Inputs are regenerated by the counter-based generator
(the Python test drew uniform(-1, 1) and uniform(-0.5, 0.5) from NumPy; the
assertions are relations to the reference, so no NumPy stream is needed).

The independent fixtures and the reference's rows and vocabulary ids run
across host cores. The Python source-text checks of the binding registration
stay in the Python file.
"""
from std.math import exp, log
from core.host_parallel import host_parallelize
from training.checks.chunked_lm_head_oracle import chunked_lm_head_v2_oracle, chunked_lm_head_v2_oracle_forward
from checks.native_tests.training_check_common import close64, all_close, same_words, uniform
from checks.native_tests.runner import CPU_COLUMN_BUILD, Check, Column, Report, require


# ---- The host column (was training_chunked_lm_head_door_suite.mojo) ----
comptime CLH_ROWS = 5
comptime CLH_VOCAB = 513
comptime CLH_WIDTH = 8
comptime CLH_FIXTURES = 2


def _hidden() -> List[Float32]:
    var values = List[Float32](length=CLH_ROWS * CLH_WIDTH, fill=0)
    for i in range(len(values)):  # small-loop(fixture fill): 40 values
        values[i] = uniform(23, i, -1.0, 1.0)
    return values^


def _weight() -> List[Float32]:
    var values = List[Float32](length=CLH_VOCAB * CLH_WIDTH, fill=0)
    var vp = values.unsafe_ptr()
    def fill(v: Int) {imm vp}:
        for f in range(CLH_WIDTH):
            vp.unsafe_store(v * CLH_WIDTH + f, uniform(24, v * CLH_WIDTH + f, -0.5, 0.5))
    host_parallelize(fill, CLH_VOCAB)
    return values^


def _targets() -> List[Int32]:
    # one target in each chunk and one on the one-token tail
    var targets: List[Int32] = [0, 255, 256, 511, 512]
    return targets^


struct _Reference(Movable):
    var loss: Float64
    var d_hidden: List[Float64]
    var d_weight: List[Float64]

    def __init__(out self):
        self.loss = 0
        self.d_hidden = List[Float64](length=CLH_ROWS * CLH_WIDTH, fill=0)
        self.d_weight = List[Float64](length=CLH_VOCAB * CLH_WIDTH, fill=0)


def _reference(hidden: List[Float32], weight: List[Float32], targets: List[Int32]) -> _Reference:
    """Float64 softmax cross-entropy, mean over rows, and its two gradients."""
    var result = _Reference()
    var dlogit = List[Float64](length=CLH_ROWS * CLH_VOCAB, fill=0)
    var row_loss = List[Float64](length=CLH_ROWS, fill=0)
    var hp = hidden.unsafe_ptr()
    var wp = weight.unsafe_ptr()
    var tp = targets.unsafe_ptr()
    var dp = dlogit.unsafe_ptr()
    var lp = row_loss.unsafe_ptr()
    def row(r: Int) {imm hp, imm wp, imm tp, imm dp, imm lp}:
        var top = Float64(-1e300)
        for v in range(CLH_VOCAB):
            var z = Float64(0)
            for f in range(CLH_WIDTH):
                z += Float64(hp.unsafe_load(r * CLH_WIDTH + f)) * Float64(wp.unsafe_load(v * CLH_WIDTH + f))
            dp.unsafe_store(r * CLH_VOCAB + v, z)
            top = max(top, z)
        var total = Float64(0)
        for v in range(CLH_VOCAB):
            var e = exp(dp.unsafe_load(r * CLH_VOCAB + v) - top)
            dp.unsafe_store(r * CLH_VOCAB + v, e)
            total += e
        var t = Int(tp.unsafe_load(r))
        for v in range(CLH_VOCAB):
            var p = dp.unsafe_load(r * CLH_VOCAB + v) / total
            if v == t:
                lp.unsafe_store(r, -log(p))
                p -= 1.0
            dp.unsafe_store(r * CLH_VOCAB + v, p / Float64(CLH_ROWS))
    host_parallelize(row, CLH_ROWS)
    var loss = Float64(0)
    for r in range(CLH_ROWS):  # small-loop(mean): five row losses
        loss += row_loss[r]
    result.loss = loss / Float64(CLH_ROWS)
    var hgp = result.d_hidden.unsafe_ptr()
    var wgp = result.d_weight.unsafe_ptr()
    def d_hidden_row(r: Int) {imm wp, imm dp, imm hgp}:
        for f in range(CLH_WIDTH):
            var acc = Float64(0)
            for v in range(CLH_VOCAB):
                acc += dp.unsafe_load(r * CLH_VOCAB + v) * Float64(wp.unsafe_load(v * CLH_WIDTH + f))
            hgp.unsafe_store(r * CLH_WIDTH + f, acc)
    host_parallelize(d_hidden_row, CLH_ROWS)
    def d_weight_row(v: Int) {imm hp, imm dp, imm wgp}:
        for f in range(CLH_WIDTH):
            var acc = Float64(0)
            for r in range(CLH_ROWS):
                acc += dp.unsafe_load(r * CLH_VOCAB + v) * Float64(hp.unsafe_load(r * CLH_WIDTH + f))
            wgp.unsafe_store(v * CLH_WIDTH + f, acc)
    host_parallelize(d_weight_row, CLH_VOCAB)
    _ = hidden
    _ = weight
    _ = targets
    _ = dlogit^
    _ = row_loss^
    return result^


def _against_reference() raises:
    var hidden = _hidden()
    var weight = _weight()
    var targets = _targets()
    var loss_only = chunked_lm_head_v2_oracle_forward(hidden, weight, targets, CLH_ROWS, CLH_VOCAB, CLH_WIDTH)
    var full = chunked_lm_head_v2_oracle(hidden, weight, targets, CLH_ROWS, CLH_VOCAB, CLH_WIDTH)
    var want = _reference(hidden, weight, targets)
    require(close64(Float64(loss_only.loss), want.loss, 2e-5, 0.0),
            "loss " + String(loss_only.loss) + " is not the Float64 reference " + String(want.loss))
    require(loss_only.loss.to_bits() == full.loss.to_bits(), "the loss stage and the train stage disagree on the loss")
    require(len(full.d_hidden) == CLH_ROWS * CLH_WIDTH and len(full.d_weight) == CLH_VOCAB * CLH_WIDTH,
            "gradient shapes are not hidden's and weight's")
    require(all_close(full.d_hidden, want.d_hidden, 1e-4, 1e-6), "dHidden is not the Float64 reference")
    require(all_close(full.d_weight, want.d_weight, 1e-4, 1e-6), "dWeight is not the Float64 reference")


def _two_calls() raises:
    var hidden = _hidden()
    var weight = _weight()
    var targets = _targets()
    var a = chunked_lm_head_v2_oracle(hidden, weight, targets, CLH_ROWS, CLH_VOCAB, CLH_WIDTH)
    var b = chunked_lm_head_v2_oracle(hidden, weight, targets, CLH_ROWS, CLH_VOCAB, CLH_WIDTH)
    require(a.loss.to_bits() == b.loss.to_bits(), "two calls: the loss moved")
    require(same_words(a.d_hidden, b.d_hidden), "two calls: dHidden moved")
    require(same_words(a.d_weight, b.d_weight), "two calls: dWeight moved")


def _run_cpu(mut report: Report) raises:
    var cases = report.cases(CLH_FIXTURES)
    def task(unit: Int) {imm cases}:
        try:
            if unit == 0:
                _against_reference()
            else:
                _two_calls()
        except error:
            cases.fail(unit, error)
    report.parallel(task, CLH_FIXTURES)


def run_cases(column: Column, mut report: Report):
    try:
        comptime if CPU_COLUMN_BUILD:
            _run_cpu(report)
    except error:
        report.abort(error)


def register() -> Check:
    return Check("training_chunked_lm_head_door", cpu=True, gpu=False, serial="", run=run_cases)
