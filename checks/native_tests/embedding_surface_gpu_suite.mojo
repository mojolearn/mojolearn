# SPDX-License-Identifier: Apache-2.0
"""The FOLD, PAD/CARRY and PLAN arms of `test_embedding_surface.py` on the
typed embedding run the `_mojolearn_embedding` door calls
(`embedding/embedding_words_run.mojo`: `embedding_forward_released`,
`embedding_backward_released`), lane tmig-lm-1, 2026-11-14.

V 37, d 5, T 211 as in the Python gate. The reference is the gate's own:
`dW` seeded +0.0, then `dW[ids[t]] += dY[t]` in ascending t, padding
positions dropped and row `padding_idx` stored +0.0; the forward is
`W[ids]`. The Python gate drew W, ids and dY from NumPy's PCG64; every
assertion is a relation between those inputs and the reference, so the
inputs are regenerated by a seeded LCG here (W and dY uniform on [-1, 1),
ids uniform on [0, V)).

The arms run in order on the one device context the embedding run shares
(`core/neural_context.mojo`); the kernels keep their own parallelism. The
wiring arms (negative padding_idx, `grad=` copied, the plan name admission,
refusals, provenance) stay in the Python gate.
"""
from std.memory import bitcast
from checks.numerics import GLOBAL_NUMERIC_MODE, NUMERIC_IDENTICAL
from embedding.checks.embedding_oracle import EmbConfig, EMB_NO_PADDING_IDX
from embedding.checks.embedding_identical import PLAN_AUTO, emb_resolve_plan
from autograd.kernels.embedding_sort import PLAN_SCAN, PLAN_SORT
from embedding.embedding_words_run import embedding_forward_released, embedding_backward_released

comptime V = 37
comptime D = 5
comptime T = 211


def require(ok: Bool, message: String) raises:
    if not ok:
        raise Error(message)


def lcg_next(mut state: UInt64) -> UInt64:
    state = state * 6364136223846793005 + 1442695040888963407
    return state


@fieldwise_init
struct EmbData(Movable):
    var w: List[Float32]
    var ids: List[Int32]
    var dy: List[Float32]


def data(seed: Int) -> EmbData:
    var state = UInt64(seed) * 2654435761 + 13
    var w = List[Float32](capacity=V * D)
    for _ in range(V * D):  # driver-loop: over the fixture's weight cells
        w.append(Float32(Int((lcg_next(state) >> 40) & 0xFFFFFF)) / Float32(8388608) - Float32(1))
    var ids = List[Int32](capacity=T)
    for _ in range(T):  # driver-loop: over the fixture's positions
        ids.append(Int32(Int(lcg_next(state) >> 33) % V))
    var dy = List[Float32](capacity=T * D)
    for _ in range(T * D):  # driver-loop: over the fixture's gradient cells
        dy.append(Float32(Int((lcg_next(state) >> 40) & 0xFFFFFF)) / Float32(8388608) - Float32(1))
    return EmbData(w^, ids^, dy^)


def fptr(values: List[Float32]) -> MutPointer[Float32, MutUntrackedOrigin]:
    return MutPointer[Float32, MutUntrackedOrigin](unsafe_from_address=Int(values.unsafe_ptr()))


def iptr(values: List[Int32]) -> MutPointer[Int32, MutUntrackedOrigin]:
    return MutPointer[Int32, MutUntrackedOrigin](unsafe_from_address=Int(values.unsafe_ptr()))


def forward(w: List[Float32], ids: List[Int32]) raises -> List[Float32]:
    var y = List[Float32](length=len(ids) * D, fill=Float32(7))
    embedding_forward_released(fptr(w), iptr(ids), len(ids), EmbConfig(V, D, EMB_NO_PADDING_IDX, False),
                               Int(y.unsafe_ptr()), False, 0, Int(w.unsafe_ptr()))
    _ = w  # read through its address by the synchronous call above
    _ = ids
    return y^


def backward(ids: List[Int32], dy: List[Float32], pad: Int, plan: Int) raises -> List[Float32]:
    """A fresh `dW` (+0.0 seed). `plan` is the door's code; PLAN_AUTO is
    resolved per call as the door resolves it."""
    var dw = List[Float32](length=V * D, fill=Float32(7))
    embedding_backward_released(fptr(dy), iptr(ids), len(ids), EmbConfig(V, D, pad, False), Int(dw.unsafe_ptr()),
                                False, emb_resolve_plan(plan, V, len(ids)))
    _ = ids
    _ = dy
    return dw^


def carried(ids: List[Int32], dy: List[Float32], pad: Int, plan: Int, grad: List[Float32]) raises -> List[Float32]:
    """`backward(..., grad=grad)`: the door copies `grad` and folds into it."""
    var dw = grad.copy()
    embedding_backward_released(fptr(dy), iptr(ids), len(ids), EmbConfig(V, D, pad, True), Int(dw.unsafe_ptr()),
                                False, emb_resolve_plan(plan, V, len(ids)))
    _ = ids
    _ = dy
    return dw^


def fold(ids: List[Int32], dy: List[Float32], pad: Int) -> List[Float32]:
    """The gate's reference: +0.0 seed, ascending t, padding dropped and its
    row stored +0.0."""
    var dw = List[Float32](length=V * D, fill=Float32(0))
    for t in range(len(ids)):  # driver-loop: over positions, in the contract's ascending order
        var row = Int(ids[t])
        if pad != EMB_NO_PADDING_IDX and row == pad:
            continue
        for j in range(D):  # driver-loop: over one row's width
            dw[row * D + j] += dy[t * D + j]
    if pad != EMB_NO_PADDING_IDX:
        for j in range(D):  # driver-loop: over one row's width
            dw[pad * D + j] = Float32(0)
    return dw^


def gather(w: List[Float32], ids: List[Int32]) -> List[Float32]:
    var y = List[Float32](capacity=len(ids) * D)
    for t in range(len(ids)):  # driver-loop: over the fixture's positions
        for j in range(D):  # driver-loop: over one row's width
            y.append(w[Int(ids[t]) * D + j])
    return y^


def head_ids(ids: List[Int32], count: Int) -> List[Int32]:
    var out = List[Int32](capacity=count)
    for t in range(count):  # driver-loop: over a prefix of positions
        out.append(ids[t])
    return out^


def tail_ids(ids: List[Int32], first: Int) -> List[Int32]:
    var out = List[Int32](capacity=len(ids) - first)
    for t in range(first, len(ids)):  # driver-loop: over a suffix of positions
        out.append(ids[t])
    return out^


def rows(dy: List[Float32], first: Int, last: Int) -> List[Float32]:
    var out = List[Float32](capacity=(last - first) * D)
    for i in range(first * D, last * D):  # driver-loop: over a slice of gradient cells
        out.append(dy[i])
    return out^


def same(a: List[Float32], b: List[Float32], label: String) raises:
    require(len(a) == len(b), label + ": lengths differ")
    for i in range(len(a)):  # driver-loop: over one arm's compared cells
        if bitcast[DType.uint32](a[i]) != bitcast[DType.uint32](b[i]):
            raise Error(label + ": bits differ at " + String(i))


def row_is_positive_zero(dw: List[Float32], row: Int) -> Bool:
    for j in range(D):  # driver-loop: over one row's width
        if bitcast[DType.uint32](dw[row * D + j]) != 0:
            return False
    return True


def arm_fold() raises:
    var d = data(0)
    same(forward(d.w, d.ids), gather(d.w, d.ids), "FOLD forward is W[ids]")
    var dw = backward(d.ids, d.dy, EMB_NO_PADDING_IDX, PLAN_AUTO)
    same(dw, fold(d.ids, d.dy, EMB_NO_PADDING_IDX), "FOLD backward against the ascending fold")
    var seen = List[Bool](length=V, fill=False)
    for t in range(T):  # driver-loop: over the fixture's positions
        seen[Int(d.ids[t])] = True
    for row in range(V):  # driver-loop: over the vocabulary rows
        if not seen[row]:
            require(row_is_positive_zero(dw, row), "FOLD row " + String(row) + " has no id and is not +0.0")
    same(backward(d.ids, d.dy, EMB_NO_PADDING_IDX, PLAN_AUTO), dw, "FOLD two calls")


def arm_padding_and_carry() raises:
    var d = data(1)
    var pad = Int(d.ids[3])
    var dw = backward(d.ids, d.dy, pad, PLAN_AUTO)
    require(row_is_positive_zero(dw, pad), "PAD row padding_idx is not +0.0")
    same(dw, fold(d.ids, d.dy, pad), "PAD backward against the fold with the pad positions dropped")
    same(forward(d.w, d.ids), gather(d.w, d.ids), "PAD forward gathers the padding row")
    var splits: List[Int] = [1, 70, 150, T - 1]
    for k in range(len(splits)):  # driver-loop: over the arm's split points
        var t0 = splits[k]
        var g1 = backward(head_ids(d.ids, t0), rows(d.dy, 0, t0), pad, PLAN_AUTO)
        var g2 = carried(tail_ids(d.ids, t0), rows(d.dy, t0, T), pad, PLAN_AUTO, g1)
        same(g2, dw, "CARRY split at t0=" + String(t0))


def arm_plan_sort() raises:
    var d = data(2)
    var dw_scan = backward(d.ids, d.dy, EMB_NO_PADDING_IDX, PLAN_SCAN)
    var dw_sort = backward(d.ids, d.dy, EMB_NO_PADDING_IDX, PLAN_SORT)
    same(dw_sort, dw_scan, "PLAN sort against scan")
    same(dw_sort, fold(d.ids, d.dy, EMB_NO_PADDING_IDX), "PLAN sort against the ascending fold")
    var pad = Int(d.ids[7])
    var p_scan = backward(d.ids, d.dy, pad, PLAN_AUTO)
    var p_sort = backward(d.ids, d.dy, pad, PLAN_SORT)
    same(p_sort, p_scan, "PLAN padded sort against padded scan")
    require(row_is_positive_zero(p_sort, pad), "PLAN sort row padding_idx is not +0.0")
    var g1 = backward(head_ids(d.ids, 97), rows(d.dy, 0, 97), EMB_NO_PADDING_IDX, PLAN_SORT)
    same(carried(tail_ids(d.ids, 97), rows(d.dy, 97, T), EMB_NO_PADDING_IDX, PLAN_SORT, g1), dw_scan,
         "PLAN sort carried split at t0=97 against the unsplit scan")
    var hot = List[Int32](length=T, fill=Int32(5))
    same(backward(hot, d.dy, EMB_NO_PADDING_IDX, PLAN_SORT), backward(hot, d.dy, EMB_NO_PADDING_IDX, PLAN_SCAN),
         "PLAN one id at every position (R = T = 211)")
    same(forward(d.w, d.ids), gather(d.w, d.ids), "PLAN forward")


def run_checks() raises:
    comptime assert GLOBAL_NUMERIC_MODE == NUMERIC_IDENTICAL
    var failed = 0
    for arm in range(3):
        try:
            if arm == 0:
                arm_fold()
            elif arm == 1:
                arm_padding_and_carry()
            else:
                arm_plan_sort()
        except error:
            failed += 1
            print("FAIL embedding_surface_gpu arm", arm, String(error))
    require(failed == 0, "embedding_surface_gpu failed " + String(failed) + " arms")
    print("PASS embedding_surface_gpu: FOLD, PAD/CARRY and PLAN arms, in order on the device")
