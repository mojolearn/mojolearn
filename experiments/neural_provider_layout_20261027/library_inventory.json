    {
      "order": 4,
      "scope": "Linear/SVM/clustering/decomposition family boundaries",
      "owners": [
        "glm",
        "svm",
        "cluster",
        "decomposition",
        "x_linear",
        "x_cluster",
        "x_decomp"
