    "static_findings": [
      {
        "id": "controls",
        "status": "SOURCE_REACH_ESTABLISHED_RUNTIME_REACH_NOT_NEWLY_VERIFIED",
        "implementation_ids": [
          "I.C.C13",
          "I.C.C18"
        ],
        "details": "Both A configurations contain MOJOLEARN_CLASSICAL_C13_FOLD_STATS=1 and MOJOLEARN_CLASSICAL_C18_RESIDUAL_NEXT=1. B omits candidate defines and retains incumbent behavior, including existing staged statistics/scoring where supported. Public LassoCV/ElasticNetCV call ALGO_ENETCV, the x_linear binding and enetcv_fit_grid on both GPUs; not the ordinary solver/impl/cd.mojo or Apple FAST route."
      },
      {
        "id": "C13_numerical_profile",
        "status": "STRONGEST_SOURCE_EXPLANATION_NOT_ISOLATED_CAUSE_PROOF",
        "details": "C13 computes each disjoint fold mean and centered augmented Gram in Float32, then combines retained folds in ascending fold order with weighted means and the centered moment shift n_f*(mu_f_i-mu_i)*(mu_f_j-mu_j). The full refit also uses all cached folds. B scans retained rows directly, including one full-data prep. This changes rounding, centering, Gram/Xy/y-norm values, the CV loss path and final fit. The catalog explicitly identifies C13 as a numerical profile; A-versus-B bit changes are permitted but task-quality regression is not accepted."
      },
      {
        "id": "fold_contract",
        "status": "NO_CONCRETE_INDEX_COUNT_LEAKAGE_OR_SCALING_DEFECT_FOUND",
        "details": "Fold cache IDs come from contiguous unshuffled KFold at y+n. Retained training statistics exclude the held fold; final refit uses held=-1 and all folds. Augmented cache layout, symmetric Gram writes and destination offsets align. Counts are below 2^24 in this workload. Held-out denominator is n-training_count. No omitted normalization or L1/L2 scaling discrepancy found in reviewed paths."
      },
      {
        "id": "C18_forwarding",
        "status": "NO_CONCRETE_DEFECT_FOUND_NOT_IDENTITY_PROOF",
        "details": "Scalar/team routines forward the same fmad result written to Qw[j+1]; unchanged weights and zero Gram diagonal paths reload the next residual, and each team thread owns its Qw entries. Coordinate order, loss/gap formula and stopping conditions remain those of B. This source inspection is not an isolated C18 execution or identity check."
      },
      {
        "id": "explicit_grid",
        "status": "AUTO_GRID_NOT_REACHED",
        "details": "The frozen alphas are [0.001,0.01,0.1,1.0], sorted descending before native entry. ecv_alpha_cell copies explicit values; changes in automatically generated alpha_max cannot explain these cases. Selected alpha may still differ; it was not retained."
      },
      {
        "id": "quality_gate",
        "status": "RETAIN_EXISTING_FAILURE",
        "details": "All 16 saved warmup/scored worker executions returned 0; eight scored outputs have finite task metrics. The saved existing af_quality gate marks RMSE WORSE for both estimators and vendors. R2 remains within its tolerance. No task metrics were recomputed or gates changed."
      },
      {
