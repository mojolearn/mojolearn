# SPDX-License-Identifier: Apache-2.0
"""Production UInt32 histogram count cells are generated by the actual
RF binned histogram kernel, then retained parent-left algebra is compared
against independently generated sibling cells. Also witnesses Int32-count
boundary, child>parent refusal and mismatched sampled features. Weighted
histogram algebra and frontier integration remain separate prerequisites."""
from max.gpu.host import DeviceContext
from ensemble.checks.rf_perf_candidates_check import Fixture, run_histogram_arm
from ensemble.decisiontree.batched_levelalgo.exact_histogram_subtract import enqueue_exact_histogram_subtract

def check(ctx: DeviceContext, parent_values: List[UInt32], left_values: List[UInt32], expected: List[UInt32], invalid_index: Int) raises:
    var n = len(parent_values)
    var parent = ctx.enqueue_create_buffer[DType.uint32](n)
    var child = ctx.enqueue_create_buffer[DType.uint32](n)
    var sibling = ctx.enqueue_create_buffer[DType.uint32](n)
    var invalid = ctx.enqueue_create_buffer[DType.uint8](n)
    sibling.enqueue_fill(UInt32(0xdeadbeef))
    ctx.enqueue_copy(dst_buf=parent,src_ptr=parent_values.unsafe_ptr())
    ctx.enqueue_copy(dst_buf=child,src_ptr=left_values.unsafe_ptr())
    enqueue_exact_histogram_subtract(ctx,parent,child,sibling,invalid,n,2147483647,UInt64(17),UInt64(17))
    var output = ctx.enqueue_create_host_buffer[DType.uint32](n)
    var status = ctx.enqueue_create_host_buffer[DType.uint8](n)
    ctx.enqueue_copy(dst_ptr=output.unsafe_ptr(),src_buf=sibling)
    ctx.enqueue_copy(dst_ptr=status.unsafe_ptr(),src_buf=invalid)
    ctx.synchronize()
    for i in range(n):
        var bad = i==invalid_index
        if status[i] != (UInt8(1) if bad else UInt8(0)) or output[i] != (UInt32(0xdeadbeef) if bad else expected[i]):
            raise Error("I18 exactness/overflow guard changed cell "+String(i))
    var refused = False
    try:
        enqueue_exact_histogram_subtract(ctx,parent,child,sibling,invalid,n,2147483647,UInt64(17),UInt64(19))
    except:
        refused=True
    if not refused:
        raise Error("I18 feature sampling incompatibility accepted")
    _ = parent^; _ = child^; _ = sibling^; _ = invalid^

def main() raises:
    var ctx = DeviceContext()
    var fx = Fixture(ctx)
    var left = run_histogram_arm[TILE=2](ctx,fx,False,False)
    var right = run_histogram_arm[TILE=4](ctx,fx,True,False)
    var parent = List[UInt32]()
    for i in range(len(left)):
        parent.append(left[i]+right[i])
    check(ctx,parent,left,right,-1)
    check(ctx,[2147483647,2147483647,0],[0,2147483646,0],[2147483647,1,0],-1)
    check(ctx,[2,0,2147483648],[1,0,1],[1,0,0],2)
    check(ctx,[0,1,2],[0,2,1],[0,0,1],1)
    _ = fx^
    print("I18 PASS actual_RF_count_cells exact_subtraction overflow_sampling_guards")
