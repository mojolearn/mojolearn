+    var params: List[Int] = [shape[0], shape[1], configuration[0], configuration[1], configuration[2],
+        configuration[3], configuration[4], configuration[5], budget, cost]
+    var lease = OperationLockLease(fields["_runtime_lock"])
+    lease.acquire()
+    mods.released()
