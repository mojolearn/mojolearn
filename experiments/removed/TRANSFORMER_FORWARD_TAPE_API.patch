+        owner[].consumed = True
+        py_setitem(slots, "_consumed", PythonObject(True))
+        lease.release()
+    except problem:
+        mods.released()
+        lease.release()
+        raise problem
+    _ = hobj
+    return PythonObject(None)
 
 
