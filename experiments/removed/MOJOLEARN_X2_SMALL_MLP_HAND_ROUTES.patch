+def mlp_resident_download_host(
+    ctx: DeviceContext,
+    h: Int,
+    w1_ptr: MutPointer[Float32, MutUntrackedOrigin],
+    b1_ptr: MutPointer[Float32, MutUntrackedOrigin],
+    w2_ptr: MutPointer[Float32, MutUntrackedOrigin],
