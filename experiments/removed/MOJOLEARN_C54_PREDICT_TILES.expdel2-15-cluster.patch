+        comptime for lane in range(4):
+            if first+lane < Int(m):
+                var delta=_sub(qv,z.unsafe_load((first+lane)*Int(d)+feature))
+                sums[lane]=ftz(identical_mul_add(delta,delta,sums[lane]))
