+        if p(q, 7) >= 0:
+            st(f, p(q, 7)+at, div(squares[k], weights[k]) if weights[k] != Float32(0) else Float32(0))
+        if p(q, 8) >= 0:
+            st(f, p(q, 8)+at, sums[k])
