+        sizes.append(oc)
+        pw.append(w)
+        pw.append(b)
+        pg.append(gw)
+        pg.append(gb)
+    var head: List[Int] = [res_alloc(K * flat), res_alloc(K), res_alloc(K * flat), res_alloc(K)]
+    var hwv = _fixture(K * flat, 7, Float32(5000.0))
+    var hbv = _fixture(K, 8, Float32(5000.0))
+    _up(head[0], hwv)
+    _up(head[1], hbv)
+    sizes.append(K * flat)
+    sizes.append(K)
+    pw.append(head[0])
+    pw.append(head[1])
+    pg.append(head[2])
+    pg.append(head[3])
