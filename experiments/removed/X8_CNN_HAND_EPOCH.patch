diff --git a/python/mojolearn/tests/test_x_cnn_native_sessions.py b/python/mojolearn/tests/test_x_cnn_native_sessions.py
new file mode 100644
index 0000000000..7dc7ae9a2d
--- /dev/null
+++ b/python/mojolearn/tests/test_x_cnn_native_sessions.py
@@ -0,0 +1,102 @@
+# SPDX-License-Identifier: Apache-2.0
+"""The CNN classifier's one-call fit (`x_cnn_fit_d`) and one-call predict
+(`x_cnn_predict_r`) produce the same words as the per-epoch and per-chunk
+entries they replace, and the admission record never changes a result."""
+import contextlib
+
+import numpy as np
+import pytest
+
+
+def _bindings():
+    from mojolearn import _native_xcnn_bridge as bridge
+    _, context = bridge.connect()
+    tables = context.get("xcnn_bindings")
+    if not tables:
+        pytest.skip("the CNN binding is not connected")
+    return [t for t in tables.values() if isinstance(t, dict)]
+
+
+@contextlib.contextmanager
+def _without(name):
+    """Hide one compiled entry so the classifier takes its older route."""
+    saved = []
+    for table in _bindings():
+        if name in table["symbols"]:
+            saved.append((table, table["symbols"].pop(name)))
+    try:
+        yield bool(saved)
+    finally:
+        for table, fn in saved:
+            table["symbols"][name] = fn
+
+
+def _data(rows=150):
+    rng = np.random.default_rng(3)
+    X = rng.standard_normal((rows, 1, 6, 6)).astype(np.float32)
+    y = (X[:, 0, :3].sum((1, 2)) > X[:, 0, 3:].sum((1, 2))).astype(int)
+    return X.reshape(rows, -1), y
+
+
+def _fit(optimizer, X, y):
+    import mojolearn as ml
+    return ml.CNNClassifier(input_shape=(1, 6, 6), conv_channels=(4,), learning_rate=0.05, batch_size=32,
+                            max_iter=4, optimizer=optimizer, random_state=0).fit(X, y)
+
+
+def _weight_bytes(model):
+    return [np.asarray(w).tobytes() for w in model.weights()]
+
+
+@pytest.mark.parametrize("optimizer", ["sgd", "adam"])
+def test_fit_one_call_equals_epoch_calls(optimizer):
+    X, y = _data()
+    whole = _fit(optimizer, X, y)
+    with _without("x_cnn_fit_d") as hidden:
+        if not hidden:
+            pytest.skip("this binding has no x_cnn_fit_d")
+        epochs = _fit(optimizer, X, y)
+    assert np.asarray(whole.loss_curve_).tobytes() == np.asarray(epochs.loss_curve_).tobytes()
+    assert np.asarray(whole.losses_).tobytes() == np.asarray(epochs.losses_).tobytes()
+    assert _weight_bytes(whole) == _weight_bytes(epochs)
+
+
+@pytest.mark.parametrize("rows", [1, 150, 2048 + 37])
+def test_predict_one_call_equals_chunk_calls(rows):
+    X, y = _data()
+    model = _fit("sgd", X, y)
+    Q, _ = _data(rows)
+    proba = model.predict_proba(Q)
+    labels = model.predict(Q)
+    with _without("x_cnn_predict_r") as hidden:
+        if not hidden:
+            pytest.skip("this binding has no x_cnn_predict_r")
+        proba_chunks = model.predict_proba(Q)
+        labels_chunks = model.predict(Q)
+    assert proba.tobytes() == proba_chunks.tobytes()
+    assert np.array_equal(labels, labels_chunks)
+
+
+def test_admission_record_follows_field_changes():
+    X, y = _data()
+    model = _fit("sgd", X, y)
+    first = model.predict_proba(X)
+    again = model.predict_proba(X)          # a stamped admission hit
+    assert first.tobytes() == again.tobytes()
+    model.layers_ = "not a layer list"      # a field write bumps the generation: full admission refuses it
+    with pytest.raises(TypeError):
+        model.predict_proba(X)
+
+
+def test_native_shape_rules_match_the_layers():
+    """Conv / pool output shapes come from the native shape rules (no
+    binding crossing); the shapes and the refusal are unchanged."""
+    from mojolearn import _expansion_cnn as E
+    x = np.zeros((2, 3, 7, 9), np.float32)
+    conv = E.Conv2d(3, 5, kernel_size=3, stride=2, padding=1, dilation=1)
+    assert conv.forward(x).shape == (2, 5, 4, 5)
+    pool = E.MaxPool2d(2, ceil_mode=True)
+    assert pool.forward(x).shape == (2, 3, 4, 5)
+    big = E.Conv2d(3, 5, kernel_size=11)
+    with pytest.raises(Exception, match="does not fit"):
+        big.forward(x)
diff --git a/tools/py_misc/cnn_epoch.py b/tools/py_misc/cnn_epoch.py
new file mode 100644
index 0000000000..8771e48b62
--- /dev/null
+++ b/tools/py_misc/cnn_epoch.py
@@ -0,0 +1,78 @@
+"""lane/py-misc: CNNClassifier.fit, the Python step loop (before) against
+x_cnn_fit_epoch_r (after), in ONE process on one column.
+
+PYMISC-DIGEST lines: sha256 of losses_, loss_curve_, every trained array,
+the optimizer buffers and predict_proba, per config and arm; PYMISC-SAME
+says whether the two arms' digests are equal. PYMISC-TIME lines: median
+fit wall per arm on the timing shape.
+usage: python cnn_epoch.py <repo root> <timing rows> [reps]"""
+import hashlib
+import statistics
+import sys
+import time
+
+import numpy as np
+
+sys.path.insert(0, sys.argv[1] + "/python")
+import mojolearn as ml  # noqa: E402
+from mojolearn import _expansion_cnn as xc  # noqa: E402
+
+rows = int(sys.argv[2])
+reps = int(sys.argv[3]) if len(sys.argv) > 3 else 3
+b = ml.CNNClassifier(input_shape=(1, 4, 4))._binding()
+print(f"PYMISC-COLUMN vendor={b.x_cnn_vendor()} has_epoch={hasattr(b, 'x_cnn_fit_epoch_r')}", flush=True)
+
+
+def digest(m, x):
+    h = hashlib.sha256()
+    h.update(np.asarray(m.losses_, np.float64).tobytes())
+    h.update(np.asarray(m.loss_curve_, np.float64).tobytes())
+    for a in m.weights() + list(m._bufs):
+        h.update(np.ascontiguousarray(a).tobytes())
+    h.update(np.ascontiguousarray(m.predict_proba(x)).tobytes())
+    return h.hexdigest()[:16]
+
+
+def fit(arm, x, y, **kw):
+    xc._EPOCH_ENTRY = arm == "epoch"
+    return ml.CNNClassifier(**kw).fit(x, y)
+
+
+rng = np.random.default_rng(0)
+x = rng.standard_normal((300, 3 * 8 * 8)).astype(np.float32)
+y = rng.integers(0, 4, 300)
+base = dict(input_shape=(3, 8, 8), random_state=3)
+configs = dict(
+    sgd=dict(conv_channels=(4,), batch_size=32, max_iter=2, momentum=0.9, weight_decay=1e-4),
+    sgd2blocks=dict(conv_channels=(4, 6), batch_size=64, max_iter=2),
+    nesterov=dict(conv_channels=(4,), batch_size=50, max_iter=2, nesterov=True),
+    dampening=dict(conv_channels=(4,), batch_size=33, max_iter=2, dampening=0.3),
+    adam=dict(conv_channels=(4, 5), batch_size=40, max_iter=3, optimizer="adam", weight_decay=1e-3),
+    adamw=dict(conv_channels=(4,), batch_size=64, max_iter=2, optimizer="adamw", betas=(0.8, 0.99)),
+    bigbatch=dict(conv_channels=(4,), batch_size=512, max_iter=2),
+    noshuffle=dict(conv_channels=(4,), batch_size=32, max_iter=1, shuffle=False),
+    nopool=dict(conv_channels=(3,), batch_size=32, max_iter=1, pool_size=16),
+    noconv=dict(conv_channels=(), batch_size=32, max_iter=2),
+)
+bad = 0
+for name, kw in configs.items():
+    d = {arm: digest(fit(arm, x, y, **base, **kw), x) for arm in ("python", "epoch")}
+    same = d["python"] == d["epoch"]
+    bad += not same
+    print(f"PYMISC-DIGEST cnn {name} python {d['python']} epoch {d['epoch']} {'SAME' if same else 'DIFFERENT'}",
+          flush=True)
+print(f"PYMISC-SAME cnn {'ALL SAME' if not bad else f'{bad} DIFFERENT'}", flush=True)
+
+# timing: MNIST-shaped rows, batch 32 (the audit's shape), one epoch
+xt = rng.standard_normal((rows, 28 * 28)).astype(np.float32)
+yt = rng.integers(0, 10, rows)
+for arm in ("python", "epoch"):
+    ts = []
+    for _ in range(reps):
+        s = time.perf_counter()
+        m = fit(arm, xt, yt, input_shape=(1, 28, 28), conv_channels=(8,), batch_size=32, max_iter=1, random_state=0)
+        ts.append(time.perf_counter() - s)
+    print(f"PYMISC-TIME cnn fit rows={rows} batch=32 epochs=1 arm={arm} median_s={statistics.median(ts):.3f} "
+          f"all={[round(t, 3) for t in ts]} digest={digest(m, xt[:256])}", flush=True)
+
+raise SystemExit(1 if bad else 0)
