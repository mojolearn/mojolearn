+            f"mojolearn {what}: x has d_model {x.shape[2]}, the weights "
+            f"have {d_model}"
+        )
+    if step and x.shape[1] != 1:
+        raise ValueError(
+            f"mojolearn {what}: a decode step takes exactly one token "
+            f"per batch row, got L = {x.shape[1]}; use forward() for "
+            "prefill"
+        )
+    return x
