+    var hw = Int(p.unsafe_load(PP_H)) * Int(p.unsafe_load(PP_W))
+    var div = Float32(gpool_avg_divisor(p))
+    var v = List[Float32](length=GPOOL_LANES, fill=Float32(0))
+    for nc in range(planes):
