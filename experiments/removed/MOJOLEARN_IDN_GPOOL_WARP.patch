+    else:
+        var r = gpool_max_lane(nc, t, x, hw)
+        sv[t] = r[0]
+        si[t] = Int32(r[1])
+    barrier()
+    var s = GPOOL_LANES // 2
+    while s > 0:
+        if t < s:
+            comptime if AVG:
+                sv[t] = ftz(sv[t] + sv[t + s])
+            else:
+                if gpool_max_pick(sv[t], Int(si[t]), sv[t + s], Int(si[t + s])):
+                    sv[t] = sv[t + s]
+                    si[t] = si[t + s]
+        barrier()
+        s //= 2
+    if t == 0:
+        comptime if AVG:
+            dst.unsafe_store(nc, ftz(identical_div(sv[0], Float32(gpool_avg_divisor(p)))))
+        else:
