+def nn34_prepare_kernel(gid_: Int, u: NN34FP, delta: NN34FP, a: NN34FP, b: NN34FP,
+    fa: NN34FP, fb: NN34FP, batch: Int32, length: Int32, width: Int32):
+    var i = gid_
+    var chains = Int(batch) * Int(width) * NS
+    if i >= chains * Int(length):
+        return
+    var token = i // chains
+    var chain = i % chains
+    var n = chain % NS
