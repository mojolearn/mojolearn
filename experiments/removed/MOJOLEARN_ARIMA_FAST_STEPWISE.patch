+        var t = _sw_start(i, p0, q0, k0, Int(max_p_in), Int(max_q_in))
+        var r = _sw_cell(cell, t[0], t[1], t[2])
+        if r >= 0:
+            want.unsafe_store(r * bs + b, Int32(1))
+            any_want.unsafe_store(0, Int32(1))
+
