+                    b_s[lj * M2_OCC_LD + n],  # B, ftz'd at staging
+                    acc,
+                )
+            )
+        acc = ftz(acc)
+    else:
+        acc = Float32(0.0)
+    cb_g.unsafe_store(((bb * nc + c) * qv + i) * qv + j, acc)
 
 
