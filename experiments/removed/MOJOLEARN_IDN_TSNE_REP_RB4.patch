--- a/x_ann/tsne_device.mojo
+++ b/x_ann/tsne_device.mojo
@@ -699,13 +699,161 @@ def kl_kernel(n: Int32, y: F32P, indptr: I32P, indices: I32P, values: F32P, z: F
         ts_kl_cell(i, y, indptr, indices, values, z, kl)
 
 
+#: svc-tsne D2 (IDENTICAL, NVIDIA and AMD, DEFAULT OFF, lane svc-tsne
+#: 2026-10-11): THE REPULSION TILE REGISTER-BLOCKED OVER 4 ROWS PER THREAD.
+#: Structural reason: `repulse_rep_tile_kernel` gives each thread one row, so
+#: every staged candidate (a shared load pair) serves 16 rows per block and a
+#: barrier pair falls every 16 pairs per thread. Here thread (rg, q) owns the
+#: RB4_R = 4 rows i0 + rg + RT2_ROWS r (r = 0..3) and the same RT2_U lanes
+#: s = q + RT2_LQ u of each, so a block serves RB4_ROWS = 64 rows per staged
+#: tile: 4x fewer shared loads and barriers per pair, 64 pairs per thread per
+#: barrier pair. Bits none: each row's lane s still folds j = j0 + 64 g + s
+#: ascending from +0 with `ts_repulse_fold`, j == i and j >= n skipped by the
+#: same branch (no pad terms added); the owner adds the row's 64 lane partials
+#: ascending from +0, each add flushed; Z is the same pinned pairwise tree
+#: over the rows (RB4_ROWS a power of two: each block an aligned subtree, as
+#: the 16-row and 32-row kernels already are, with equal digests), its parts
+#: folded by the last block. Expected ~1.85 -> ~0.7 ms per iteration (tsne
+#: taxi NV ~1852 -> ~800 ms). Register cost 48 accumulators + 8 coordinates.
+#: -D MOJOLEARN_IDN_TSNE_REP_RB4 turns it on (requires IDN_TSNE_REP_TILE);
+#: MOJOLEARN_IDN_ALL_OFF wins.
+comptime IDN_TSNE_REP_RB4 = (
+    IDN_TSNE_REP_TILE
+    and is_defined["MOJOLEARN_IDN_TSNE_REP_RB4"]()
+    and not is_defined["MOJOLEARN_IDN_ALL_OFF"]()
+)
+comptime RB4_R = 4
+comptime RB4_ROWS = RB4_R * RT2_ROWS
+
+
+def repulse_rep_rb4_kernel(n: Int32, y: F32P, row_z: F32P, rep: F32P, z_out: F32P, done: I32P, parts: F32P):
+    """`repulse_rep_tile_kernel` with RB4_R rows per thread (IDN_TSNE_REP_RB4):
+    the same words."""
+    comptime assert RT2_U * RT2_LQ == TS_LANES, "a row's lanes split evenly over its threads"
+    comptime assert RT2_TJ == RT2_TPB, "one candidate staged per thread"
+    comptime assert RB4_ROWS <= ZT_CHUNK, "the block's rows fit the Z tree buffer"
+    comptime NA = RB4_R * RT2_U
+    var tid = Int(thread_idx.x)
+    var nr = Int(n)
+    var i0 = Int(block_idx.x) * RB4_ROWS
+    var rg = tid // RT2_LQ
+    var q = tid - rg * RT2_LQ
+    var ys = stack_allocation[2 * RT2_TJ, Scalar[DType.float32], address_space=AddressSpace.SHARED]()
+    var part = stack_allocation[3 * RT2_ROWS * TS_LANES, Scalar[DType.float32], address_space=AddressSpace.SHARED]()
+    var zs = stack_allocation[ZT_CHUNK, Scalar[DType.float32], address_space=AddressSpace.SHARED]()
+    var yr0 = SIMD[DType.float32, RB4_R](0.0)
+    var yr1 = SIMD[DType.float32, RB4_R](0.0)
+    comptime for r in range(RB4_R):
+        var ir = i0 + rg + RT2_ROWS * r
+        if ir < nr:
+            yr0[r] = ftz(y.unsafe_load(2 * ir))
+            yr1[r] = ftz(y.unsafe_load(2 * ir + 1))
+    var lz = SIMD[DType.float32, NA](0.0)
+    var l0 = SIMD[DType.float32, NA](0.0)
+    var l1 = SIMD[DType.float32, NA](0.0)
+    var j0 = 0
+    while j0 < nr:
+        var v0 = Float32(0.0)
+        var v1 = Float32(0.0)
+        if j0 + tid < nr:
+            v0 = ftz(y.unsafe_load(2 * (j0 + tid)))
+            v1 = ftz(y.unsafe_load(2 * (j0 + tid) + 1))
+        ys[2 * tid] = v0
+        ys[2 * tid + 1] = v1
+        barrier()
+        # lane s = q + RT2_LQ u of row r folds j = j0 + 64 g + s, g ascending
+        comptime for g in range(RT2_TJ // TS_LANES):
+            comptime for u in range(RT2_U):
+                var jj = g * TS_LANES + q + RT2_LQ * u
+                var j = j0 + jj
+                if j < nr:
+                    var c0 = ys[2 * jj]
+                    var c1 = ys[2 * jj + 1]
+                    comptime for r in range(RB4_R):
+                        var ir = i0 + rg + RT2_ROWS * r
+                        if ir < nr and j != ir:
+                            var tm = ts_repulse_terms(yr0[r], yr1[r], c0, c1)
+                            var zz = lz[r * RT2_U + u]
+                            var aa = l0[r * RT2_U + u]
+                            var bb = l1[r * RT2_U + u]
+                            ts_repulse_fold(tm, zz, aa, bb)
+                            lz[r * RT2_U + u] = zz
+                            l0[r * RT2_U + u] = aa
+                            l1[r * RT2_U + u] = bb
+        barrier()
+        j0 += RT2_TJ
+    # publish the lane partials one RT2_ROWS-row group at a time; each row's
+    # owner adds its TS_LANES lanes in ascending s from +0, each add flushed
+    comptime for r in range(RB4_R):
+        var ir = i0 + rg + RT2_ROWS * r
+        comptime for u in range(RT2_U):
+            var s = q + RT2_LQ * u
+            part[rg * TS_LANES + s] = lz[r * RT2_U + u]
+            part[(RT2_ROWS + rg) * TS_LANES + s] = l0[r * RT2_U + u]
+            part[(2 * RT2_ROWS + rg) * TS_LANES + s] = l1[r * RT2_U + u]
+        barrier()
+        if ir < nr and q == 0:
+            var z = Float32(0.0)
+            var r0 = Float32(0.0)
+            var r1 = Float32(0.0)
+            for s in range(TS_LANES):
+                z = ftz(z + part[rg * TS_LANES + s])
+                r0 = ftz(r0 + part[(RT2_ROWS + rg) * TS_LANES + s])
+                r1 = ftz(r1 + part[(2 * RT2_ROWS + rg) * TS_LANES + s])
+            row_z.unsafe_store(ir, z)
+            rep.unsafe_store(2 * ir, r0)
+            rep.unsafe_store(2 * ir + 1, r1)
+            zs[rg + RT2_ROWS * r] = z
+        barrier()
+    fence[ordering = Ordering.RELEASE]()
+    # Z: `repulse_rep_tile_kernel`'s tail with RB4_ROWS rows per block
+    var rows_here = RB4_ROWS if nr - i0 > RB4_ROWS else nr - i0
+    var root = _tree_shared_kern(zs, rows_here, tid, RT2_TPB)
+    if tid == 0:
+        parts.unsafe_store(Int(block_idx.x), root)
+        fence[ordering = Ordering.RELEASE]()
+    var last = stack_allocation[1, Scalar[DType.int32], address_space=AddressSpace.SHARED]()
+    barrier()
+    if tid == 0:
+        var old = Atomic.fetch_add(done, Int32(1))
+        last[0] = Int32(1) if Int(old) == Int(grid_dim.x) - 1 else Int32(0)
+    barrier()
+    if last[0] == Int32(0):
+        return
+    fence[ordering = Ordering.ACQUIRE]()
+    var count = Int(grid_dim.x)
+    while count > 1:
+        var c0 = 0
+        var nc = 0
+        while c0 < count:
+            var w = ZT_CHUNK if count - c0 > ZT_CHUNK else count - c0
+            for e in range(tid, w, RT2_TPB):
+                zs[e] = parts.unsafe_load(c0 + e)
+            var rt = _tree_shared_kern(zs, w, tid, RT2_TPB)
+            if tid == 0:
+                parts.unsafe_store(nc, rt)
+            barrier()
+            fence[ordering = Ordering.ACQUIRE]()
+            c0 += ZT_CHUNK
+            nc += 1
+        count = nc
+    if tid == 0:
+        z_out.unsafe_store(0, ftz(parts.unsafe_load(0)))
+        done.unsafe_store(0, Int32(0))
+
+
 def _enq_repulse_split(
     ctx: DeviceContext, n: Int, mut ycur: DeviceBuffer[DType.float32], mut drz: DeviceBuffer[DType.float32],
     mut drep: DeviceBuffer[DType.float32], mut dz: DeviceBuffer[DType.float32], mut dcnt: DeviceBuffer[DType.int32],
     mut dparts: DeviceBuffer[DType.float32],
 ) raises:
     """TS_SPLIT's repulsion + Z launch (IDN_TSNE_REP_TILE picks the shape)."""
-    comptime if IDN_TSNE_REP_TILE:
+    comptime if IDN_TSNE_REP_RB4:
+        ctx.enqueue_function[repulse_rep_rb4_kernel](Int32(n), ycur.unsafe_ptr(), drz.unsafe_ptr(),
+                                                     drep.unsafe_ptr(), dz.unsafe_ptr(), dcnt.unsafe_ptr(),
+                                                     dparts.unsafe_ptr(), grid_dim=(n + RB4_ROWS - 1) // RB4_ROWS,
+                                                     block_dim=RT2_TPB)
+    elif IDN_TSNE_REP_TILE:
         ctx.enqueue_function[repulse_rep_tile_kernel](Int32(n), ycur.unsafe_ptr(), drz.unsafe_ptr(),
                                                       drep.unsafe_ptr(), dz.unsafe_ptr(), dcnt.unsafe_ptr(),
                                                       dparts.unsafe_ptr(), grid_dim=(n + RT2_ROWS - 1) // RT2_ROWS,
