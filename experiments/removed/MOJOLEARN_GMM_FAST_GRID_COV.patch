+@always_inline
+def _gmm_gc_pair(pr: Int, nt: Int) -> Tuple[Int, Int]:
+    """The pr-th upper tile pair (tj <= tk), row-major."""
+    var q = pr
+    var tj = 0
+    while q >= nt - tj:
+        q -= nt - tj
+        tj += 1
+    return (tj, tj + q)
+
