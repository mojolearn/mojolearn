+    conv_b: MutPointer[Float32, MutAnyOrigin],
+    win: MutPointer[Float32, MutAnyOrigin],
+    b_in: Int32, l_in: Int32, di_in: Int32,
+    cd_in: Int32,
+    dip_in: Int32,
+):
+    var b = Int(b_in)
