+        for kk in range(M2_D_CONV):
+            var k = kk
+            comptime if SAB_S6_TAPS_REVERSED:
+                k = M2_D_CONV - 1 - kk
+            acc = ftz(identical_mul_add(weights[k], inputs[j + k], acc))
+        comptime if SAB_S6_BIAS_LAST:
