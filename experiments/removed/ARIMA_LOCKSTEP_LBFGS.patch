+def _download_i32(ctx: DeviceContext, buf: DeviceBuffer[DType.int32], n: Int) raises -> List[Int32]:
+    var h = ctx.enqueue_create_host_buffer[DType.int32](n if n > 0 else 1)
+    if n > 0:
