+    var lp = logits.unsafe_ptr()
+    var shift = List[Float32](length=n * v, fill=Float32(0.0))
+    var expo = List[Float32](length=n * v, fill=Float32(0.0))
+    var shp = shift.unsafe_ptr()
+    var exp_p = expo.unsafe_ptr()
+    var vbody = v - v % HOST_FW
