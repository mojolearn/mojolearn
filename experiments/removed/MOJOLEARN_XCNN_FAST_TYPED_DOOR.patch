index 0000000000..020ffe6c1a
--- /dev/null
+++ b/bindings/xcnn_pool_typed_door.mojo
@@ -0,0 +1,1105 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Typed boundary tables for the CNN pools: the pilot of design A
+(`~/mojolearn-evidence/briefs-20261118/ideas-boundary-RESULT.md`), an opt-in
+arm, `-D MOJOLEARN_XCNN_FAST_TYPED_DOOR`, default off (lane fx-typed-pilot,
+2026-11-18). With the define off nothing here is called and the door
+(bindings/xcnn_pool_native_door.mojo) runs exactly as before.
+
+WHAT IT REPLACES. One resident forward of AdaptiveAvgPool2d reads its layer
+fields, the connected context and the binding's entries BY NAME on every
+call: each read builds a Python str from a literal, hashes it and looks it
+up, and the settings are parsed again from their Python tuples (the call
+profile's top host frames are `PythonObject.__getitem__`,
+`PyObject_GetAttrString` and `py_call`). Here those answers are kept in
+typed native records:
+
+  * ONE typed context per process (`XcnnTyped`): the connected classes, the
+    two bindings' module, switch words, numerical profile and resolved native
+    entry, the tensor slot names (interned once), the process default mode.
+  * ONE typed record per layer (`XcnnPoolRecord`), held natively and keyed
+    by the layer's instance dictionary: the admitted settings as the launch
+    words they produce, the saved input shape, the output dimensions, the
+    allocation counts and the binding the layer's mode resolved to.
+
+A hit is then: UNPACK the call tuple and the tensor's three storage slots
+(pointer reads through the interned names), compare integer stamps, allocate
+the output, RUN the same entry with the same words, PACK the output tensor.
+No `fields[...]`, no `context[...]`, no `entries[...]`, no Python str built,
+no settings parse, no instance-dictionary write.
+
+WHEN A RECORD IS FILLED. Never by guessing: after the unchanged door ran an
+operation to completion (`xcnn_pool_typed_learn`), from the state that call
+left behind, read strictly (exact tuples of exact ints, exact bools, exact
+strs; anything else leaves no record and the layer stays on the door). The
+door's own validation, refusal order and error texts therefore run before
+any record exists, and every hit is a call the door would have answered the
+same way.
+
+WHEN A RECORD IS VALID. CPython >= 3.12 dictionary and type watchers (the
+process watchers of bindings/native_loaded_module_door.mojo and
+bindings/native_class_admission_door.mojo): a record carries the watch epoch
+of the layer's instance dictionary, of the adaptive pool's inner layer's
+dictionary, of the connected context, of the bindings table and of the
+binding's entries, and the class epoch of the layer class and the tensor
+class. An attribute assignment, deletion, a replaced `__dict__`, a class
+edit or a changed default mode moves one of those and the call misses: the
+door runs and the record is filled again. A user who sets
+`layer.kernel_size = 3` after construction gets the new kernel on the next
+call. CPython 3.10 / 3.11 (no watchers) keep no record: every call takes the
+door.
+
+A hit writes nothing into the layer: the door's writes of an unchanged
+`_xshape` (and the adaptive pool's unchanged `_idx_host`, `_idx_dev`,
+`_layer`) are skipped, because the record proves the dictionary already
+holds equal values. A call with another input shape misses.
+
+COVERED (the rest takes the door unchanged): `forward` and `backward` of
+AvgPool2d, MaxPool2d, AdaptiveAvgPool2d and AdaptiveMaxPool2d (any output
+size: the pooling kernel when it divides the input, the adaptive kernel
+otherwise) and `forward` of AvgPool1d and MaxPool1d, for a `DeviceTensor`
+resident on the layer's binding. Dropout2d, host arrays and the 1-D backward
+(its result is a reshape view) stay on the door.
+
+MAX POOLS (lane fx-maxpool, 2026-11-19). The pilot left them on the door
+because the door writes the winners' state on every forward. That state is a
+function of the input shape only: `_xshape`, `_idx_shape`, `_idx_host = None`
+and `_idx_dev`, the handle of the layer's resident winners array, which stays
+the same array while its size is unchanged. So a hit writes nothing for a max
+pool either: the record proves the dictionary already holds exactly those
+values, and the record adds the winners' handle with the watch epochs of the
+two dictionaries that name it (the instance dictionary of the layer's
+resident-array owner `_dev`, and that owner's handle table). The winners are
+stored by the same entry into the same array as on the door, so a backward
+(typed or through the door) and `indices_` after a typed forward read what
+they read today. Reading `indices_` caches the host copy in `_idx_host`: that
+write moves the layer's epoch, the next forward takes the door (which clears
+it) and the record is filled again. (Dropout's call count and batch norm's
+running statistics do change per call; those layers are not covered.)
+
+Bits: none move. The same entries (`XC_AVGPOOL2D_FORWARD_M` /
+`XC_AVGPOOL2D_BACKWARD_M` with residency word 3, `XC_MAXPOOL2D_FORWARD_M` /
+`XC_MAXPOOL2D_BACKWARD_M` with 7, `XC_ADAPTIVE_POOL_M` with 3 or 7) and
+launch words as the door.
+
+Records are small and are dropped together when their count passes
+`_TYPED_RECORD_CAP` (a process that builds layers in a loop), then refilled
+on use. No loop over independent units here: per-call metadata only.
+"""
+from std.python import Python, PythonObject
+from std.python._cpython import GILReleased, PyObjectPtr
+from core.shared_slot import SharedSlot
+from core.entry_table import EntryRef, entry_ref_unresolved
+from core.xcnn_entry_table import (
+    XC_RES_ALLOC, XC_RES_ALLOC_NOFILL, XC_AVGPOOL2D_FORWARD_M, XC_AVGPOOL2D_BACKWARD_M,
+    XC_MAXPOOL2D_FORWARD_M, XC_MAXPOOL2D_BACKWARD_M, XC_ADAPTIVE_POOL_M,
+)
+from bindings.py_cpython_table import CPythonTable, cpython_table
+from bindings.py_balanced import py_call, py_type, py_get, py_contains
+from bindings.native_loaded_module_door import (
+    NativeModules, SharedDictWatch, SHARED_DICT_WATCH, shared_dict_watcher, shared_dict_watch,
+)
+from bindings.native_class_admission_door import class_record
+from bindings.native_class_admission_run import ClassWatch, CLASS_WATCH
+from bindings.mode_metadata_native_door import _fields, _STORAGE_CLASS_SLOT
+from bindings.xcnn_common_door import (
+    XCNN_F_ADAPT, xcnn_builtins, xcnn_ref, xcnn_tuple, _XCNN_SHAPE_SLOT, _XCNN_TENSOR_LAYOUT_SLOT,
+)
+from bindings.xcnn_pool_native_door import _is, _adaptive_max
+from x_cnn.door_run import XCNN_F_RESIDENT, XCNN_F2_ALL_OFF, xcnn_run_call, xcnn_run_fixed, xcnn_size
+from x_cnn.pool_run import (
+    PoolSettings, pool_run_words, pool_run_out_words, pool_run_m, pool_run_check_output,
+    pool_run_adaptive_divides, pool_run_adaptive_kernel, pool_run_cache_matches, pool_run_adaptive_words,
+)
+
+# The typed operations (index into `XcnnTyped.ops`).
+comptime _OP_ADAPTIVE_FORWARD = 0
+comptime _OP_ADAPTIVE_BACKWARD = 1
+comptime _OP_POOL_FORWARD = 2
+comptime _OP_POOL_BACKWARD = 3
+comptime _OP_COUNT = 4
+
+# Record kinds.
+comptime _KIND_AVG_2D = 0
+comptime _KIND_AVG_1D = 1
+comptime _KIND_ADAPTIVE_AVG = 2
+# fx-maxpool (2026-11-19): the max pools, and the adaptive kernel (an output
+# size that does not divide the input: `_K`).
+comptime _KIND_MAX_2D = 3
+comptime _KIND_MAX_1D = 4
+comptime _KIND_ADAPTIVE_MAX = 5
+comptime _KIND_ADAPTIVE_AVG_K = 6
+comptime _KIND_ADAPTIVE_MAX_K = 7
+
+# `XcnnTyped.held` positions: the connected objects of the typed context.
+comptime _H_CONTEXT = 0
+comptime _H_BINDINGS = 1
+comptime _H_BACKEND = 2
+comptime _H_TENSOR = 3
+comptime _H_AVGPOOL = 4
+comptime _H_DEFAULT = 5
+comptime _H_TUPLE = 6
+comptime _H_INT = 7
+comptime _H_NONE = 8
+comptime _H_MAXPOOL = 9
+comptime _H_DEV = 10
+comptime _H_LAST = 10
+
+# `XcnnTyped.names` positions: str objects made once per process.
+comptime _N_B = 0
+comptime _N_SHAPE = 1
+comptime _N_H = 2
+comptime _N_HOST = 3
+comptime _N_BASE = 4
+comptime _N_DEFAULT_MODE = 5
+
+#: records kept before the table is dropped and refilled on use
+comptime _TYPED_RECORD_CAP = 4096
+
+
+@fieldwise_init
+struct XcnnTypedBinding(Copyable, Movable):
+    """One numeric mode's connected x_cnn binding as typed values (the
+    entries dictionary `_native_xcnn_bridge._connect_mode` built), valid
+    while that dictionary's watch epoch is `epoch`."""
+    var ok: Bool
+    var entries: PythonObject
+    var epoch: Int
+    var module: PythonObject
+    var mixed: Bool
+    var idn: Int
+    var idn2: Int
+    var profile: PythonObject
+    var entry: EntryRef
+
+
+@fieldwise_init
+struct XcnnPoolRecord(Copyable, Movable):
+    """One pool layer's typed parameters and saved state."""
+    # the layer's instance dictionary (the key) and its watch epoch
+    var fields: Int
+    var stamp: Int
+    # the layer's class and its class-watch epoch
+    var cls: Int
+    var cls_epoch: Int
+    var kind: Int
+    # the typed context generation this record was filled under
+    var ctx_serial: Int
+    # the binding the layer's numeric_mode resolved to (0 identical, 1 fast)
+    # and whether it came from the process default mode
+    var mode: Int
+    var from_default: Bool
+    # the output is allocated without the +0.0 fill (`xcnn_out_new`)
+    var nofill: Bool
+    # the backward runs typed (2-D kinds, once the door's backward ran)
+    var backward_ok: Bool
+    # the dimensions a forward input must have; the saved (N, C, H, W)
+    # (`_xshape`); the forward output's dimensions
+    var x_dims: List[Int]
+    var saved: List[Int]
+    var out_dims: List[Int]
+    # the `_m` integers of the forward launch (the residency word, then the
+    # words) and of the backward launch (the same words for the pooling
+    # kernels; the adaptive kernel's differ in their mode word)
+    var ints: List[Int]
+    var ints_back: List[Int]
+    var out_count: Int
+    var in_count: Int
+    # adaptive pool: the inner AvgPool2d (`_layer`), its instance dictionary
+    # and that dictionary's watch epoch; 0 otherwise
+    var inner_layer: Int
+    var inner_fields: Int
+    var inner_stamp: Int
+    # max pools: the resident winners array's handle word (0: none), the
+    # resident-array owner (`_dev`) that names it, that owner's instance
+    # dictionary and its watch epoch, the owner's handle table and its epoch
+    var win_handle: Int
+    var owner: Int
+    var owner_fields: Int
+    var owner_stamp: Int
+    var table: Int
+    var table_stamp: Int
+
+
+struct XcnnTyped(Defaultable, Movable):
+    """The process's typed context and the layer records. Built empty (no
+    Python object at slot creation); filled with the GIL held."""
+    var names: List[PythonObject]
+    var held: List[PythonObject]
+    var ops: List[PythonObject]
+    var ops_known: List[Bool]
+    var ctx_ok: Bool
+    var ctx_serial: Int
+    var context_epoch: Int
+    var bindings_epoch: Int
+    var tensor_epoch: Int
+    var default_mode: Int
+    var device_io_off: Bool
+    var modes: List[XcnnTypedBinding]
+    var index: Dict[Int, Int]
+    var records: List[XcnnPoolRecord]
+
+    def __init__(out self):
+        self.names = List[PythonObject]()
+        self.held = List[PythonObject]()
+        self.ops = List[PythonObject]()
+        self.ops_known = List[Bool](length=4, fill=False)
+        self.ctx_ok = False
+        self.ctx_serial = 0
+        self.context_epoch = 0
+        self.bindings_epoch = 0
+        self.tensor_epoch = 0
+        self.default_mode = -1
+        self.device_io_off = False
+        self.modes = List[XcnnTypedBinding]()
+        self.index = Dict[Int, Int]()
+        self.records = List[XcnnPoolRecord]()
+
+
+# Shared by every extension module that holds this door: bump the name's
+# version with any field change of the three structs above.
+comptime XCNN_TYPED = SharedSlot[XcnnTyped, "MojolearnXcnnTypedDoorV2", 2]
+
+
+# ---------------------------------------------------------------- stamps
+
+@always_inline
+def _dict_epoch(w: UnsafePointer[SharedDictWatch, MutUntrackedOrigin], address: Int) raises -> Int:
+    """Watch epoch of the dictionary at `address` (0 until its first event):
+    `shared_dict_epoch` on a watcher pointer the caller read once."""
+    var seen = w[].epochs.find(address)
+    if seen:
+        return seen.value()
+    return 0
+
+
+@always_inline
+def _class_epoch_at(cw: UnsafePointer[ClassWatch, MutUntrackedOrigin], address: Int) raises -> Int:
+    """Class-watch epoch of the class at `address` (0 until its first event)."""
+    var seen = cw[].epochs.find(address)
+    if seen:
+        return seen.value()
+    return 0
+
+
+def _borrowed(address: Int) raises -> PyObjectPtr:
+    """The object pointer of an address a valid record holds (the form of
+    bindings/native_owner_registry_pack.mojo `borrowed_native_owner`)."""
+    var raw = Pointer[UInt8, MutUntrackedOrigin](unsafe_from_address=address)
+    return PyObjectPtr(upcast_from=Optional(raw))
+
+
+# ---------------------------------------------------------------- the typed context (filled once)
+
+def _typed_binding_off() raises -> XcnnTypedBinding:
+    var none = PythonObject(None)
+    return XcnnTypedBinding(False, none, 0, none, False, 0, 0, none, entry_ref_unresolved())
+
+
+def _typed_binding(entries: PythonObject, b: PythonObject) raises -> XcnnTypedBinding:
+    """One mode's entries dictionary as typed values; `ok` False when the
+    mode is not connected (an error text), its values are not the exact
+    types the bridge writes, or the dictionary cannot be watched."""
+    if entries is None or py_type(entries) is not b.dict:
+        return _typed_binding_off()
+    var mixed = py_get(entries, "mixed")
+    var idn = py_get(entries, "idn")
+    var idn2 = py_get(entries, "idn2")
+    var profile = py_get(entries, "profile")
+    var module = py_get(entries, "module")
+    if py_type(mixed) is not b.bool or py_type(idn) is not b.int or py_type(idn2) is not b.int:
+        return _typed_binding_off()
+    if profile is not None and py_type(profile) is not b.str:
+        return _typed_binding_off()
+    if module is None:
+        return _typed_binding_off()
+    if not shared_dict_watch(entries._obj_ptr):
+        return _typed_binding_off()
+    try:
+        # the image's native entry, resolved once for the process (a table
+        # entry is published at module init and never replaced)
+        var entry = xcnn_ref(entries)
+        var w = SHARED_DICT_WATCH.get_or_create_ptr()
+        return XcnnTypedBinding(True, entries, _dict_epoch(w, Int(entries._obj_ptr)), module, Bool(py=mixed),
+                                Int(py=idn), Int(py=idn2), profile, entry)
+    except:
+        return _typed_binding_off()
+
+
+def _typed_mode_index(value: PythonObject, b: PythonObject) raises -> Int:
+    """0 for an exact "identical", 1 for an exact "fast", else -1 (the door
+    also accepts other spellings; those layers keep the door)."""
+    if value is None or py_type(value) is not b.str:
+        return -1
+    var text = String(py=value)
+    if text == "identical":
+        return 0
+    if text == "fast":
+        return 1
+    return -1
+
+
+def _typed_context_current(s: UnsafePointer[XcnnTyped, MutUntrackedOrigin], context: PythonObject) raises -> Bool:
+    """Whether the typed context still describes `context`: every stamp it
+    was filled under is unchanged."""
+    if not s[].ctx_ok or len(s[].held) <= _H_LAST or len(s[].modes) != 2:
+        return False
+    if context._obj_ptr != s[].held[_H_CONTEXT]._obj_ptr:
+        return False
+    var w = SHARED_DICT_WATCH.get_or_create_ptr()
+    var cw = CLASS_WATCH.get_or_create_ptr()
+    if _dict_epoch(w, Int(context._obj_ptr)) != s[].context_epoch:
+        return False
+    if _dict_epoch(w, Int(s[].held[_H_BINDINGS]._obj_ptr)) != s[].bindings_epoch:
+        return False
+    if _class_epoch_at(cw, Int(s[].held[_H_TENSOR]._obj_ptr)) != s[].tensor_epoch:
+        return False
+    for i in range(2):  # driver-loop: over the two numeric modes
+        if s[].modes[i].ok and _dict_epoch(w, Int(s[].modes[i].entries._obj_ptr)) != s[].modes[i].epoch:
+            return False
+    var default = py_get(s[].held[_H_BACKEND], s[].names[_N_DEFAULT_MODE])
+    return default is s[].held[_H_DEFAULT]
+
+
+def _typed_context_fill(s: UnsafePointer[XcnnTyped, MutUntrackedOrigin], context: PythonObject,
+                        b: PythonObject) raises -> Bool:
+    """Fill the typed context from the connected `context` (once per process
+    in the steady state; again only when a stamp moved). Runs after the door
+    answered an operation, so the tensor class's layout and shape verdicts
+    are on record; without them there is no typed context."""
+    s[].ctx_ok = False
+    if len(s[].names) == 0:
+        # The slot names as the str objects the bridge connected (the keys of
+        # `xcnn_tensor_slots`: the layer module's own interned constants), so
+        # attribute lookups by them use CPython's type-attribute cache and no
+        # str is built per call. Kept for the process once found.
+        var slots = py_get(context, "xcnn_tensor_slots")
+        if slots is None or py_type(slots) is not b.dict:
+            return False
+        var keys = py_call(b.list, slots)
+        var literals: List[String] = ["b", "shape", "h", "_host", "_base"]
+        var names = List[PythonObject]()
+        for i in range(len(literals)):  # driver-loop: over the five fixed slot names, once per process
+            var found = False
+            for j in range(len(keys)):  # driver-loop: over the five connected slot names, once per process
+                var key = keys[j]
+                if py_type(key) is b.str and String(py=key) == literals[i]:
+                    names.append(key)
+                    found = True
+                    break
+            if not found:
+                return False
+        names.append(PythonObject("_DEFAULT_MODE"))
+        s[].names = names^
+    if len(s[].ops) == 0:
+        for i in range(4):  # driver-loop: over the four typed operations, once per process
+            s[].ops.append(PythonObject(None))
+    if py_type(context) is not b.dict:
+        return False
+    var bindings = py_get(context, "xcnn_bindings")
+    var backend = py_get(context, "backend_fields")
+    var tensor_class = py_get(context, "xcnn_tensor_class")
+    var avgpool_class = py_get(context, "xcnn_avgpool_class")
+    var maxpool_class = py_get(context, "xcnn_maxpool_class")
+    var dev_class = py_get(context, "xcnn_dev_class")
+    var io_off = py_get(context, "xcnn_device_io_off")
+    if bindings is None or backend is None or tensor_class is None or avgpool_class is None:
+        return False
+    if maxpool_class is None or dev_class is None:
+        return False
+    if py_type(bindings) is not b.dict or py_type(backend) is not b.dict or py_type(io_off) is not b.bool:
+        return False
+    var mods = NativeModules()
+    if class_record(mods, _XCNN_TENSOR_LAYOUT_SLOT, tensor_class) is None:
+        return False
+    if class_record(mods, _XCNN_SHAPE_SLOT, tensor_class) is None:
+        return False
+    if not shared_dict_watch(context._obj_ptr) or not shared_dict_watch(bindings._obj_ptr):
+        return False
+    var default = py_get(backend, s[].names[_N_DEFAULT_MODE])
+    var modes = List[XcnnTypedBinding]()
+    modes.append(_typed_binding(py_get(bindings, "identical"), b))
+    modes.append(_typed_binding(py_get(bindings, "fast"), b))
+    var held = List[PythonObject]()
+    held.append(context)
+    held.append(bindings)
+    held.append(backend)
+    held.append(tensor_class)
+    held.append(avgpool_class)
+    held.append(default)
+    held.append(b.tuple)
+    held.append(b.int)
+    held.append(PythonObject(None))
+    held.append(maxpool_class)
+    held.append(dev_class)
+    var w = SHARED_DICT_WATCH.get_or_create_ptr()
+    var cw = CLASS_WATCH.get_or_create_ptr()
+    s[].held = held^
+    s[].modes = modes^
+    s[].context_epoch = _dict_epoch(w, Int(context._obj_ptr))
+    s[].bindings_epoch = _dict_epoch(w, Int(bindings._obj_ptr))
+    s[].tensor_epoch = _class_epoch_at(cw, Int(tensor_class._obj_ptr))
+    s[].default_mode = _typed_mode_index(default, b)
+    s[].device_io_off = Bool(py=io_off)
+    s[].ctx_serial = s[].ctx_serial + 1
+    s[].ctx_ok = True
+    return True
+
+
+# ---------------------------------------------------------------- strict reads of a layer's state (at fill only)
+
+def _typed_words(value: PythonObject, b: PythonObject, mut dst: List[Int]) raises -> Bool:
+    """Append the words of an exact tuple of exact ints; False otherwise."""
+    if value is None or py_type(value) is not b.tuple:
+        return False
+    for i in range(len(value)):  # driver-loop: over shape or setting words, at fill only
+        var item = value[i]
+        if py_type(item) is not b.int:
+            return False
+        dst.append(Int(py=item))
+    return True
+
+
+def _typed_pair(fields: PythonObject, name: String, b: PythonObject, mut dst: List[Int]) raises -> Bool:
+    """A setting held as an exact tuple of two exact ints (what `pool_init`
+    writes); anything else keeps the door."""
+    var value = py_get(fields, PythonObject(name))
+    var before = len(dst)
+    if not _typed_words(value, b, dst):
+        return False
+    return len(dst) == before + 2
+
+
+def _typed_settings(fields: PythonObject, b: PythonObject, mut dst: List[Int]) raises -> Bool:
+    """The settings `_pool_words` reads, as eleven words: kernel, stride,
+    padding and dilation pairs, count_include_pad, ceil_mode, the divisor
+    override (0: none)."""
+    if not _typed_pair(fields, "kernel_size", b, dst):
+        return False
+    if not _typed_pair(fields, "stride", b, dst):
+        return False
+    if not _typed_pair(fields, "padding", b, dst):
+        return False
+    if not _typed_pair(fields, "dilation", b, dst):
+        return False
+    var include_pad = py_get(fields, "count_include_pad")
+    var ceil_mode = py_get(fields, "ceil_mode")
+    if py_type(include_pad) is not b.bool or py_type(ceil_mode) is not b.bool:
+        return False
+    dst.append(1 if Bool(py=include_pad) else 0)
+    dst.append(1 if Bool(py=ceil_mode) else 0)
+    var divisor = py_get(fields, "divisor_override")
+    if divisor is None:
+        dst.append(0)
+    elif py_type(divisor) is b.int:
+        dst.append(Int(py=divisor))
+    else:
+        return False
+    return True
+
+
+def _typed_recorded(s: UnsafePointer[XcnnTyped, MutUntrackedOrigin], fields: PythonObject, mode: Int,
+                    b: PythonObject) raises -> Bool:
+    """Whether `xcnn_entries` would write nothing into `fields` for binding
+    `mode`: the recorded mode text and (identical) the recorded numerical
+    profile already agree."""
+    var recorded = py_get(fields, "numeric_mode_")
+    if _typed_mode_index(recorded, b) != mode:
+        return False
+    if mode != 0:
+        return True
+    var current = s[].modes[mode].profile
+    var previous = py_get(fields, "numerical_profile_")
+    if previous is current:
+        return True
+    if previous is None or current is None:
+        return False
+    if py_type(previous) is not b.str:
+        return False
+    return String(py=previous) == String(py=current)
+
+
+def _typed_resident(s: UnsafePointer[XcnnTyped, MutUntrackedOrigin], mode: Int) -> Bool:
+    """`xcnn_resident(entries, context)` from the typed binding."""
+    if not s[].modes[mode].mixed or (s[].modes[mode].idn & XCNN_F_RESIDENT) == 0:
+        return False
+    return not (s[].device_io_off or (s[].modes[mode].idn2 & XCNN_F2_ALL_OFF) != 0)
+
+
+def _typed_same(left: List[Int], right: List[Int]) -> Bool:
+    if len(left) != len(right):
+        return False
+    for i in range(len(left)):  # driver-loop: over shape or setting words
+        if left[i] != right[i]:
+            return False
+    return True
+
+
+def _typed_winners(s: UnsafePointer[XcnnTyped, MutUntrackedOrigin], state: PythonObject, out4: List[Int],
+                   mode: Int, b: PythonObject, mut win: List[Int]) raises -> Bool:
+    """A max pool's resident winners as the door's forward left them in
+    `state` (the instance dictionary that holds them: the pool's own, or the
+    adaptive pool's for the adaptive kernel), read strictly: `_idx_host`
+    None, `_idx_dev` an exact positive int, `_idx_shape` the output's
+    (N, C, OH, OW), `_dev` an owner of the connected class on this binding
+    whose table names that handle under "idx" with the output's word count
+    (what `xcnn_dev_get_f` would return again, without reallocating). On
+    True `win` receives the handle, the owner, the owner's instance
+    dictionary and its watch epoch, the handle table and its epoch. Anything
+    else: False, and the layer keeps the door."""
+    if not py_contains(state, "_idx_host") or py_get(state, "_idx_host") is not None:
+        return False
+    var held = py_get(state, "_idx_dev")
+    if held is None or py_type(held) is not b.int:
+        return False
+    var handle = Int(py=held)
+    if handle < 1:
+        return False
+    var idx_shape = List[Int]()
+    if not _typed_words(py_get(state, "_idx_shape"), b, idx_shape) or not _typed_same(idx_shape, out4):
+        return False
+    var owner = py_get(state, "_dev")
+    if owner is None or py_type(owner) is not s[].held[_H_DEV]:
+        return False
+    var owner_fields = _fields(owner)
+    if py_get(owner_fields, "b") is not s[].modes[mode].module:
+        return False
+    var table = py_get(owner_fields, "h")
+    if table is None or py_type(table) is not b.dict:
+        return False
+    var pair = List[Int]()
+    if not _typed_words(py_get(table, "idx"), b, pair) or len(pair) != 2:
+        return False
+    if pair[0] != handle or pair[1] != max(xcnn_size(out4), 1):
+        return False
+    if not shared_dict_watch(owner_fields._obj_ptr) or not shared_dict_watch(table._obj_ptr):
+        return False
+    var w = SHARED_DICT_WATCH.get_or_create_ptr()
+    win.append(handle)
+    win.append(Int(owner._obj_ptr))
+    win.append(Int(owner_fields._obj_ptr))
+    win.append(_dict_epoch(w, Int(owner_fields._obj_ptr)))
+    win.append(Int(table._obj_ptr))
+    win.append(_dict_epoch(w, Int(table._obj_ptr)))
+    _ = table
+    _ = owner_fields
+    _ = owner
+    return True
+
+
+def _typed_set_winners(mut record: XcnnPoolRecord, win: List[Int]):
+    """The six words `_typed_winners` returned, into the record."""
+    record.win_handle = win[0]
+    record.owner = win[1]
+    record.owner_fields = win[2]
+    record.owner_stamp = win[3]
+    record.table = win[4]
+    record.table_stamp = win[5]
+
+
+def _typed_operation(operation: PythonObject, b: PythonObject) raises -> Int:
+    if py_type(operation) is not b.str:
+        return -1
+    var text = String(py=operation)
+    if text == "adaptive_forward":
+        return _OP_ADAPTIVE_FORWARD
+    if text == "adaptive_backward":
+        return _OP_ADAPTIVE_BACKWARD
+    if text == "pool_forward":
+        return _OP_POOL_FORWARD
+    if text == "pool_backward":
+        return _OP_POOL_BACKWARD
+    return -1
+
+
+def _typed_store(s: UnsafePointer[XcnnTyped, MutUntrackedOrigin], var record: XcnnPoolRecord) raises:
+    var key = record.fields
+    var slot = s[].index.find(key)
+    if slot:
+        s[].records[slot.value()] = record^
+        return
+    if len(s[].records) >= _TYPED_RECORD_CAP:
+        # a process that keeps building layers: drop every record (each is
+        # refilled by its layer's next call through the door)
+        s[].records = List[XcnnPoolRecord]()
+        s[].index = Dict[Int, Int]()
+    s[].index[key] = len(s[].records)
+    s[].records.append(record^)
+
+
+def _typed_learn(model: PythonObject, operation: PythonObject, context: PythonObject) raises:
+    var b = xcnn_builtins()
+    var which = _typed_operation(operation, b)
+    if which < 0:
+        return
+    # Records need the 3.12+ watchers: the dictionary watcher (not the
+    # 3.10 / 3.11 version tags, which do not see every case below) and the
+    # type watcher the door's class records already armed.
+    if shared_dict_watcher() < 0:
+        return
+    var cw = CLASS_WATCH.get_or_create_ptr()
+    if cw[].watcher < 0:
+        return
+    var s = XCNN_TYPED.get_or_create_ptr()
+    if not _typed_context_current(s, context):
+        if not _typed_context_fill(s, context, b):
+            return
+    # the operation name object the layer methods pass (a constant of the
+    # Python module): later calls are recognised by its identity
+    s[].ops[which] = operation
+    s[].ops_known[which] = True
+
+    var fields = _fields(model)
+    if not shared_dict_watch(fields._obj_ptr):
+        return
+    var w = SHARED_DICT_WATCH.get_or_create_ptr()
+    # The stamp is read before the state: nothing below runs Python code
+    # (exact-type reads only), and an edit by anything else moves the epoch.
+    var stamp = _dict_epoch(w, Int(fields._obj_ptr))
+    var cls = py_type(model)
+    var mods = NativeModules()
+    if class_record(mods, _STORAGE_CLASS_SLOT, cls) is None:
+        return
+    var cls_epoch = _class_epoch_at(cw, Int(cls._obj_ptr))
+
+    # the binding `xcnn_entries` resolves for this layer
+    var mode_value = py_get(fields, "numeric_mode")
+    var from_default = mode_value is None
+    var mode = s[].default_mode if from_default else _typed_mode_index(mode_value, b)
+    if mode < 0 or not s[].modes[mode].ok or not s[].modes[mode].mixed:
+        return
+    if not _typed_recorded(s, fields, mode, b):
+        return
+
+    var saved = List[Int]()
+    if not _typed_words(py_get(fields, "_xshape"), b, saved) or len(saved) != 4:
+        return
+
+    if which == _OP_POOL_FORWARD or which == _OP_POOL_BACKWARD:
+        var p_maxed = _is(model, "xcnn_maxpool_class", context)
+        var one_d = _is(model, "xcnn_pool1d_class", context)
+        if one_d and saved[2] != 1:
+            return
+        var st = List[Int]()
+        if not _typed_settings(fields, b, st):
+            return
+        var words = pool_run_words(PoolSettings(st[0], st[1], st[2], st[3], st[4], st[5], st[6], st[7],
+                                                st[8] != 0, st[9] != 0, st[10]), saved)
+        var out4 = pool_run_out_words(words, saved)
+        var x_dims = List[Int]()
+        var out_dims = List[Int]()
+        if one_d:
+            x_dims = [saved[0], saved[1], saved[3]]
+            out_dims = [out4[0], out4[1], out4[3]]
+        else:
+            x_dims = saved.copy()
+            out_dims = out4.copy()
+        var out_count = max(xcnn_size(out4), 1)
+        var in_count = max(xcnn_size(saved), 1)
+        # fx-maxpool: a max pool's record needs its winners as the door left
+        # them (the pool's own dictionary holds them); residency word 7.
+        var p_win = List[Int]()
+        if p_maxed:
+            if not _typed_winners(s, fields, out4, mode, b, p_win):
+                return
+        var p_kind = _KIND_AVG_1D if one_d else _KIND_AVG_2D
+        if p_maxed:
+            p_kind = _KIND_MAX_1D if one_d else _KIND_MAX_2D
+        var p_dev = 7 if p_maxed else 3
+        var p_record = XcnnPoolRecord(Int(fields._obj_ptr), stamp, Int(cls._obj_ptr), cls_epoch,
+                                      p_kind, s[].ctx_serial, mode, from_default,
+                                      _typed_resident(s, mode), not one_d, x_dims^, saved^, out_dims^,
+                                      pool_run_m(p_dev, words), pool_run_m(p_dev, words), out_count, in_count,
+                                      0, 0, 0, 0, 0, 0, 0, 0, 0)
+        if p_maxed:
+            _typed_set_winners(p_record, p_win)
+        _typed_store(s, p_record^)
+        _ = fields
+        _ = cls
+        return
+
+    # The adaptive pools on the resident route.
+    var a_maxed = _adaptive_max(model, context)
+    if (s[].modes[mode].idn & XCNN_F_ADAPT) == 0:
+        return
+    var o = List[Int]()
+    if not _typed_pair(fields, "output_size", b, o):
+        return
+    pool_run_check_output(o[0], o[1])
+    if not pool_run_adaptive_divides(saved, o):
+        # fx-maxpool: the adaptive kernel (an output size that does not
+        # divide the input). The door's forward wrote `_layer = None`, ran
+        # `XC_ADAPTIVE_POOL_M` on (x, y, winners or 0) with residency 3 (7
+        # for max) and, for max, left the winners in this dictionary; its
+        # backward runs the same entry on (g, dx, winners or 0) with the
+        # backward mode word and writes nothing.
+        if not py_contains(fields, "_layer") or py_get(fields, "_layer") is not None:
+            return
+        var k_out: List[Int] = [saved[0], saved[1], o[0], o[1]]
+        var k_win = List[Int]()
+        if a_maxed:
+            if not _typed_winners(s, fields, k_out, mode, b, k_win):
+                return
+        else:
+            if not py_contains(fields, "_idx_host") or not py_contains(fields, "_idx_dev"):
+                return
+            if py_get(fields, "_idx_host") is not None or py_get(fields, "_idx_dev") is not None:
+                return
+        var k_dev = 7 if a_maxed else 3
+        var k_out_count = max(xcnn_size(k_out), 1)
+        var k_in_count = max(xcnn_size(saved), 1)
+        var k_dims = saved.copy()
+        var k_fwd = pool_run_m(k_dev, pool_run_adaptive_words(saved, o, a_maxed, False))
+        var k_bwd = pool_run_m(k_dev, pool_run_adaptive_words(saved, o, a_maxed, True))
+        var k_record = XcnnPoolRecord(Int(fields._obj_ptr), stamp, Int(cls._obj_ptr), cls_epoch,
+                                      _KIND_ADAPTIVE_MAX_K if a_maxed else _KIND_ADAPTIVE_AVG_K, s[].ctx_serial,
+                                      mode, from_default, _typed_resident(s, mode), True, k_dims^, saved^, k_out^,
+                                      k_fwd^, k_bwd^, k_out_count, k_in_count, 0, 0, 0, 0, 0, 0, 0, 0, 0)
+        if a_maxed:
+            _typed_set_winners(k_record, k_win)
+        _typed_store(s, k_record^)
+        _ = fields
+        _ = cls
+        return
+    # an output size that divides: the door's pool cache needs the resident glue
+    if not _typed_resident(s, mode):
+        return
+    # the door wrote None under both names; a missing key would be a write
+    if not py_contains(fields, "_idx_host") or not py_contains(fields, "_idx_dev"):
+        return
+    if py_get(fields, "_idx_host") is not None or py_get(fields, "_idx_dev") is not None:
+        return
+    var k = pool_run_adaptive_kernel(saved, o)
+    var layer = py_get(fields, "_layer")
+    if layer is None:
+        return
+    if a_maxed:
+        if py_type(layer) is not s[].held[_H_MAXPOOL]:
+            return
+    elif py_type(layer) is not s[].held[_H_AVGPOOL]:
+        return
+    var cache = py_get(fields, "_pool_cache")
+    if cache is None or py_type(cache) is not b.tuple or len(cache) != 2:
+        return
+    var cached_layer = cache[1]
+    if cached_layer is not layer:
+        return
+    var cached = List[Int]()
+    if not _typed_words(cache[0], b, cached) or not pool_run_cache_matches(cached, k):
+        return
+    # the inner pool: the fields `_pool_layer` set and the door's forward left
+    var inner = _fields(layer)
+    if not shared_dict_watch(inner._obj_ptr):
+        return
+    var inner_stamp = _dict_epoch(w, Int(inner._obj_ptr))
+    var inner_st = List[Int]()
+    if not _typed_settings(inner, b, inner_st):
+        return
+    var expected: List[Int] = [k[0], k[1], k[0], k[1], 0, 0, 1, 1, 1, 0, 0]
+    if not _typed_same(inner_st, expected):
+        return
+    if py_get(inner, "numeric_mode") is not mode_value:
+        return
+    var inner_saved = List[Int]()
+    if not _typed_words(py_get(inner, "_xshape"), b, inner_saved) or not _typed_same(inner_saved, saved):
+        return
+    # the door's backward records the inner pool's mode and profile on its
+    # first run; the typed backward starts after that write exists
+    var backward_ok = _typed_recorded(s, inner, mode, b)
+    var a_words = pool_run_words(PoolSettings(k[0], k[1], k[0], k[1], 0, 0, 1, 1, True, False, 0), saved)
+    var a_out = pool_run_out_words(a_words, saved)
+    var a_out_count = max(xcnn_size(a_out), 1)
+    var a_in_count = max(xcnn_size(saved), 1)
+    var a_dims = saved.copy()
+    # fx-maxpool: the inner MaxPool2d holds the winners (its own dictionary,
+    # whose epoch the record already carries as `inner_stamp`).
+    var a_win = List[Int]()
+    if a_maxed:
+        if not _typed_winners(s, inner, a_out, mode, b, a_win):
+            return
+    var a_dev = 7 if a_maxed else 3
+    var a_record = XcnnPoolRecord(Int(fields._obj_ptr), stamp, Int(cls._obj_ptr), cls_epoch,
+                                  _KIND_ADAPTIVE_MAX if a_maxed else _KIND_ADAPTIVE_AVG,
+                                  s[].ctx_serial, mode, from_default, True, backward_ok, a_dims^, saved^, a_out^,
+                                  pool_run_m(a_dev, a_words), pool_run_m(a_dev, a_words), a_out_count, a_in_count,
+                                  Int(layer._obj_ptr), Int(inner._obj_ptr), inner_stamp, 0, 0, 0, 0, 0, 0)
+    if a_maxed:
+        _typed_set_winners(a_record, a_win)
+    _typed_store(s, a_record^)
+    _ = inner
+    _ = layer
+    _ = fields
+    _ = cls
+
+
+def xcnn_pool_typed_learn(model: PythonObject, operation: PythonObject, context: PythonObject):
+    """After the door answered `operation` for `model`: keep (or refresh) the
+    layer's typed record when the call was one the typed route covers. Never
+    raises and never changes what the call returns; a state it cannot read
+    strictly leaves no record."""
+    try:
+        _typed_learn(model, operation, context)
+    except:
+        try:
+            cpython_table()[].PyErr_Clear()
+        except:
+            pass
+
+
+# ---------------------------------------------------------------- the typed call (per call)
+
+def _typed_slot(t: UnsafePointer[CPythonTable, MutAnyOrigin], owner: PyObjectPtr, name: PyObjectPtr) raises -> PyObjectPtr:
+    """One storage slot of an admitted `DeviceTensor` (a new reference), or
+    null with no error set when the slot holds nothing."""
+    var value = t[].PyObject_GenericGetAttr(owner, name)
+    if not value:
+        t[].PyErr_Clear()
+    return value
+
+
+def _typed_tensor_handle(t: UnsafePointer[CPythonTable, MutAnyOrigin],
+                         s: UnsafePointer[XcnnTyped, MutUntrackedOrigin], x: PyObjectPtr, dims: List[Int],
+                         module: PyObjectPtr) raises -> Int:
+    """UNPACK a tensor of the connected class: its resident handle when its
+    shape is exactly `dims` (an exact tuple of exact ints), its handle is an
+    exact positive int and its binding is `module`; 0 otherwise (the door
+    then answers, with its own refusals). The checks of
+    `_xcnn_tensor_admit_raw` and `xcnn_on_dev`, on three pointer reads."""
+    ref cpy = Python().cpython()
+    var tuple_class = s[].held[_H_TUPLE]._obj_ptr
+    var int_class = s[].held[_H_INT]._obj_ptr
+    var shape = _typed_slot(t, x, s[].names[_N_SHAPE]._obj_ptr)
+    if not shape:
+        return 0
+    var shape_owner = PythonObject(from_owned=shape)
+    if PyObjectPtr(upcast_from=cpy.Py_TYPE(shape)) != tuple_class or t[].PyTuple_Size(shape) != len(dims):
+        return 0
+    for i in range(len(dims)):  # driver-loop: over the tensor's shape words
+        var item = t[].PyTuple_GetItem(shape, i)
+        if PyObjectPtr(upcast_from=cpy.Py_TYPE(item)) != int_class:
+            return 0
+        var word = t[].PyLong_AsLongLong(item)
+        if Int(word) != dims[i]:
+            if word == -1 and cpy.PyErr_Occurred():
+                t[].PyErr_Clear()
+            return 0
+    _ = shape_owner  # the tuple outlives the reads of its items above
+    var bound = _typed_slot(t, x, s[].names[_N_B]._obj_ptr)
+    if not bound:
+        return 0
+    var bound_owner = PythonObject(from_owned=bound)
+    if bound != module:
+        return 0
+    _ = bound_owner
+    var handle = _typed_slot(t, x, s[].names[_N_H]._obj_ptr)
+    if not handle:
+        return 0
+    var handle_owner = PythonObject(from_owned=handle)
+    if PyObjectPtr(upcast_from=cpy.Py_TYPE(handle)) != int_class:
+        return 0
+    var raw = t[].PyLong_AsLongLong(handle)
+    if raw == -1 and cpy.PyErr_Occurred():
+        t[].PyErr_Clear()
+        return 0
+    _ = handle_owner
+    if Int(raw) < 1:
+        return 0
+    return Int(raw)
+
+
+def _typed_tensor(t: UnsafePointer[CPythonTable, MutAnyOrigin], s: UnsafePointer[XcnnTyped, MutUntrackedOrigin],
+                  tensor_class: PythonObject, module: PythonObject, dims: List[Int], handle: Int) raises -> PythonObject:
+    """PACK: `DeviceTensor(binding, shape, h, None, None)` with its five
+    slots set through the interned names (`_xcnn_tensor_raw`: the same
+    object, the same slot values)."""
+    ref cpy = Python().cpython()
+    var raw = t[].PyType_GenericAlloc(tensor_class._obj_ptr, Int(0))
+    if not raw:
+        raise cpy.unsafe_get_error()
+    var result = PythonObject(from_owned=raw)
+    var shape = xcnn_tuple(dims)
+    var word = t[].PyLong_FromLongLong(Int64(handle))
+    if not word:
+        raise cpy.unsafe_get_error()
+    var h = PythonObject(from_owned=word)
+    var none = s[].held[_H_NONE]._obj_ptr
+    if t[].PyObject_GenericSetAttr(raw, s[].names[_N_B]._obj_ptr, module._obj_ptr) < 0:
+        raise cpy.unsafe_get_error()
+    if t[].PyObject_GenericSetAttr(raw, s[].names[_N_SHAPE]._obj_ptr, shape._obj_ptr) < 0:
+        raise cpy.unsafe_get_error()
+    if t[].PyObject_GenericSetAttr(raw, s[].names[_N_H]._obj_ptr, h._obj_ptr) < 0:
+        raise cpy.unsafe_get_error()
+    if t[].PyObject_GenericSetAttr(raw, s[].names[_N_HOST]._obj_ptr, none) < 0:
+        raise cpy.unsafe_get_error()
+    if t[].PyObject_GenericSetAttr(raw, s[].names[_N_BASE]._obj_ptr, none) < 0:
+        raise cpy.unsafe_get_error()
+    _ = shape
+    _ = h
+    return result
+
+
+def xcnn_pool_typed_call(args: PyObjectPtr) raises -> PyObjectPtr:
+    """`xcnn_native_call(layer, operation, (x,), context)` answered from the
+    typed tables, or null (no error set, nothing changed) when this call is
+    not one a valid record covers; the caller then runs the door. Raises
+    only after the launch began, exactly where the door would."""
+    var s = XCNN_TYPED.get_or_create_ptr()
+    if not s[].ctx_ok:
+        return PyObjectPtr()
+    var t = cpython_table()
+    if t[].PyTuple_Size(args) != 4:
+        return PyObjectPtr()
+    var context = t[].PyTuple_GetItem(args, 3)
+    if context != s[].held[_H_CONTEXT]._obj_ptr:
+        return PyObjectPtr()
+    var op = t[].PyTuple_GetItem(args, 1)
+    var which = -1
+    for i in range(4):  # driver-loop: over the four typed operations (pointer compares)
+        if s[].ops_known[i] and op == s[].ops[i]._obj_ptr:
+            which = i
+            break
+    if which < 0:
+        return PyObjectPtr()
+
+    # ---- the typed context's stamps
+    var w = SHARED_DICT_WATCH.get_or_create_ptr()
+    var cw = CLASS_WATCH.get_or_create_ptr()
+    if _dict_epoch(w, Int(context)) != s[].context_epoch:
+        return PyObjectPtr()
+    if _dict_epoch(w, Int(s[].held[_H_BINDINGS]._obj_ptr)) != s[].bindings_epoch:
+        return PyObjectPtr()
+    var tensor_ptr = s[].held[_H_TENSOR]._obj_ptr
+    if _class_epoch_at(cw, Int(tensor_ptr)) != s[].tensor_epoch:
+        return PyObjectPtr()
+
+    # ---- the layer's record
+    var model = t[].PyTuple_GetItem(args, 0)
+    var raw_fields = t[].PyObject_GenericGetDict(model, PyObjectPtr())
+    if not raw_fields:
+        t[].PyErr_Clear()
+        return PyObjectPtr()
+    var fields_owner = PythonObject(from_owned=raw_fields)
+    var slot = s[].index.find(Int(raw_fields))
+    if not slot:
+        return PyObjectPtr()
+    ref rec = s[].records[slot.value()]
+    if rec.fields != Int(raw_fields) or rec.ctx_serial != s[].ctx_serial:
+        return PyObjectPtr()
+    if rec.stamp != _dict_epoch(w, rec.fields):
+        return PyObjectPtr()
+    ref cpy = Python().cpython()
+    if Int(PyObjectPtr(upcast_from=cpy.Py_TYPE(model))) != rec.cls or _class_epoch_at(cw, rec.cls) != rec.cls_epoch:
+        return PyObjectPtr()
+    var backward = which == _OP_ADAPTIVE_BACKWARD or which == _OP_POOL_BACKWARD
+    var adaptive = which == _OP_ADAPTIVE_FORWARD or which == _OP_ADAPTIVE_BACKWARD
+    var maxed = (rec.kind == _KIND_MAX_2D or rec.kind == _KIND_MAX_1D or rec.kind == _KIND_ADAPTIVE_MAX
+                 or rec.kind == _KIND_ADAPTIVE_MAX_K)
+    var kernel = rec.kind == _KIND_ADAPTIVE_AVG_K or rec.kind == _KIND_ADAPTIVE_MAX_K
+    if adaptive != (rec.kind == _KIND_ADAPTIVE_AVG or rec.kind == _KIND_ADAPTIVE_MAX or kernel):
+        return PyObjectPtr()
+    if maxed != (rec.win_handle != 0):
+        return PyObjectPtr()
+    if backward and not rec.backward_ok:
+        return PyObjectPtr()
+    if not s[].modes[rec.mode].ok:
+        return PyObjectPtr()
+    if _dict_epoch(w, Int(s[].modes[rec.mode].entries._obj_ptr)) != s[].modes[rec.mode].epoch:
+        return PyObjectPtr()
+    if rec.from_default:
+        var current = t[].PyDict_GetItemWithError(s[].held[_H_BACKEND]._obj_ptr, s[].names[_N_DEFAULT_MODE]._obj_ptr)
+        if current != s[].held[_H_DEFAULT]._obj_ptr:
+            if not current:
+                t[].PyErr_Clear()
+            return PyObjectPtr()
+    if rec.inner_layer != 0:
+        # the inner pool the outer dictionary still holds (its stamp above):
+        # its own dictionary unchanged and its class still the pool class
+        if _dict_epoch(w, rec.inner_fields) != rec.inner_stamp:
+            return PyObjectPtr()
+        var inner_class = s[].held[_H_AVGPOOL]._obj_ptr
+        if maxed:
+            inner_class = s[].held[_H_MAXPOOL]._obj_ptr
+        if PyObjectPtr(upcast_from=cpy.Py_TYPE(_borrowed(rec.inner_layer))) != inner_class:
+            return PyObjectPtr()
+    if maxed:
+        # the winners' owner the pool's dictionary still holds (the layer's
+        # stamp, or the inner pool's, above): still of the connected owner
+        # class, its instance dictionary the recorded one and unchanged, and
+        # its handle table unchanged (so the table still names the recorded
+        # handle with the recorded size)
+        var owner = _borrowed(rec.owner)
+        if PyObjectPtr(upcast_from=cpy.Py_TYPE(owner)) != s[].held[_H_DEV]._obj_ptr:
+            return PyObjectPtr()
+        var owner_dict = t[].PyObject_GenericGetDict(owner, PyObjectPtr())
+        if not owner_dict:
+            t[].PyErr_Clear()
+            return PyObjectPtr()
+        var owner_dict_owner = PythonObject(from_owned=owner_dict)
+        if Int(owner_dict) != rec.owner_fields or _dict_epoch(w, rec.owner_fields) != rec.owner_stamp:
+            return PyObjectPtr()
+        if _dict_epoch(w, rec.table) != rec.table_stamp:
+            return PyObjectPtr()
+        _ = owner_dict_owner
+
+    # ---- UNPACK the one argument: a resident tensor of this binding
+    var call_args = t[].PyTuple_GetItem(args, 2)
+    if PyObjectPtr(upcast_from=cpy.Py_TYPE(call_args)) != s[].held[_H_TUPLE]._obj_ptr:
+        return PyObjectPtr()
+    if t[].PyTuple_Size(call_args) != 1:
+        return PyObjectPtr()
+    var x = t[].PyTuple_GetItem(call_args, 0)
+    if PyObjectPtr(upcast_from=cpy.Py_TYPE(x)) != tensor_ptr:
+        return PyObjectPtr()
+    var module = s[].modes[rec.mode].module
+    var source = 0
+    if backward:
+        source = _typed_tensor_handle(t, s, x, rec.out_dims, module._obj_ptr)
+    else:
+        source = _typed_tensor_handle(t, s, x, rec.x_dims, module._obj_ptr)
+    if source == 0:
+        return PyObjectPtr()
+
+    # ---- everything the launch needs, copied out of the tables before the
+    # GIL is released (another thread may refill them meanwhile)
+    var entry = s[].modes[rec.mode].entry
+    var ints = rec.ints_back.copy() if backward else rec.ints.copy()
+    var winners = rec.win_handle
+    var dims = List[Int]()
+    if backward:
+        dims = rec.saved.copy()
+    else:
+        dims = rec.out_dims.copy()
+    var count = rec.in_count if backward else rec.out_count
+    var alloc_op = XC_RES_ALLOC_NOFILL if rec.nofill else XC_RES_ALLOC
+    var run_op = XC_AVGPOOL2D_BACKWARD_M if backward else XC_AVGPOOL2D_FORWARD_M
+    if kernel:
+        run_op = XC_ADAPTIVE_POOL_M
+    elif maxed:
+        run_op = XC_MAXPOOL2D_BACKWARD_M if backward else XC_MAXPOOL2D_FORWARD_M
+    var tensor_class = s[].held[_H_TENSOR]
+    _ = fields_owner  # the layer's dictionary stayed alive through the record reads above
+
+    # ---- RUN and PACK: the door's order (allocate, make the tensor, launch)
+    var py = Python()
+    var handle = 0
+    with GILReleased(py):
+        handle = xcnn_run_call(entry, alloc_op, List[Int](), [count])
+    var result = _typed_tensor(t, s, tensor_class, module, dims, handle)
+    # The door's address order: the adaptive kernel (x, y, winners or 0) both
+    # ways; a max pool (x, y, winners) forward and (g, winners, dx) backward;
+    # an average pool (x, y).
+    if kernel or maxed:
+        var second = handle
+        var third = winners
+        if maxed and backward and not kernel:
+            second = winners
+            third = handle
+        var req_three: Array[Int, 3] = [source, second, third]
+        with GILReleased(py):
+            _ = xcnn_run_fixed(entry, run_op, req_three, ints)
+    else:
+        var req_addrs: Array[Int, 2] = [source, handle]
+        with GILReleased(py):
+            _ = xcnn_run_fixed(entry, run_op, req_addrs, ints)
+    _ = module
+    _ = tensor_class
+    return result.steal_data()
