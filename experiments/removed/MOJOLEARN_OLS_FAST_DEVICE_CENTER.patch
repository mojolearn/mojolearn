+    var n = d + 1
+    var t = Int(block_idx.x) * Int(block_dim.x) + Int(thread_idx.x)
+    if t >= Int(n_rows_in) * n:
+        return
+    var i = t // n
+    var c = t - i * n
+    if c < d:
+        dst.unsafe_store(t, x.unsafe_load(i * d + c) - mu.unsafe_load(c))
+    else:
