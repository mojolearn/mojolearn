+# SPDX-License-Identifier: Apache-2.0
+"""NI13 parked source-only immutable-generation packing helper.
+
+The incumbent CNN forward consumes OC-by-K weights through GEMM OP_NT and
+does not repack them each call. A future owning model can use this helper's
+K-by-OC layout with OP_NN when coalescing makes that worthwhile. There is no
+invented existing repacking cost and no measured speedup. The current idea is
+rejected by source reasoning: a cache cannot remove a repack that the current
+route does not perform. This helper is retained only for a separately justified
+future packed-layout consumer with explicit owner and mutation generations.
+"""
+from std.gpu import block_idx, block_dim, thread_idx
+from std.sys.compile import is_defined
+from max.gpu.host import DeviceBuffer, DeviceContext
+from checks.numerics import GLOBAL_NUMERIC_MODE, NUMERIC_IDENTICAL
+
+comptime NI13_GENERATION_CACHE = (
+    GLOBAL_NUMERIC_MODE == NUMERIC_IDENTICAL
+    and is_defined["MOJOLEARN_NI13_CNN_WEIGHT_GENERATION_CACHE"]()
+    and not is_defined["MOJOLEARN_IDN_ALL_OFF"]()
+)
+
+
+def _pack_weight_transpose(
+    src: MutPointer[Float32, MutAnyOrigin], dst: MutPointer[Float32, MutAnyOrigin],
+    oc_in: Int32, k_in: Int32,
+):
+    var i = Int(block_idx.x) * Int(block_dim.x) + Int(thread_idx.x)
+    var oc = Int(oc_in); var k = Int(k_in)
+    if i >= oc * k:
+        return
+    var tap = i // oc; var channel = i - tap * oc
+    # Layout transport must preserve signed zero, subnormals and NaN bits.
+    dst.bitcast[Int32]().unsafe_store(i, src.bitcast[Int32]().unsafe_load(channel * k + tap))
+
+
+struct NeuralWeightGenerationCache(Movable):
+    """One owner/one in-order context; generations are supplied by the model.
+
+    `prepare` is asynchronous. The owner keeps source and this object alive
+    through its last consuming GEMM and synchronization. `buffer` contains
+    K-by-OC words after preparation; use OP_NN for the otherwise unchanged
+    canonical contraction. An optimizer update, refit or mutation must bump
+    generation. Pointer identity alone is deliberately never a cache key.
+    """
+    var buffer: DeviceBuffer[DType.float32]
+    var owner: UInt64
+    var generation: UInt64
+    var channels: Int
+    var taps: Int
+    var valid: Bool
+
+    def __init__(out self, ctx: DeviceContext) raises:
+        self.buffer = ctx.enqueue_create_buffer[DType.float32](1)
+        self.owner = 0
+        self.generation = 0
+        self.channels = 0
+        self.taps = 0
+        self.valid = False
+
+    def invalidate(mut self):
+        self.valid = False
+
+    def prepare(
+        mut self, ctx: DeviceContext, mut source: DeviceBuffer[DType.float32],
+        owner: UInt64, generation: UInt64, channels: Int, taps: Int,
+    ) raises:
+        if channels < 1 or taps < 1 or len(source) < channels * taps:
+            raise Error("NI13 invalid convolution weight geometry")
+        comptime if NI13_GENERATION_CACHE:
+            if (self.valid and self.owner == owner and self.generation == generation
+                and self.channels == channels and self.taps == taps):
+                return
+        # Invalidate before a potentially failing allocation/enqueue. A
+        # failed refresh can never authorize reuse of the preceding words.
+        self.valid = False
+        if len(self.buffer) < channels * taps:
+            ctx.synchronize()
+            self.buffer = ctx.enqueue_create_buffer[DType.float32](channels * taps)
+        ctx.enqueue_function[_pack_weight_transpose](
+            source.unsafe_ptr(), self.buffer.unsafe_ptr(), Int32(channels), Int32(taps),
+            grid_dim=((channels * taps + 255) // 256, 1, 1), block_dim=(256, 1, 1),
+        )
+        self.owner = owner
+        self.generation = generation
+        self.channels = channels
+        self.taps = taps
+        self.valid = True
+
+    def close(mut self, ctx: DeviceContext) raises:
+        ctx.synchronize()
+        self.valid = False
+        self.buffer = ctx.enqueue_create_buffer[DType.float32](1)
