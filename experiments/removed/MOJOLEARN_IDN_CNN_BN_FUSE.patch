+@always_inline
+def bn_blk_red_relu_val(t: Int, x: FP, g: FP, mask: FP, aux: FP, part: FP, p: IP):
+    """`bn_blk_red_at` on g' = relu_bwd(mask, g) (block t's two chains)."""
+    var N = _g(p, 0); var C = _g(p, 1); var HW = _g(p, 2)
+    var count = N * HW
+    var B = bn_fold_block(count)
+    var NB = bn_fold_blocks(count)
+    var c = t // NB
+    var j = (t - c * NB) * B
+    var j1 = min(j + B, count)
+    var a = j // HW
+    var k = j - a * HW
