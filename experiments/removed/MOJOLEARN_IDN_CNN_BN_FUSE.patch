+@always_inline
+def bn_apply_relu_at(i: Int, x: FP, aux: FP, dst: FP, f3: FP, q: IP, p: IP):
+    """dst = relu(bn(x)): `relu_fwd_at` on `bn_apply_at`'s word (already
+    flushed, so `relu_val(ftz(v))` is `relu_val(v)`)."""
+    dst.unsafe_store(i, relu_val(ftz(bn_apply_val(i, x, aux, p))))
+
+
+@always_inline
+def bn_apply_add_val(i: Int, x: FP, aux: FP, addend: FP, p: IP) -> Float32:
+    """`add_at`'s word for (bn(x), addend): canon(ftz(ftz(a) + ftz(b)))."""
+    return canon(ftz(ftz(bn_apply_val(i, x, aux, p)) + ftz(addend.unsafe_load(i))))
