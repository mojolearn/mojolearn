+            ctx.enqueue_function[bn_bwd_dx_relu_kernel](
+                fp(dx), fp(dg), fp(dmask), fp(da), fp(dout), ip(dp), Int32(total), Int32(1 if training else 0),
+                grid_dim=((total + TPB - 1) // TPB, 1, 1), block_dim=(TPB, 1, 1),
+            )
