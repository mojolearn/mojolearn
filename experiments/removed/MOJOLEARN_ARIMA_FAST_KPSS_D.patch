+        var lrv_tot = _block_sum(sh, tid, lrv)
+        var stat = s2_tot / (Float32(n) * lrv_tot)
+        var pv = _kpss_pvalue(stat)
+        var dodiff = pv == pv and pv < KD_ALPHA
+        if not dodiff or dd >= d_max:
+            break
+        dd += 1
