+    var ctx = DeviceContext()
+    var rows = gemm_step_env_int("AB_ROWS", 100000)
+    var features = gemm_step_env_int("AB_FEATURES", 32)
+    run_arm(ctx, "N07-warmup", rows, features, 128, False, False, False, 1)
