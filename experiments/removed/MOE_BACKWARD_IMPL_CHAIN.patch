+    var DX = ex.alloc(T * D)
+    var DWg = ex.alloc(En * D)
+    var DGu = ex.alloc(En * 2 * F * D)
+    var DDn = ex.alloc(En * D * F)
+    var Y = ex.alloc(T * D)
+    var L = ex.alloc(T * En)
+    var Sel = ex.alloc(T * k)
+    var W = ex.alloc(T * k)
