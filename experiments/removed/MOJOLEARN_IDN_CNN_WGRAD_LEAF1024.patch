+def _implicit_dx(
+    ctx: DeviceContext, mut gx: DeviceBuffer[DType.float32], mut g: DeviceBuffer[DType.float32],
+    mut w: DeviceBuffer[DType.float32], mut dp: DeviceBuffer[DType.int32], N: Int, C: Int, HW: Int, OC: Int, KK: Int,
