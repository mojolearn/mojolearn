+    ctx.enqueue_function[implicit_dx_kernel](
+        fp(g), fp(w), fp(gx), ip(dp), Int32(rows), Int32(lp[0]), Int32(lp[1]),
+        grid_dim=((rows + NI12_TM - 1) // NI12_TM, (C + NI12_TN - 1) // NI12_TN, 1),
+        block_dim=(NI12_THREADS, 1, 1),
+    )
+
