+            acc = ftz(
+                identical_mul_add(
+                    ftz(xbc.unsafe_load(ti * cd + di + M2_D_STATE + n)),  # C
+                    ftz(xbc.unsafe_load(tj * cd + di + n)),  # B
+                    acc,
+                )
