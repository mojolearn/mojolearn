+    var acc = Float32(0.0)
+    var live = i < real and j < real
+    comptime if IDN_M2_CB_LOWER:
+        # B9: above the diagonal is never read; explicit +0.0 (below).
+        live = live and j <= i
+    if live:
+        var ti = bb * t_work + c0 + i
+        var tj = bb * t_work + c0 + j
