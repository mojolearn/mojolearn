+def nn37_m2_cb_triangle_kernel(
+    cb_g: MutPointer[Float32, MutAnyOrigin],  # [B, C, Q, Q]
+    xbc: MutPointer[Float32, MutAnyOrigin],  # [B, T, CD]
+    b_in: Int32,
