+    while low + 1 < high:
+        var mid = (low + high) // 2
+        if mid * (mid + 1) // 2 <= packed:
+            low = mid
+        else:
+            high = mid
+    var i = low
+    var j = packed - i * (i + 1) // 2
+    var c0 = c * qv
+    var real = t_work - c0
