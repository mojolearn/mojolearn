+        grid_dim=(QN_GS_BLOCKS, 1, 1), block_dim=(QN_GS_TPB, 1, 1),
+    )
+    ctx.enqueue_function[qn_grid_sum_fold_kernel](
+        out_v, ws.unsafe_ptr(), scale,
+        grid_dim=(1, 1, 1), block_dim=(QN_GS_TPB, 1, 1),
+    )
