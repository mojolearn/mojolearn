+def scan_block_sums_u32_parallel_kernel(
+    block_sums: MutPointer[UInt32, MutAnyOrigin], n_blocks_in: Int32
+):
+    """Phase 2 with `SCAN_SUMS_BLOCK_U32` threads in ONE block
