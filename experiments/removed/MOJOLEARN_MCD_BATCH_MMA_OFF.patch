+    hinv: Float32, active: I32Ptr,
+):
+    var t = Int(block_idx.x) * MF_TPB + Int(thread_idx.x)
+    var np = Int(npair)
+    if t < Int(nc) * np:
+        var c = t // np
+        var q = t - c * np
