+def _separate(a: Int, an: Int, b: Int, bn: Int) -> Bool:
+    # Native program metadata only. Missing optional regions are disjoint.
+    return a < 0 or b < 0 or an <= 0 or bn <= 0 or a + an <= b or b + bn <= a
