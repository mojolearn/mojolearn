+                if _join_case[GEMM_EPI_C_PLUS_CELL](ctx, tally, m, n, k, OP_NT):
+                    ran += 1
+                if _join_case[GEMM_EPI_CELL_PLUS_C](ctx, tally, m, n, k, OP_TN):
+                    ran += 1
+                if grouped:
