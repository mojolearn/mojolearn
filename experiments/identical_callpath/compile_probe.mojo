# SPDX-License-Identifier: Apache-2.0
"""Compile-only coverage of every typed bank and all seven current adapters.

Build with IDENTICAL and experimental callpath enabled on each GPU target.
This is not an identity or performance gate; do not execute on a host laptop.
"""
from core.identical_callpath import IdenticalCallSession
from experiments.identical_callpath.minmax import ResidentIdenticalMinMax
from experiments.identical_callpath.standard import ResidentIdenticalStandard
from experiments.identical_callpath.families import (
    enqueue_row_norms, enqueue_column_means, enqueue_shift_columns,
    enqueue_core_gemm_nt, enqueue_identical_gemm,
)
from gemm.checks.gemm_identical import identical_gemm_workspace_max_floats
from gemm.checks.gemm_oracle import OP_NT


def main() raises:
    var session = IdenticalCallSession()
    var slot_f32 = session.reserve_f32(1)
    var data_f32 = List[Scalar[DType.float32]](length=1, fill=Scalar[DType.float32](1))
    session.stage_f32(slot_f32, data_f32)
    session.begin()
    session.upload_f32(slot_f32)
    session.readback_f32(slot_f32)
    session.finish()
    session.collect_f32(slot_f32, data_f32)
    var slot_f64 = session.reserve_f64(1)
    var data_f64 = List[Scalar[DType.float64]](length=1, fill=Scalar[DType.float64](1))
    session.stage_f64(slot_f64, data_f64)
    session.begin()
    session.upload_f64(slot_f64)
    session.readback_f64(slot_f64)
    session.finish()
    session.collect_f64(slot_f64, data_f64)
    var slot_f16 = session.reserve_f16(1)
    var data_f16 = List[Scalar[DType.float16]](length=1, fill=Scalar[DType.float16](1))
    session.stage_f16(slot_f16, data_f16)
    session.begin()
    session.upload_f16(slot_f16)
    session.readback_f16(slot_f16)
    session.finish()
    session.collect_f16(slot_f16, data_f16)
    var slot_bf16 = session.reserve_bf16(1)
    var data_bf16 = List[Scalar[DType.bfloat16]](length=1, fill=Scalar[DType.bfloat16](1))
    session.stage_bf16(slot_bf16, data_bf16)
    session.begin()
    session.upload_bf16(slot_bf16)
    session.readback_bf16(slot_bf16)
    session.finish()
    session.collect_bf16(slot_bf16, data_bf16)
    var slot_i8 = session.reserve_i8(1)
    var data_i8 = List[Scalar[DType.int8]](length=1, fill=Scalar[DType.int8](1))
    session.stage_i8(slot_i8, data_i8)
    session.begin()
    session.upload_i8(slot_i8)
    session.readback_i8(slot_i8)
    session.finish()
    session.collect_i8(slot_i8, data_i8)
    var slot_i16 = session.reserve_i16(1)
    var data_i16 = List[Scalar[DType.int16]](length=1, fill=Scalar[DType.int16](1))
    session.stage_i16(slot_i16, data_i16)
    session.begin()
    session.upload_i16(slot_i16)
    session.readback_i16(slot_i16)
    session.finish()
    session.collect_i16(slot_i16, data_i16)
    var slot_i32 = session.reserve_i32(1)
    var data_i32 = List[Scalar[DType.int32]](length=1, fill=Scalar[DType.int32](1))
    session.stage_i32(slot_i32, data_i32)
    session.begin()
    session.upload_i32(slot_i32)
    session.readback_i32(slot_i32)
    session.finish()
    session.collect_i32(slot_i32, data_i32)
    var slot_i64 = session.reserve_i64(1)
    var data_i64 = List[Scalar[DType.int64]](length=1, fill=Scalar[DType.int64](1))
    session.stage_i64(slot_i64, data_i64)
    session.begin()
    session.upload_i64(slot_i64)
    session.readback_i64(slot_i64)
    session.finish()
    session.collect_i64(slot_i64, data_i64)
    var slot_u8 = session.reserve_u8(1)
    var data_u8 = List[Scalar[DType.uint8]](length=1, fill=Scalar[DType.uint8](1))
    session.stage_u8(slot_u8, data_u8)
    session.begin()
    session.upload_u8(slot_u8)
    session.readback_u8(slot_u8)
    session.finish()
    session.collect_u8(slot_u8, data_u8)
    var slot_u16 = session.reserve_u16(1)
    var data_u16 = List[Scalar[DType.uint16]](length=1, fill=Scalar[DType.uint16](1))
    session.stage_u16(slot_u16, data_u16)
    session.begin()
    session.upload_u16(slot_u16)
    session.readback_u16(slot_u16)
    session.finish()
    session.collect_u16(slot_u16, data_u16)
    var slot_u32 = session.reserve_u32(1)
    var data_u32 = List[Scalar[DType.uint32]](length=1, fill=Scalar[DType.uint32](1))
    session.stage_u32(slot_u32, data_u32)
    session.begin()
    session.upload_u32(slot_u32)
    session.readback_u32(slot_u32)
    session.finish()
    session.collect_u32(slot_u32, data_u32)
    var slot_u64 = session.reserve_u64(1)
    var data_u64 = List[Scalar[DType.uint64]](length=1, fill=Scalar[DType.uint64](1))
    session.stage_u64(slot_u64, data_u64)
    session.begin()
    session.upload_u64(slot_u64)
    session.readback_u64(slot_u64)
    session.finish()
    session.collect_u64(slot_u64, data_u64)
    var left = session.reserve_f32(4)
    var right = session.reserve_f32(4)
    var result = session.reserve_f32(4)
    var norms = session.reserve_f32(2)
    var means = session.reserve_f32(2)
    var scratch = session.reserve_f32(identical_gemm_workspace_max_floats(2, 2, 2))
    var matrix: List[Float32] = [1.0, 2.0, 3.0, 4.0]
    session.stage_f32(left, matrix)
    session.stage_f32(right, matrix)
    session.begin()
    session.upload_f32(left)
    session.upload_f32(right)
    enqueue_row_norms(session, norms, left, 2, 2)
    enqueue_column_means(session, means, left, 2, 2)
    enqueue_shift_columns(session, left, means, 2, 2)
    enqueue_core_gemm_nt(session, result, left, right, 2, 2, 2)
    enqueue_identical_gemm(session, result, left, right, scratch, 2, 2, 2, OP_NT)
    session.readback_f32(result)
    session.finish()
    session.collect_f32(result, matrix)
    session.abort()

    var scales: List[Float32] = [1.0, 2.0]
    var offsets: List[Float32] = [0.0, 0.0]
    var inputs = List[List[Float32]]()
    inputs.append(matrix.copy())
    var results = List[List[Float32]]()
    results.append(matrix.copy())
    var minmax = ResidentIdenticalMinMax(2, 2, 1, scales, offsets)
    minmax.transform_batch_into(inputs, results, 0, 0, 0.0, 1.0, False)
    minmax.transform_batch_into(inputs, results, 1, 1, 0.0, 1.0, True)
    var standard = ResidentIdenticalStandard(2, 2, 1, offsets, scales)
    standard.transform_batch_into(inputs, results, 0, 1, 1, False)
    standard.transform_batch_into(inputs, results, 1, 0, 0, True)
