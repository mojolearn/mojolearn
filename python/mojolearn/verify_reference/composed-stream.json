    },
    {
     "op": "make",
     "cls": "ops.BatchSource",
     "args": [
      "@root",
      2
     ],
     "kw": {
      "inputs": {
       "tuple": [
        "steps"
       ]
      },
      "target": "targets",
      "shuffle": true,
      "seed": 5,
      "bucket_batches": 2
     },
     "as": "sa"
    },
    {
     "op": "make",
     "cls": "GRURegressor",
     "kw": {
      "hidden_size": 4,
      "output": "sequence",
