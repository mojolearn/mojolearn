       ],
       "as": "lh"
      },
      {
       "op": "call",
       "fn": "s.sequence_mask",
       "args": [
        "@lh",
        4
       ],
       "as": "m"
      },
      {
       "op": "call",
       "fn": "s.tensor",
       "args": [
        "@pred"
       ],
       "kw": {
        "requires_grad": true
       },
       "as": "p"
      },
      {
       "op": "call",
       "fn": "s.tensor",
       "args": [
        "@target"
