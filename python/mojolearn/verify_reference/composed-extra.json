       4
      ]
     ],
     "what": "row 0 past length 1"
    },
    {
     "op": "zero",
     "of": "@g",
     "index": [
      1
     ],
     "what": "row 1, length 0"
    },
    {
     "op": "zero",
     "of": "@g",
