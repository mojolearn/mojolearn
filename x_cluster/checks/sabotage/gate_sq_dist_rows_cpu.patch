diff --git a/x_cluster/bodies.mojo b/x_cluster/bodies.mojo
index 5cce4978af..74fb6bbfa6 100644
--- a/x_cluster/bodies.mojo
+++ b/x_cluster/bodies.mojo
@@ -42,6 +42,13 @@ def sq_dist_rows[REV: Bool = False](a: FPtr, i: Int, b: FPtr, j: Int, d: Int) ->
         var f = d - 1 - q if REV else q
         var t = ftz(ftz(a[i * d + f]) - ftz(b[j * d + f]))
         acc = ftz(acc + ftz(identical_mul(t, t)))
+    from std.sys import is_defined
+    from std.memory import bitcast
+    comptime if is_defined["MOJOLEARN_COLUMN_CPU"]():  # SABOTAGE gate-cpu (lane vdv-sabotage): the result one ulp up, the host bindings only
+        var h = acc
+        if abs(h) >= Float32(1.17549435e-38) and h - h == Float32(0):
+            return bitcast[DType.float32](bitcast[DType.uint32](h) + UInt32(1))
+        return h
     return acc
 
 
diff --git a/x_cluster/host/host_ops.mojo b/x_cluster/host/host_ops.mojo
index 906adc866d..ae12630d5d 100644
--- a/x_cluster/host/host_ops.mojo
+++ b/x_cluster/host/host_ops.mojo
@@ -117,6 +117,11 @@ def _sq_dists8(pa: FPtr, i: Int, d: Int, btp: FPtr, mp: Int, j0: Int) -> SIMD[DT
         var av = SIMD[DType.float32, DIST_W](ftz(pa[i * d + f]))
         var t = ftz_v[DIST_W](av - (btp + f * mp + j0).load[width=DIST_W]())
         acc = ftz_v[DIST_W](acc + ftz_v[DIST_W](mul_v[DIST_W](t, t)))
+    comptime if is_defined["MOJOLEARN_COLUMN_CPU"]():  # SABOTAGE gate-cpu (lane w3-fix-9-s4): sq_dist_rows' SIMD host twin one ulp up per lane, the host bindings only
+        for l in range(DIST_W):
+            var h = acc[l]
+            if abs(h) >= Float32(1.17549435e-38) and h - h == Float32(0):
+                acc[l] = bitcast[DType.float32](bitcast[DType.uint32](h) + UInt32(1))
     return acc
 
 
