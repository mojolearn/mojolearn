def xn_operation(op: Int, a: List[Int], p: List[Int], f: List[Float64]) raises -> Int:
    if op == 0:
        return xn_native_sqdist(a, p, f)
    if op == 1:
        return xn_native_l1dist(a, p, f)
    if op == 2:
        return xn_native_kernel(a, p, f)
    if op == 3:
        return xn_native_matmul(a, p, f)
    if op == 4:
        return xn_native_rowsum(a, p, f)
    if op == 5:
        return xn_native_colsum(a, p, f)
    if op == 6:
        return xn_native_unary(a, p, f)
    if op == 7:
        return xn_native_knn_select(a, p, f)
    if op == 8:
        return xn_native_knn_sq(a, p, f)
    if op == 9:
        return xn_native_group_mean(a, p, f)
    if op == 10:
        return xn_native_take_rows(a, p, f)
    if op == 11:
        return xn_native_take_cols(a, p, f)
    if op == 12:
        return xn_native_variance(a, p, f)
    if op == 13:
        return xn_native_lof_lrd(a, p, f)
    if op == 14:
        return xn_native_lof_score(a, p, f)
    if op == 15:
        return xn_native_kpca_center(a, p, f)
    if op == 16:
        return xn_native_scale_div(a, p, f)
