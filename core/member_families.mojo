def member_table_resolve(family: Int, mode: Int, vendor: Int, absent: NativeDescriptorCall) raises -> EntryRef:
    """`member_table[family, 0]` for a family number known only at run time
    (a caller that read it from the member's class). `absent` is any entry
    pointer; a resolution does not read it."""
    if family == MEMBER_FAMILY_LINEAR:
        return member_table[MEMBER_FAMILY_LINEAR, 0](mode, vendor, 0, absent)
    if family == MEMBER_FAMILY_LOGISTIC:
        return member_table[MEMBER_FAMILY_LOGISTIC, 0](mode, vendor, 0, absent)
    if family == MEMBER_FAMILY_XLINEAR:
        return member_table[MEMBER_FAMILY_XLINEAR, 0](mode, vendor, 0, absent)
    if family == MEMBER_FAMILY_SGD:
        return member_table[MEMBER_FAMILY_SGD, 0](mode, vendor, 0, absent)
    if family == MEMBER_FAMILY_CD:
        return member_table[MEMBER_FAMILY_CD, 0](mode, vendor, 0, absent)
    if family == MEMBER_FAMILY_LINEAR_SVM:
        return member_table[MEMBER_FAMILY_LINEAR_SVM, 0](mode, vendor, 0, absent)
