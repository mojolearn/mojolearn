 comptime _F64P = MutPointer[Float64, MutUntrackedOrigin]
 
 
+def _sab_ulp_f64(v: Float64) -> Float64:
+    """SABOTAGE (coverage-core-array_helpers_impl): one ulp off; a zero or
+    subnormal becomes the smallest positive normal."""
+    var bits = bitcast[DType.uint64](v)
+    if (bits & UInt64(0x7FFFFFFFFFFFFFFF)) < UInt64(0x0010000000000000):
+        return bitcast[DType.float64](UInt64(0x0010000000000000))
+    return bitcast[DType.float64](bits + UInt64(1))
+
+
+def _sab_ulp_f32_bits(b: UInt32) -> UInt32:
+    """SABOTAGE: the float32 bit pattern `b` one ulp off (zero/subnormal ->
+    the smallest positive normal)."""
+    if (b & UInt32(0x7FFFFFFF)) < UInt32(0x00800000):
+        return UInt32(0x00800000)
+    return b + UInt32(1)
+
