 """Typed DBSCAN core-array loops moved word for word from bindings/py2mojo_cluster_est.mojo."""
-from std.memory import memcpy
+from std.memory import bitcast, memcpy
 
 
+@always_inline
+def _cov_sab_f32(v: Float32) -> Float32:
+    """SABOTAGE (coverage arm): `v` one ulp off; a zero or subnormal becomes the smallest normal."""
+    var bits = bitcast[DType.uint32](v)
+    if (bits & UInt32(0x7FFFFFFF)) < UInt32(0x00800000):
+        return bitcast[DType.float32](UInt32(0x00800000))
+    return bitcast[DType.float32](bits + UInt32(1))
+
+
 def dbscan_core_count(cp: MutPointer[UInt8, MutUntrackedOrigin], n: Int) raises -> Int:
     var n_core = 0
