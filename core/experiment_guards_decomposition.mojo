# SPDX-License-Identifier: Apache-2.0
"""Opt-in strategy admission for the decomposition bindings (x_decomp, the manifold runtime).

Each binding of this family imports DECOMPOSITION_GUARDS_OK and asserts it in its build function, so every compile of one of
those bindings (per-binding or merged) evaluates these guards. A guard whose define is read in code by bindings
of more than one family belongs in core/six_lane_experiment_guards.mojo, which every binding reaches through
checks/numerics.mojo.
"""
from std.sys.compile import is_defined, get_defined_int
# The entries below moved verbatim, in their original order, from core/six_lane_experiment_guards.mojo on
# 2026-11-04 (lane split-hot-groups; the placement of each entry is docs/build/guard_split.json). A header comment
# that headed lines of several families is carried with each of them.


def _check_configuration() -> Bool:
    # Deleted 2026-10-08 (lane grid-losers-1): IDENTICAL grid ge123e6f9 losers (docs/apple-fast/EXPERIMENTS.md). Recoverable at main ad7ed2370.
    # C25_PROJECTION_REUSE: deleted 2026-10-08 above, restored 2026-10-10 (lane c25-restore-promote) from the tombstone patch after grid pass 2.
    comptime assert not is_defined["MOJOLEARN_CLASSICAL_RSVD_TSQR_ORTHO"](), "promoted 2026-10-10 (grid g50ebe26a5, lane/grid-act-6): the blocked TSQR orth in randomized_svd is the IDENTICAL default (randomized-svd istella NV 0.824x / AMD 0.611x, 0.710x combined; taxi NV 0.757x / AMD 0.538x, 0.638x; bits change on every column together); drop -D MOJOLEARN_CLASSICAL_RSVD_TSQR_ORTHO, use -D MOJOLEARN_CLASSICAL_RSVD_TSQR_ORTHO_OFF for the two-pass sliced Householder orth"
    # Deleted 2026-10-08 (lane grid-act-2): IDENTICAL grid ge123e6f9 losers (docs/apple-fast/EXPERIMENTS.md). Recoverable at main 42d1e42c6.
    comptime assert get_defined_int["MOJOLEARN_CLASSICAL_PCA_COV",0]() != 23, "removed: MOJOLEARN_CLASSICAL_PCA_COV=23 (C23 one-pass covariance) retired 2026-10-08: slower, pca NV 2.28x / AMD 1.27x istella, NV 0.90x / AMD 0.78x taxi, combined 1.195x (grid ge123e6f9); =4 (c04) stays; see EXPERIMENTS.md"
    comptime assert not is_defined["MOJOLEARN_CLASSICAL_PCA_COV"](), "removed 2026-10-10 (grid g50ebe26a5, lane/grid-act-6): MOJOLEARN_CLASSICAL_PCA_COV=4 (arm c04, the two-pass centered Gram read straight from X) was noise/slower: pca istella NV 1.31x / AMD 1.25x (1.281x combined), taxi NV 0.94x / AMD 0.82x (0.878x), geo-mean ~1.06x; =23 was deleted 2026-10-08; no arm remains, the incumbent covariance is the only route; code at main 328b0ae58; see docs/TOMBSTONES.md"
    # Lane postmerge-act-4 (2026-10-09): post-merge t-SNE A/B on main, one run per arm (nv L40S n0608 -> v0979..v0981, amd MI325X a1067 -> a1104..a1106; docs/apple-fast/EXPERIMENTS.md). promoted; no bit change.
    comptime assert not is_defined["MOJOLEARN_IDN_TSNE_KNN_TILE_SELECT"](), "promoted 2026-10-09 (post-merge A/B nv n0608 -> v0979/v0981, amd a1067 -> a1104/a1106, lane/postmerge-act-4): the t-SNE kNN tile top-k select is the IDENTICAL default (alone istella NV 0.97x / AMD 1.02x, taxi NV 0.87x / AMD 0.96x; with REP_TILE istella avg 0.74x, taxi avg 0.86x, vendor split: NV taxi 1.17x slower with both on; trustworthiness@15 equal, digests unchanged); drop -D MOJOLEARN_IDN_TSNE_KNN_TILE_SELECT, use -D MOJOLEARN_IDN_TSNE_KNN_TILE_SELECT_OFF for the serial owner insertion"
    comptime assert not is_defined["MOJOLEARN_IDN_TSNE_REP_TILE"](), "promoted 2026-10-09 (post-merge A/B nv n0608 -> v0980/v0981, amd a1067 -> a1105/a1106, lane/postmerge-act-4): the t-SNE 256-candidate repulsion tile is the IDENTICAL default (alone istella NV 1.42x / AMD 0.60x, taxi NV 1.20x / AMD 0.59x; with KNN_TILE_SELECT istella avg 0.74x, taxi avg 0.86x, vendor split: NV taxi 1.17x slower with both on; trustworthiness@15 equal, digests unchanged); drop -D MOJOLEARN_IDN_TSNE_REP_TILE, use -D MOJOLEARN_IDN_TSNE_REP_TILE_OFF for the split kernel"
    # Lane postmerge-act-5 (2026-10-09): fg2 board-bridge A/B on main 0a7b206f1, one run per arm (nv2 L40S v1021-v1050, amd MI325X a1161-a1190; ratio = arm / fg2.default-linear; neural nv2 v1010/v1012, amd a1141/a1143; docs/apple-fast/EXPERIMENTS.md). Two promoted (ridge bits change, equal on both vendors), two removed; deleted code recoverable at main 0a7b206f1.
    comptime assert not is_defined["MOJOLEARN_IDN_JACOBI_ROUND_ROBIN"](), "promoted 2026-10-09 (fg2 A/B nv2 v1021-v1050, amd a1161-a1190, lane/postmerge-act-5): the linear models' round-robin Jacobi eigensolver is the IDENTICAL default (ridge istella NV 0.25x / AMD 0.14x, avg 0.20x, hash ff4ab841 -> cce6558a on both vendors, r2 0.328682 -> 0.328636; ridge taxi NV 0.99x / AMD 1.15x, avg 1.07x, vendor split: AMD taxi slower; ols 0.99x-1.02x, hashes unchanged); drop -D MOJOLEARN_IDN_JACOBI_ROUND_ROBIN, use -D MOJOLEARN_IDN_JACOBI_ROUND_ROBIN_OFF for the one-block cyclic Jacobi"
    comptime assert not (is_defined["MOJOLEARN_IDN_PCA_RR_ONE_BLOCK"]() or is_defined["MOJOLEARN_IDN_PCA_RR_ONE_BLOCK_STEPS"]()), "removed 2026-10-09 (fg2 A/B nv2 v1030, lane/postmerge-act-5): fg-pca P1+P1b (one-launch one-block round-robin Jacobi, x_decomp/rr_one_block.mojo) was BROKEN on NVIDIA: pca and tsvd on taxi and istella REFUSED at decomposition/impl/linalg/detail/pca.mojo:734; code at main 0a7b206f1; see EXPERIMENTS.md"
    # Lane owed-deletions-D1 (2026-10-09): DROPPED rows in docs/apple-fast/EXPERIMENTS.md whose code was still on main (docs/TOMBSTONES.md). Deleted code recoverable at main b639a2bd2.
    comptime assert not (is_defined["MOJOLEARN_QR_FAST_DEV"]() or is_defined["MOJOLEARN_AFCL_L09"]()), "removed 2026-10-09 (lane/owed-deletions-D1): FAST Apple grid-fold geqrf / orgqr (x_decomp/fast_qr.mojo) was DROPPED-slower: rab3-qrdev istella 1628.1 -> 7319.9 ms (+349.6%), taxi 47.6 -> 91.7 (+92.5%); MOJOLEARN_AFCL_L09 (its 128-row reflector schedule, never run, needed QR_FAST_DEV in both arms) went with it; code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_SVD_FAST_CHOLQR"](), "removed 2026-10-09 (lane/owed-deletions-D1): FAST Apple CholeskyQR2 passes for linalg.svd U (whole-matrix route ahead of the TSQR) was DROPPED-slower: rab3-svdcholqr istella 1782.1 -> 15378.0 ms (+762.9%); code at main b639a2bd2; see docs/TOMBSTONES.md"
    # Lane owed-deletions-D3 (2026-10-09): owed DROP deletions (docs/TOMBSTONES.md 'Owed deletions'; docs/apple-fast/EXPERIMENTS.md). Deleted code recoverable at main b639a2bd2.
    comptime assert not is_defined["MOJOLEARN_DECOMP_FAST_GEMM_TILED"](), "removed 2026-10-09 (lane/owed-deletions-D3): DECOMP_FAST_GEMM_TILED (threadgroup-tiled x_decomp launch_gemm, x_decomp/fast_gemm.mojo) was SLOWER: randomized-svd istella 483.56 -> 640.22 ms (+32.4%), reconstruction error equal; its child knob MOJOLEARN_AFCL_L08 went with it; code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_FA_ALL"](), "removed 2026-10-09 (lane/owed-deletions-D3): FA_ALL (every FactorAnalysis FAST define at once) was SLOWER: factor-analysis istella 10300.89 -> 20530.81 ms (+99.3%, rab6-faqfix), taxi 345.06 -> 34.19, quality noise; the slowdown is EIG_SMALL's one-threadgroup eigh; code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_FA_EIG_SMALL"](), "removed 2026-10-09 (lane/owed-deletions-D3): FA_EIG_SMALL (one-threadgroup eigh / SVD inside the FactorAnalysis EM loop) was SLOWER: in FA_ALL factor-analysis istella 10300.89 -> 20530.81 ms (+99.3%), the slowdown from this one-threadgroup eigh on a 220 x 220; code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_FA_LL_DEVICE"](), "removed 2026-10-09 (lane/owed-deletions-D3): FA_LL_DEVICE (FactorAnalysis EM convergence test on the device) was DROPPED-slower with its EIG_SMALL arm (FA_ALL istella +99.3%, rab6-faqfix); never timed alone on the default loop; code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_LLE_FAST_NULL_CANON"](), "removed 2026-10-09 (lane/owed-deletions-D3): LLE_FAST_NULL_CANON (canonical LLE answer when the null space is wider than n_components) LOST quality: lle trustworthiness down on taxi and istella (verdicts batch 6); code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_MCD_DEVICE_CSTEPS"](), "removed 2026-10-09 (lane/owed-deletions-D3): MCD_DEVICE_CSTEPS (legacy device C-steps by their own define) LOST quality: flagged-mask Jaccard vs OFF .8805 MinCovDet / .9645 EllipticEnvelope (bar .99); the device route stays under MCD_BATCH_COMPAT / MCD_BATCH_MMA; code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_SVD_QFIX"](), "removed 2026-10-09 (lane/owed-deletions-D3): SVD_QFIX (TSQR-route svd keeping directions above 2^-40 s_0 with a Householder U_R) was SLOWER with no quality gain: svd taxi 48.54 -> 54.96 ms (+13.2%), istella 1790.45 -> 1795.62 (+0.3%), singular value and reconstruction errors unchanged (rab5-svd); code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_SVD_QOLD"](), "removed 2026-10-09 (lane/owed-deletions-D3): SVD_QOLD was the opt-out name of SVD_QFIX while that was briefly the FAST default; SVD_QFIX was reverted (DROPPED-slower, svd taxi +13.2%) and SVD_QOLD was already a no-op; code at main b639a2bd2; see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_TSVD_FAST_CHOLQR3"](), "removed 2026-10-09 (lane/owed-deletions-D3): TSVD_FAST_CHOLQR3 (TruncatedSVD's R from shifted CholeskyQR3, x_decomp/tsvd_fast.mojo) was SLOWER: tsvd istella +19.9% (verdicts batch 6); code at main b639a2bd2; see docs/TOMBSTONES.md"
    # Lane postmerge-act-6 (2026-10-10), removed: losers of the same A/B (docs/TOMBSTONES.md, docs/apple-fast/EXPERIMENTS.md). Deleted code recoverable at main 9f83ea479.
    comptime assert not is_defined["MOJOLEARN_IDN_PCA_DEVICE_TRUNCATE"](), "removed 2026-10-10 (lane/postmerge-act-6): IDN_PCA_DEVICE_TRUNCATE (P5: PCA / TruncatedSVD spectrum order and component gather on the device) was NOISE: pca / tsvd on istella and taxi NV 0.91-1.01x, AMD 1.00x (fg2 nv2 v1021-v1050, amd a1161-a1190), hashes unchanged; code at main 9f83ea479; see docs/TOMBSTONES.md"
    # Lane i17-decide-linalg-seq (2026-10-11), removed: losers of the A/B on main b2657cc89 / 2afa942e3, one run per arm (docs/TOMBSTONES.md,
    # docs/apple-fast/EXPERIMENTS.md, experiments/removed/*.patch).
    comptime assert not is_defined["MOJOLEARN_IDN_OLS_R_TRISOLVE"](), "removed 2026-10-11 (lane/i17-decide-linalg-seq, c14beeda5): IDN_OLS_R_TRISOLVE (OLS back-substitution from the TSQR R behind a rank gate) was NOISE with bits changed: ols taxi NV 1.07x / AMD 0.89x, istella 0.99x / 1.00x, v0047/a1630; code at c14beeda5^, patch experiments/removed/MOJOLEARN_IDN_OLS_R_TRISOLVE.patch"
    # Restore: git apply experiments/removed/MOJOLEARN_IDN_RR_ONE_BLOCK_D.patch
    comptime assert not is_defined["MOJOLEARN_IDN_RR_ONE_BLOCK_D"](), "removed 2026-10-11 (lane/w2-decide-linalg, 19eed6fa1): IDN_RR_ONE_BLOCK_D one-block round-robin eigh at 256 threads (C3) was SLOWER: pca istella 2.103x (AMD 2.715x), tsvd istella 3.082x (AMD 4.061x), pca taxi 0.885x (nv2 v0095/v0089, amd a1677/a1671); see docs/TOMBSTONES.md"
    comptime assert not is_defined["MOJOLEARN_IDN_RR_ONE_BLOCK_D_STEPS"](), "removed 2026-10-11 (lane/w2-decide-linalg, 19eed6fa1): IDN_RR_ONE_BLOCK_D_STEPS knob of the deleted MOJOLEARN_IDN_RR_ONE_BLOCK_D (C3, SLOWER: pca istella 2.10x, tsvd istella 3.08x); see docs/TOMBSTONES.md"
    # Restore: git apply experiments/removed/MOJOLEARN_IDN_SVD_TALL_LEAN.patch
    comptime assert not is_defined["MOJOLEARN_IDN_SVD_TALL_LEAN"](), "removed 2026-10-11 (lane/w2-decide-linalg, f4b8fa942): IDN_SVD_TALL_LEAN gated svd rounds + orth second-pass skip (C4) were NOISE: 11 cells mean 0.990, bits changed on lstsq/svd taxi (nv2 v0090/v0096, amd a1672/a1678); see docs/TOMBSTONES.md"
    # Restore: git apply experiments/removed/MOJOLEARN_IDN_XD_KIT_GEMM.patch
    comptime assert not is_defined["MOJOLEARN_IDN_XD_KIT_GEMM"](), "removed 2026-10-11 (lane/w2-decide-linalg, 2256fff37): IDN_XD_KIT_GEMM x_decomp kit GEMM through identical_gemm_into (C6) was NOISE: 8 cells mean 0.971, svd taxi NV 1.145x, bits changed (nv2 v0091, amd a1673); see docs/TOMBSTONES.md"
    # Restore: git apply experiments/removed/MOJOLEARN_IDN_RSVD_ORTH_LEAN.patch
    comptime assert not is_defined["MOJOLEARN_IDN_RSVD_ORTH_LEAN"](), "removed 2026-10-11 (lane/w2-decide-linalg, fdf3608ff): IDN_RSVD_ORTH_LEAN pooled rsvd orth buffers (C7) were NOISE: randomized-svd 0.990/0.977 (nv2 v0092, amd a1674); see docs/TOMBSTONES.md"
    # Lane consol-k0-dead-code (2026-11-08): loser defines whose gate was still in the code (docs/TOMBSTONES.md batch 3). Code at 41ffcec665.
    # Restore: git apply experiments/removed/MOJOLEARN_MCD_BATCH_COMPAT.patch
    comptime assert not is_defined["MOJOLEARN_MCD_BATCH_COMPAT"](), "removed 2026-11-08 (lane consol-k0-dead-code): MOJOLEARN_MCD_BATCH_COMPAT, the COMPAT-only MinCovDet device C-step arm, was HOLD-quality: gap26-mcdrepair-small-ready (ab4265c9a) taxi cap3000 covariance rel .0857, precision rel .9998, support Jaccard .941 < .99, final covariance rank 7 -> 6; the shared code runs under the accepted MCD_BATCH_MMA default (use -D MOJOLEARN_MCD_BATCH_MMA_OFF for the per-candidate path); code at 41ffcec665; see docs/TOMBSTONES.md"
    return True


comptime DECOMPOSITION_GUARDS_OK = _check_configuration()
