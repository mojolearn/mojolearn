# SPDX-License-Identifier: Unicode-3.0
# Fixed IBM CP437 byte mapping (Unicode mapping data).
# License: docs/licenses/UNICODE-LICENSE.txt. Prepared at development time;
# runtime decoding does not load Python or a codec registry.
from core.native_archive_span import ArchiveSpan
from core.host_parallel import host_parallelize
from core.host_predict_threads import host_predict_task_count_work, host_predict_chunk


def archive_decode_cp437(raw: ArchiveSpan) raises -> List[UInt32]:
    var high: List[UInt32] = [
        0xc7, 0xfc, 0xe9, 0xe2, 0xe4, 0xe0, 0xe5, 0xe7, 0xea, 0xeb, 0xe8, 0xef, 0xee, 0xec, 0xc4, 0xc5,
        0xc9, 0xe6, 0xc6, 0xf4, 0xf6, 0xf2, 0xfb, 0xf9, 0xff, 0xd6, 0xdc, 0xa2, 0xa3, 0xa5, 0x20a7, 0x192,
        0xe1, 0xed, 0xf3, 0xfa, 0xf1, 0xd1, 0xaa, 0xba, 0xbf, 0x2310, 0xac, 0xbd, 0xbc, 0xa1, 0xab, 0xbb,
        0x2591, 0x2592, 0x2593, 0x2502, 0x2524, 0x2561, 0x2562, 0x2556, 0x2555, 0x2563, 0x2551, 0x2557, 0x255d, 0x255c, 0x255b, 0x2510,
        0x2514, 0x2534, 0x252c, 0x251c, 0x2500, 0x253c, 0x255e, 0x255f, 0x255a, 0x2554, 0x2569, 0x2566, 0x2560, 0x2550, 0x256c, 0x2567,
        0x2568, 0x2564, 0x2565, 0x2559, 0x2558, 0x2552, 0x2553, 0x256b, 0x256a, 0x2518, 0x250c, 0x2588, 0x2584, 0x258c, 0x2590, 0x2580,
        0x3b1, 0xdf, 0x393, 0x3c0, 0x3a3, 0x3c3, 0xb5, 0x3c4, 0x3a6, 0x398, 0x3a9, 0x3b4, 0x221e, 0x3c6, 0x3b5, 0x2229,
        0x2261, 0xb1, 0x2265, 0x2264, 0x2320, 0x2321, 0xf7, 0x2248, 0xb0, 0x2219, 0xb7, 0x221a, 0x207f, 0xb2, 0x25a0, 0xa0,
    ]
    var result = List[UInt32](length=raw.size, fill=0)
    var tasks = host_predict_task_count_work(raw.size, raw.size)
    var chunk = host_predict_chunk(raw.size, tasks)
    var count = raw.size
    var src = MutPointer[UInt8, MutUntrackedOrigin](unsafe_from_address=raw.address)
    var dst = result.unsafe_ptr()
    var table = high.unsafe_ptr()
    def convert(unit: Int) {imm src, imm dst, imm table, imm count, imm chunk}:
        for i in range(unit * chunk, min(count, (unit + 1) * chunk)):
            var byte = Int(src[i])
            dst[i] = UInt32(byte) if byte < 128 else table[byte - 128]
    host_parallelize(convert, tasks)
    _ = high
    return result^
